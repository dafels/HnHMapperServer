# Settings for docker-compose.yml. Copy to '.env' in the same folder and adjust.

# Where the api/web images come from. The official images are public; if you build your own,
# point this at your registry instead (e.g. ghcr.io/youruser).
IMAGE_PREFIX=ghcr.io/dafels

# Host directory for the database, tile storage and cookie keys (shared by api and web).
DATA_DIR=/srv/hnh-map

# ---------------------------------------------------------------------------------------------
# Optional: Aspire dashboard (logs, traces and metrics of api and web).
# To enable it: uncomment the lines below, add the dashboard block from Caddyfile.example to
# your Caddyfile, then run: docker compose up -d
# ---------------------------------------------------------------------------------------------
#COMPOSE_PROFILES=dashboard
#OTEL_EXPORTER_OTLP_ENDPOINT=http://dashboard:18889
# Dashboard login token, e.g. from `openssl rand -hex 32`. Left empty, the dashboard makes a new
# one on every start (shown by `docker compose logs dashboard`).
#DASHBOARD_BROWSER_TOKEN=
