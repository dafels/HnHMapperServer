# Docker Compose stack for HnH Mapper production deployment (MULTI-TENANT)
# Includes: API service, Web service, Caddy reverse proxy (HTTPS) and Watchtower (auto-updates).
# Optional: the Aspire dashboard for logs, traces and metrics (off unless enabled in .env).
#
# Setup (on the server, e.g. in /opt/hnhmap):
# 1. Copy this file to 'docker-compose.yml', '.env.example' to '.env' and 'Caddyfile.example'
#    to 'Caddyfile'. Check the values in .env and put your domain in the Caddyfile.
# 2. Create the data directory from DATA_DIR (default /srv/hnh-map).
# 3. Run: docker compose up -d
#
# Your own settings live only in .env and the Caddyfile, so this file can be replaced by a newer
# version from the repository as-is.
#
# Multi-Tenancy Notes:
# - Default tenant "default-tenant-1" created automatically on first startup
# - Bootstrap admin assigned to default tenant (username: admin, password: admin123!) -
#   change the password immediately after the first login
# - Database migrations auto-apply
# - Self-registration disabled - new users join with invite links

name: hnhmap

# Cap every container's log: the default json-file driver grows without limit (uncapped logs
# once filled 52GB on a server). 50MB x 3 files = 150MB per container.
x-logging: &default-logging
  driver: json-file
  options:
    max-size: "50m"
    max-file: "3"

# api and web log the most: 300MB x 10 files = 3GB each.
x-app-logging: &app-logging
  driver: json-file
  options:
    max-size: "300m"
    max-file: "10"

services:
  # ============================================================================
  # API Service - game client communication and backend operations
  # ============================================================================
  api:
    # IMAGE_PREFIX (.env) points at the official images or at your own registry.
    image: ${IMAGE_PREFIX:?set IMAGE_PREFIX in .env}/hnhmapper-api:main
    container_name: hnhm-api
    restart: unless-stopped
    logging: *app-logging

    # .NET keeps its GC heap under ~75% of this limit; if memory ever runs away the kernel
    # restarts just this container instead of starving the whole server.
    mem_limit: 3g

    environment:
      GridStorage: /data
      ASPNETCORE_ENVIRONMENT: Production
      # Caddy terminates TLS
      EnableCors: "false"
      EnableHttpsRedirect: "false"
      # First start only: creates the default tenant and this admin user
      BootstrapAdmin__Enabled: "true"
      BootstrapAdmin__Username: admin
      BootstrapAdmin__Password: admin123!
      # Default only; SuperAdmin -> Sign-in owns this once saved there
      SelfRegistration__Enabled: "false"
      # Empty unless the optional dashboard is enabled in .env (then telemetry goes there)
      OTEL_EXPORTER_OTLP_ENDPOINT: ${OTEL_EXPORTER_OTLP_ENDPOINT:-}
      OTEL_SERVICE_NAME: api
      OTEL_RESOURCE_ATTRIBUTES: deployment.environment=production

    # Shared with web: grids.db, tenant tile storage and the DataProtection keys
    # (cookie encryption) both services must agree on.
    volumes:
      - ${DATA_DIR:?set DATA_DIR in .env}:/data

    # Watchtower updates only containers carrying this label
    labels:
      - com.centurylinklabs.watchtower.enable=true

  # ============================================================================
  # Web Service - Blazor Server UI (dashboard, map, admin panels)
  # ============================================================================
  web:
    image: ${IMAGE_PREFIX:?set IMAGE_PREFIX in .env}/hnhmapper-web:main
    container_name: hnhm-web
    restart: unless-stopped
    logging: *app-logging
    mem_limit: 3g

    environment:
      GridStorage: /data
      ASPNETCORE_ENVIRONMENT: Production
      ApiBaseUrl: http://api:8080
      EnableHttpsRedirect: "false"
      OTEL_EXPORTER_OTLP_ENDPOINT: ${OTEL_EXPORTER_OTLP_ENDPOINT:-}
      OTEL_SERVICE_NAME: web
      OTEL_RESOURCE_ATTRIBUTES: deployment.environment=production

    volumes:
      - ${DATA_DIR:?set DATA_DIR in .env}:/data

    labels:
      - com.centurylinklabs.watchtower.enable=true

  # ============================================================================
  # Caddy - HTTPS reverse proxy (Let's Encrypt certificates), routes to api/web
  # ============================================================================
  caddy:
    image: caddy:2
    container_name: hnhm-caddy
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "200m"
        max-file: "5"

    ports:
      - "80:80"
      - "443:443"
      # HTTP/3 (QUIC): Caddy advertises it, so publish UDP too
      - "443:443/udp"

    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data      # certificates - keep this volume
      - caddy_config:/config

    # No Watchtower label on purpose: Caddy owns ports 80/443, so an automatic update would
    # drop every user for a few seconds. Update it by hand at a quiet time:
    #   docker compose pull caddy && docker compose up -d caddy

  # ============================================================================
  # Watchtower - pulls new api/web images and restarts those containers
  # ============================================================================
  watchtower:
    # Maintained fork of containrrr/watchtower
    image: nickfedor/watchtower
    container_name: hnhm-watchtower
    restart: unless-stopped
    logging: *default-logging

    # Check every 60s, update only labelled containers, delete each replaced image
    # (without --cleanup every deploy leaves the old image behind)
    command: --interval 60 --label-enable --cleanup

    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      # Images in a private registry? `docker login` on the host, then mount its credentials:
      # - /home/youruser/.docker/config.json:/config.json:ro

  # ============================================================================
  # Optional: Aspire dashboard - logs, traces and metrics of api and web.
  # Starts only with COMPOSE_PROFILES=dashboard in .env (see .env.example), and needs
  # the dashboard block from Caddyfile.example in your Caddyfile.
  # ============================================================================
  dashboard:
    profiles: [dashboard]
    image: mcr.microsoft.com/dotnet/aspire-dashboard:13.6
    container_name: hnhm-dashboard
    restart: unless-stopped
    logging: *default-logging
    mem_limit: 3g

    environment:
      # Login token (second gate after Caddy's basic auth). Empty = a new one on every start,
      # printed in `docker compose logs dashboard`.
      DASHBOARD__FRONTEND__BROWSERTOKEN: ${DASHBOARD_BROWSER_TOKEN:-}
      ASPIRE_DASHBOARD_FORWARDEDHEADERS_ENABLED: "true"
      # Keep telemetry across restarts. The image runs as uid 1654, which owns /home/app, so
      # the volume goes there (a new volume mounted at e.g. /data would belong to root).
      ASPIRE_DASHBOARD_PERSISTENCE_MODE: Resume
      ASPIRE_DASHBOARD_DATA_DIRECTORY: /home/app
      # Retention is by count (default 100k each); the oldest entries are dropped first
      DASHBOARD__TELEMETRYLIMITS__MAXLOGCOUNT: "1000000"
      DASHBOARD__TELEMETRYLIMITS__MAXTRACECOUNT: "500000"

    volumes:
      - dashboard_data:/home/app

    # No ports: Caddy and the apps reach it inside this network

volumes:
  caddy_data:
  caddy_config:
  dashboard_data:
