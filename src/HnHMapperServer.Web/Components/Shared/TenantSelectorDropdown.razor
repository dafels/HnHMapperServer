@using HnHMapperServer.Core.Constants
@using HnHMapperServer.Web.Models
@using HnHMapperServer.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject TenantContextService TenantContext
@inject IInvitationService InvitationService
@inject ClipboardService Clipboard
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<TenantSelectorDropdown> Logger

@if (ShowSelector)
{
    <MudMenu Icon="@Icons.Material.Filled.Map"
             Color="Color.Inherit"
             Label="@CurrentTenantName"
             Dense="true"
             Class="ml-2"
             AriaLabel="Map menu">
        <ChildContent>
            @if (_tenants.Count > 0)
            {
                @foreach (var tenant in _tenants)
                {
                    var isCurrent = tenant.Id == _activeTenantId;
                    <MudMenuItem OnClick="@(() => SelectTenant(tenant))" Icon="@(isCurrent ? Icons.Material.Filled.Check : Icons.Material.Outlined.Map)">
                        <div>
                            <div style="@(isCurrent ? "font-weight: 600;" : "")">@tenant.Name</div>
                            <div class="text-caption ck-text-secondary">@RoleLabel(tenant.Role)</div>
                        </div>
                    </MudMenuItem>
                }
                <MudDivider Class="my-1" />
            }

            <MudMenuItem Href="/tenant/select?action=create" Icon="@Icons.Material.Filled.AddLocationAlt">Create a new map</MudMenuItem>
            <MudMenuItem Href="/tenant/select?action=join" Icon="@Icons.Material.Filled.Groups">Join a map with an invite</MudMenuItem>

            @if (_isAdminOfCurrent && _activeTenantId != null)
            {
                <MudMenuItem OnClick="CopyInviteLinkAsync" Icon="@Icons.Material.Filled.Link" Disabled="@_copying">
                    Copy invite link for @CurrentTenantName
                </MudMenuItem>
            }

            @if (_tenants.Count > 0)
            {
                <MudMenuItem Href="/tenant/select" Icon="@Icons.Material.Filled.ViewModule">All your maps</MudMenuItem>
            }
        </ChildContent>
    </MudMenu>
}

@code {
    private List<TenantDto> _tenants = new();
    private string? _activeTenantId;
    private bool _isAdminOfCurrent;
    private bool _copying;

    [Parameter]
    public bool ShowSelector { get; set; } = true;

    private string CurrentTenantName =>
        _tenants.FirstOrDefault(t => t.Id == _activeTenantId)?.Name ?? (_tenants.Count == 0 ? "No map yet" : "Select a map");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _activeTenantId = authState.User.FindFirst(AuthorizationConstants.ClaimTypes.TenantId)?.Value;
            var tenantRole = authState.User.FindFirst(AuthorizationConstants.ClaimTypes.TenantRole)?.Value;
            _isAdminOfCurrent = string.Equals(tenantRole, "TenantAdmin", StringComparison.OrdinalIgnoreCase)
                                || authState.User.IsInRole(AuthorizationConstants.Roles.SuperAdmin);

            _tenants = await TenantContext.GetTenantsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load the map list for the menu");
        }
    }

    private void SelectTenant(TenantDto tenant)
    {
        if (tenant.Id == _activeTenantId)
            return;

        // Switching re-issues the auth cookie (Web endpoint) and reloads the current page in the new map.
        var returnUrl = new Uri(Navigation.Uri).PathAndQuery;
        Navigation.NavigateTo(TenantSwitchUrl.For(tenant.Id, returnUrl), forceLoad: true);
    }

    /// <summary>Reuses the newest live shareable link (or creates a 7-day unlimited one) and copies it.</summary>
    private async Task CopyInviteLinkAsync()
    {
        if (_activeTenantId == null || _copying)
            return;

        _copying = true;
        try
        {
            var now = DateTime.UtcNow;
            var existing = (await InvitationService.GetInvitationsAsync(_activeTenantId))
                .Where(i => i.Status == "Active" && i.ExpiresAt > now.AddHours(1) && (i.MaxUses == null || i.UseCount < i.MaxUses))
                .OrderByDescending(i => i.CreatedAt)
                .FirstOrDefault();

            existing ??= await InvitationService.CreateInvitationAsync(_activeTenantId);
            if (existing == null)
            {
                Snackbar.Add("Couldn't create an invite link. Try again from the admin panel.", Severity.Error);
                return;
            }

            await Clipboard.CopyAsync(InviteLinks.Build(Navigation.BaseUri, existing.InviteCode),
                $"Invite link copied - anyone with it joins {CurrentTenantName} right away.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Copy invite link failed");
            Snackbar.Add("Couldn't get an invite link right now.", Severity.Error);
        }
        finally
        {
            _copying = false;
        }
    }

    private static string RoleLabel(string role) => role.ToLowerInvariant() switch
    {
        "tenantadmin" => "Admin",
        "tenantuser" => "Member",
        _ => role
    };
}
