@using HnHMapperServer.Web.Services
@using HnHMapperServer.Core.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@inject IInvitationService InvitationService
@inject TenantContextService TenantContext
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ClipboardService Clipboard
@inject ILogger<InvitationManagement> Logger

<MudPaper Class="pa-4">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Link" Class="me-2" />
            Invite links
        </MudText>
        <MudText Typo="Typo.body2" Class="ck-text-secondary">
            Anyone with a link joins this map immediately with the access you pick &mdash; the link is the approval.
            Links can be used by many people until they expire, run out of uses, or you revoke them.
        </MudText>

        @* Modal="false": MudSelect popovers are modal since MudBlazor 7 - with one open, the first click on the
           button next to it would only dismiss the overlay. *@
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Style="flex-wrap: wrap;">
            <MudSelect T="int" @bind-Value="_expiresInDays" Label="Valid for" Dense="true" Margin="Margin.Dense"
                       Variant="Variant.Outlined" Modal="false" Style="min-width: 130px;" Disabled="@_isCreating">
                <MudSelectItem T="int" Value="7">7 days</MudSelectItem>
                <MudSelectItem T="int" Value="30">30 days</MudSelectItem>
                <MudSelectItem T="int" Value="90">90 days</MudSelectItem>
            </MudSelect>
            <MudSelect T="int" @bind-Value="_maxUses" Label="Uses" Dense="true" Margin="Margin.Dense"
                       Variant="Variant.Outlined" Modal="false" Style="min-width: 130px;" Disabled="@_isCreating">
                <MudSelectItem T="int" Value="0">Unlimited</MudSelectItem>
                <MudSelectItem T="int" Value="1">1 person</MudSelectItem>
                <MudSelectItem T="int" Value="5">5 people</MudSelectItem>
                <MudSelectItem T="int" Value="25">25 people</MudSelectItem>
            </MudSelect>
            <MudSelect T="string" @bind-Value="_preset" Label="Access" Dense="true" Margin="Margin.Dense"
                       Variant="Variant.Outlined" Modal="false" Style="min-width: 200px;" Disabled="@_isCreating">
                <MudSelectItem T="string" Value="@("Full")">Full access (incl. edit/delete)</MudSelectItem>
                <MudSelectItem T="string" Value="@("Contribute")">View + upload only</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Filled"
                      Color="Color.Primary"
                      StartIcon="@Icons.Material.Filled.Add"
                      OnClick="CreateInvitation"
                      Disabled="@_isCreating">
                @if (_isCreating)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    <span>Creating...</span>
                }
                else
                {
                    <span>Create invite link</span>
                }
            </MudButton>
        </MudStack>

        @if (!string.IsNullOrEmpty(_newInviteCode))
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="mb-4">
                <MudText Typo="Typo.body1" Class="mb-2">
                    <strong>Invite link created</strong>
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    Share it with your village. Anyone with this link joins immediately with @(_newInvitePreset == "Contribute" ? "view + upload access" : "full access");
                    it is valid for @_newInviteDays days@(_newInviteMaxUses > 0 ? $" and {_newInviteMaxUses} use{(_newInviteMaxUses == 1 ? "" : "s")}" : "").
                </MudText>
                <MudPaper Class="pa-2 d-flex justify-space-between align-center">
                    <MudText Typo="Typo.body2" Style="font-family: monospace; word-break: break-all;">
                        @_newInviteLink
                    </MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                  Color="Color.Default"
                                  OnClick="@(() => Clipboard.CopyAsync(_newInviteLink!, "Invite link copied"))"
                                  aria-label="Copy to clipboard"
                                  title="Copy to clipboard" />
                </MudPaper>
                <MudButton OnClick="@(() => _newInviteCode = null)" Class="mt-2" Size="Size.Small">
                    Dismiss
                </MudButton>
            </MudAlert>
        }

        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">
            <MudTabPanel Text="Active" Icon="@Icons.Material.Filled.CheckCircle" BadgeData="@_activeCount.ToString()">
                <InvitationTable Invitations="@_activeInvitations"
                                Status="Active"
                                OnCopyLink="@CopyInviteLink"
                                OnRevoke="@RevokeInvitation"
                                ShowCopy="true"
                                ShowRevoke="true"
                                IsLoading="@_isLoading" />
            </MudTabPanel>

            <MudTabPanel Text="Used up" Icon="@Icons.Material.Filled.Done" BadgeData="@_usedCount.ToString()">
                <InvitationTable Invitations="@_usedInvitations"
                                Status="Used"
                                OnCopyLink="@CopyInviteLink"
                                ShowCopy="true"
                                ShowRevoke="false"
                                IsLoading="@_isLoading" />
            </MudTabPanel>

            <MudTabPanel Text="Expired" Icon="@Icons.Material.Filled.Schedule" BadgeData="@_expiredCount.ToString()">
                <InvitationTable Invitations="@_expiredInvitations"
                                Status="Expired"
                                ShowCopy="false"
                                ShowRevoke="false"
                                IsLoading="@_isLoading" />
            </MudTabPanel>

            <MudTabPanel Text="Revoked" Icon="@Icons.Material.Filled.Block" BadgeData="@_revokedCount.ToString()">
                <InvitationTable Invitations="@_revokedInvitations"
                                Status="Revoked"
                                ShowCopy="false"
                                ShowRevoke="false"
                                IsLoading="@_isLoading" />
            </MudTabPanel>
        </MudTabs>
    </MudStack>
</MudPaper>

@code {
    private List<HnHMapperServer.Core.DTOs.InvitationDto> _invitations = new();
    private List<HnHMapperServer.Core.DTOs.InvitationDto> _activeInvitations = new();
    private List<HnHMapperServer.Core.DTOs.InvitationDto> _usedInvitations = new();
    private List<HnHMapperServer.Core.DTOs.InvitationDto> _expiredInvitations = new();
    private List<HnHMapperServer.Core.DTOs.InvitationDto> _revokedInvitations = new();

    private int _activeCount => _activeInvitations.Count;
    private int _usedCount => _usedInvitations.Count;
    private int _expiredCount => _expiredInvitations.Count;
    private int _revokedCount => _revokedInvitations.Count;

    private bool _isLoading = true;
    private bool _isCreating = false;
    private string? _newInviteCode;
    private string? _newInviteLink;
    private string? _currentTenantId;

    private int _expiresInDays = 7;
    private int _maxUses = 0;            // 0 = unlimited
    private string _preset = "Full";
    private int _newInviteDays;
    private int _newInviteMaxUses;
    private string _newInvitePreset = "Full";

    protected override async Task OnInitializedAsync()
    {
        // Get current tenant ID from context, or use default tenant
        // This supports both multi-tenant and single-tenant deployments
        _currentTenantId = TenantContext.CurrentTenant?.Id;

        if (string.IsNullOrEmpty(_currentTenantId))
        {
            // Try fetching tenants from API
            try
            {
                var tenants = await TenantContext.GetTenantsAsync();
                _currentTenantId = tenants.FirstOrDefault()?.Id;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to fetch tenants, using default tenant");
            }
        }

        // Fall back to getting TenantId from user claims
        if (string.IsNullOrEmpty(_currentTenantId))
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _currentTenantId = authState.User.FindFirst(HnHMapperServer.Core.Constants.AuthorizationConstants.ClaimTypes.TenantId)?.Value;

            Logger.LogInformation("Got tenant ID from claims: {TenantId}", _currentTenantId);
        }

        if (string.IsNullOrEmpty(_currentTenantId))
        {
            Snackbar.Add("Unable to determine your tenant. Please contact support.", Severity.Error);
            Logger.LogError("Unable to determine tenant ID for user");
            return;
        }

        await LoadInvitations();
    }

    private async Task LoadInvitations()
    {
        if (string.IsNullOrEmpty(_currentTenantId))
            return;

        _isLoading = true;
        try
        {
            _invitations = await InvitationService.GetInvitationsAsync(_currentTenantId);

            // Group by status. "Used up" = no uses left; links with uses remaining stay under Active.
            var now = DateTime.UtcNow;
            _activeInvitations = _invitations.Where(i => i.Status == "Active" && i.ExpiresAt > now).OrderByDescending(i => i.CreatedAt).ToList();
            _usedInvitations = _invitations.Where(i => i.Status == "Used" && i.ExpiresAt > now).OrderByDescending(i => i.UsedAt).ToList();
            _expiredInvitations = _invitations.Where(i => i.ExpiresAt <= now && i.Status != "Revoked").OrderByDescending(i => i.ExpiresAt).ToList();
            _revokedInvitations = _invitations.Where(i => i.Status == "Revoked").OrderByDescending(i => i.CreatedAt).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load invitations");
            Snackbar.Add("Failed to load invitations. Please try again.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateInvitation()
    {
        if (string.IsNullOrEmpty(_currentTenantId))
            return;

        _isCreating = true;
        try
        {
            var invitation = await InvitationService.CreateInvitationAsync(
                _currentTenantId, _expiresInDays, _maxUses > 0 ? _maxUses : null, _preset);
            if (invitation != null)
            {
                _newInviteCode = invitation.InviteCode;
                _newInviteLink = InviteLinks.Build(NavigationManager.BaseUri, invitation.InviteCode);
                _newInviteDays = _expiresInDays;
                _newInviteMaxUses = _maxUses;
                _newInvitePreset = invitation.Preset;
                Snackbar.Add("Invite link created", Severity.Success);
                await LoadInvitations();
            }
            else
            {
                Snackbar.Add("Failed to create invitation.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create invitation");
            Snackbar.Add("Failed to create invitation. Please try again.", Severity.Error);
        }
        finally
        {
            _isCreating = false;
        }
    }

    private Task CopyInviteLink(HnHMapperServer.Core.DTOs.InvitationDto invitation) =>
        Clipboard.CopyAsync(InviteLinks.Build(NavigationManager.BaseUri, invitation.InviteCode), "Invite link copied");

    private async Task RevokeInvitation(HnHMapperServer.Core.DTOs.InvitationDto invitation)
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Revoke invite link",
            $"Nobody will be able to join with this link anymore ({invitation.UseCount} joined so far). People who already joined keep their access.",
            yesText: "Revoke",
            cancelText: "Cancel");

        if (result == true)
        {
            try
            {
                var success = await InvitationService.RevokeInvitationAsync(_currentTenantId!, invitation.Id);
                if (success)
                {
                    Snackbar.Add("Invitation revoked successfully.", Severity.Success);
                    await LoadInvitations();
                }
                else
                {
                    Snackbar.Add("Failed to revoke invitation.", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to revoke invitation");
                Snackbar.Add("Failed to revoke invitation. Please try again.", Severity.Error);
            }
        }
    }
}
