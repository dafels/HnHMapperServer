@using HnHMapperServer.Core.Cookbook
@using HnHMapperServer.Core.DTOs
@using Microsoft.JSInterop
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<CookbookImport> Logger
@inject TenantContextService TenantContext
@inject IJSRuntime JS

<MudStack Spacing="3">
    <MudAlert Severity="Severity.Info" Dense="true">
        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="me-1" />
        Select <strong>food-info2.json</strong> to seed your organization's cookbook with all recipe
        variations (groups/satiations come from bundled wiki data; Ctrl-click a newer
        <strong>wiki-food-data.json</strong> to override). Importing <strong>replaces the whole
        catalog</strong> (you will be asked to confirm) — game clients extend it afterwards. The same
        button also restores a previously <strong>exported cookbook JSON</strong>, including everything
        players' clients contributed.
    </MudAlert>

    <MudPaper Elevation="0" Class="pa-3 mud-background-gray">
        <MudStack Spacing="2">
            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Class="flex-wrap">
                <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                               FilesChanged="ImportFilesAsync"
                               Accept=".json"
                               MaximumFileCount="3"
                               Disabled="@(_isImporting || string.IsNullOrEmpty(_tenantId))">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   Disabled="@(_isImporting || string.IsNullOrEmpty(_tenantId))">
                            @if (_isImporting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                                <span>Importing...</span>
                            }
                            else
                            {
                                <span>Import food data</span>
                            }
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>

                @if (string.IsNullOrEmpty(_tenantId))
                {
                    <MudText Typo="Typo.body2">Loading tenant...</MudText>
                }
                else if (_status == null)
                {
                    <MudText Typo="Typo.body2">Loading...</MudText>
                }
                else if (_status.FoodCount == 0)
                {
                    <MudText Typo="Typo.body2">No food data yet.</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2">
                        <strong>@_status.FoodCount</strong> foods with
                        <strong>@_status.VariantCount.ToString("N0")</strong> recipe variations,
                        last updated @_status.LastImportedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    </MudText>
                }

                <MudSpacer />

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Download"
                           Disabled="@(_isExporting || _isImporting || _status == null || _status.FoodCount == 0)"
                           OnClick="ExportCookbookAsync">
                    @if (_isExporting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                        <span>Exporting...</span>
                    }
                    else
                    {
                        <span>Export cookbook</span>
                    }
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteForever"
                           Disabled="@(_isImporting || _isClearing || _status == null || _status.FoodCount == 0)"
                           OnClick="ClearAllAsync">
                    @if (_isClearing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                        <span>Clearing...</span>
                    }
                    else
                    {
                        <span>Clear all food data</span>
                    }
                </MudButton>
            </MudStack>

            @if (_status is { } s && (s.UntaggedFoodCount > 0 || s.UntaggedVariantCount > 0))
            {
                <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Class="flex-wrap">
                    <MudText Typo="Typo.body2">
                        <strong>@s.UntaggedFoodCount</strong> foods /
                        <strong>@s.UntaggedVariantCount.ToString("N0")</strong> recipe variations have no world
                        tag (admin imports and uploads from before world tagging).
                    </MudText>
                    @* Modal="false": the dropdown popover is modal by default since MudBlazor 7,
                       so with it open the first click on "Assign world" only dismissed the
                       overlay and the button needed a second click. *@
                    <MudSelect T="string"
                               @bind-Value="_assignWorld"
                               Label="World"
                               Dense="true"
                               Margin="Margin.Dense"
                               Style="max-width: 160px;"
                               Modal="false"
                               Disabled="@(_isAssigning || _isImporting || _isClearing)">
                        @foreach (var world in GameWorlds.Known.OrderByDescending(w => w.Order))
                        {
                            <MudSelectItem T="string" Value="@world.Genus">@world.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Public"
                               Disabled="@(_isAssigning || _isImporting || _isClearing)"
                               OnClick="AssignWorldAsync">
                        @if (_isAssigning)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                            <span>Assigning...</span>
                        }
                        else
                        {
                            <span>Assign world</span>
                        }
                    </MudButton>
                </MudStack>
            }

            @if (_lastResult != null && _lastResult.Errors.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    <MudText Typo="Typo.body2"><strong>@_lastResult.Errors.Count issue(s):</strong></MudText>
                    @foreach (var error in _lastResult.Errors.Take(10))
                    {
                        <MudText Typo="Typo.caption">@error</MudText>
                    }
                </MudAlert>
            }
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="0" Class="pa-3 mud-background-gray">
        <MudStack Spacing="1">
            <MudText Typo="Typo.subtitle1">Game-client uploads</MudText>
            <MudText Typo="Typo.body2">
                Players can feed the cookbook automatically (requires a mapper token with the
                <strong>Upload</strong> permission):
            </MudText>
            <MudText Typo="Typo.body2">
                <strong>Hurricane:</strong> Options &rarr; Cookbook Endpoint =
                <code>{server}/client/{token}/food</code> (leave the token field empty).
            </MudText>
            <MudText Typo="Typo.body2">
                <strong>KamiClient:</strong> uses the configured mapper endpoint automatically &mdash;
                just enable <em>autofood tracking</em> in the options.
            </MudText>
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    private const long MaxFileSize = 100 * 1024 * 1024; // 100 MB

    private string? _tenantId;
    private CookbookStatusDto? _status;
    private bool _isImporting;
    private bool _isClearing;
    private bool _isExporting;
    private bool _isAssigning;
    private string _assignWorld = GameWorlds.Known.OrderByDescending(w => w.Order).First().Genus;
    private CookbookImportResultDto? _lastResult;

    protected override async Task OnInitializedAsync()
    {
        // Same resolution as the other admin tabs: current tenant, else first tenant.
        _tenantId = TenantContext.CurrentTenant?.Id;
        if (string.IsNullOrEmpty(_tenantId))
        {
            var tenants = await TenantContext.GetTenantsAsync();
            _tenantId = tenants.FirstOrDefault()?.Id;
        }

        await LoadStatusAsync();
    }

    private async Task LoadStatusAsync()
    {
        if (string.IsNullOrEmpty(_tenantId))
        {
            return;
        }

        try
        {
            var client = HttpClientFactory.CreateClient("API");
            _status = await client.GetFromJsonAsync<CookbookStatusDto>(
                $"/api/tenants/{Uri.EscapeDataString(_tenantId)}/cookbook/status");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load cookbook status");
            Snackbar.Add("Failed to load cookbook status", Severity.Error);
        }
    }

    /// <summary>Fires straight from the file dialog: classify the picked files and import immediately.</summary>
    private async Task ImportFilesAsync(IReadOnlyList<IBrowserFile>? files)
    {
        if (files == null || files.Count == 0 || _isImporting || string.IsNullOrEmpty(_tenantId))
        {
            return;
        }

        var wikiFile = files.FirstOrDefault(f => f.Name.Contains("wiki", StringComparison.OrdinalIgnoreCase));
        var foodsFile = files.FirstOrDefault(f => !f.Name.Contains("wiki", StringComparison.OrdinalIgnoreCase));

        if (foodsFile == null)
        {
            Snackbar.Add("Select food-info2.json (the game data dump) — the wiki file alone is not enough", Severity.Warning);
            return;
        }

        if (!await ConfirmReplaceAsync(foodsFile))
        {
            return;
        }

        _isImporting = true;
        _lastResult = null;

        try
        {
            var client = HttpClientFactory.CreateClient("APIUpload");

            using var content = new MultipartFormDataContent();

            var foodsContent = new StreamContent(foodsFile.OpenReadStream(MaxFileSize));
            foodsContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/json");
            content.Add(foodsContent, "foods", foodsFile.Name);

            if (wikiFile != null)
            {
                var wikiContent = new StreamContent(wikiFile.OpenReadStream(MaxFileSize));
                wikiContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/json");
                content.Add(wikiContent, "wiki", wikiFile.Name);
            }

            var response = await client.PostAsync(
                $"/api/tenants/{Uri.EscapeDataString(_tenantId)}/cookbook/import", content);
            await HandleImportResponseAsync(response);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Cookbook import failed");
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isImporting = false;
        }
    }

    /// <summary>
    /// Imports are wipe-and-replace — when the catalog holds anything, make the admin
    /// acknowledge exactly what is about to be deleted before any upload starts.
    /// Day-one seeding into an empty catalog destroys nothing and asks nothing.
    /// </summary>
    private async Task<bool> ConfirmReplaceAsync(IBrowserFile foodsFile)
    {
        if (_status == null || _status.FoodCount == 0)
        {
            return true;
        }

        // Filename heuristic only, to pick the right wording (the server detects the
        // format authoritatively): our export downloads are named cookbook-{tenant}-{stamp}.json.
        var looksLikeSnapshot = foodsFile.Name.StartsWith("cookbook-", StringComparison.OrdinalIgnoreCase);

        var consequence = looksLikeSnapshot
            ? "The selected file looks like a <strong>cookbook export</strong>: the catalog is restored " +
              "exactly as it was when that file was exported — including the player contributions it " +
              "carries. <strong>Anything contributed after that export is lost.</strong>"
            : "<strong>Everything players' clients have contributed since the last import is lost</strong> — " +
              "extra recipe variations, world tags and contributor credits cannot be restored from a game " +
              "data dump. Use <em>Export cookbook</em> first if you want a backup.";

        var confirmed = await DialogService.ShowMessageBox(
            "Replace the entire cookbook?",
            (MarkupString)($"Importing <strong>{System.Net.WebUtility.HtmlEncode(foodsFile.Name)}</strong> " +
                           $"permanently deletes the current catalog — <strong>{_status.FoodCount} foods</strong> " +
                           $"and <strong>{_status.VariantCount:N0} recipe variations</strong> — and replaces it " +
                           $"with the file's contents.<br /><br />{consequence}<br /><br />" +
                           "Panels and favorites are kept: their entries show as grayed out until matching " +
                           "foods come back."),
            yesText: "Replace catalog",
            cancelText: "Cancel");

        return confirmed == true;
    }

    /// <summary>Fetches the export server-side and hands it to the browser as a file download.</summary>
    private async Task ExportCookbookAsync()
    {
        if (_isExporting || string.IsNullOrEmpty(_tenantId))
        {
            return;
        }

        _isExporting = true;
        try
        {
            // APIUpload client: the default API client's resilience handler would time
            // out and retry a multi-MB export at 10s (same reason the purge dialog uses it).
            var client = HttpClientFactory.CreateClient("APIUpload");
            using var response = await client.GetAsync(
                $"/api/tenants/{Uri.EscapeDataString(_tenantId)}/cookbook/export",
                HttpCompletionOption.ResponseHeadersRead);

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Export failed: HTTP {(int)response.StatusCode}", Severity.Error);
                return;
            }

            var fileName = response.Content.Headers.ContentDisposition?.FileNameStar
                ?? response.Content.Headers.ContentDisposition?.FileName?.Trim('"')
                ?? $"cookbook-{_tenantId}.json";

            await using var stream = await response.Content.ReadAsStreamAsync();
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Cookbook export failed");
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExporting = false;
        }
    }

    private async Task ClearAllAsync()
    {
        if (_isClearing || string.IsNullOrEmpty(_tenantId) || _status == null || _status.FoodCount == 0)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBox(
            "Clear all food data?",
            (MarkupString)($"This permanently deletes <strong>{_status.FoodCount} foods</strong> and " +
                           $"<strong>{_status.VariantCount:N0} recipe variations</strong> from your organization's cookbook — " +
                           "<strong>including everything players' clients have contributed since the last import</strong>, " +
                           "which cannot be re-imported from a file.<br /><br />" +
                           "Panels and favorites are kept: their entries show as grayed out until the foods " +
                           "come back via an import or new client uploads."),
            yesText: "Clear everything",
            cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        _isClearing = true;
        try
        {
            var client = HttpClientFactory.CreateClient("API");
            var response = await client.DeleteAsync($"/api/tenants/{Uri.EscapeDataString(_tenantId)}/cookbook");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CookbookClearResultDto>();
                Snackbar.Add(
                    $"Cleared {result?.Foods ?? 0} foods and {result?.Variants ?? 0:N0} recipe variations",
                    Severity.Success);
                _lastResult = null;
                await LoadStatusAsync();
            }
            else
            {
                Snackbar.Add($"Clear failed: HTTP {(int)response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Cookbook clear failed");
            Snackbar.Add($"Clear failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isClearing = false;
        }
    }

    /// <summary>
    /// Bulk-tags everything without world data as belonging to the selected world.
    /// Irreversible (transferred data becomes indistinguishable from real uploads of
    /// that world), so the admin confirms with the exact counts first.
    /// </summary>
    private async Task AssignWorldAsync()
    {
        if (_isAssigning || string.IsNullOrEmpty(_tenantId)
            || _status is not { } status
            || (status.UntaggedFoodCount == 0 && status.UntaggedVariantCount == 0))
        {
            return;
        }

        var label = GameWorlds.DisplayName(_assignWorld);
        var confirmed = await DialogService.ShowMessageBox(
            $"Assign all untagged data to {label}?",
            (MarkupString)($"This tags <strong>{status.UntaggedFoodCount} foods</strong> and " +
                           $"<strong>{status.UntaggedVariantCount:N0} recipe variations</strong> that have no world " +
                           $"data as belonging to <strong>{label}</strong> — including untagged variations of foods " +
                           "that already carry other world tags. Existing world tags are not changed, and the " +
                           "Untagged bucket on the cookbook page becomes empty.<br /><br />" +
                           "<strong>This cannot be undone:</strong> the data becomes indistinguishable from data " +
                           $"uploaded by game clients playing {label}."),
            yesText: $"Assign to {label}",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _isAssigning = true;
        try
        {
            // APIUpload client: tagging ~50k variations can exceed the API client's 10s
            // resilience timeout, and a mid-flight retry of a bulk write is confusing
            // (same reason export/purge use it).
            var client = HttpClientFactory.CreateClient("APIUpload");
            var response = await client.PostAsJsonAsync(
                $"/api/tenants/{Uri.EscapeDataString(_tenantId)}/cookbook/assign-world",
                new CookbookWorldAssignRequestDto { World = _assignWorld });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CookbookWorldAssignResultDto>();
                Snackbar.Add(
                    $"Assigned {result?.Foods ?? 0} foods and {result?.Variants ?? 0:N0} recipe variations to {label}",
                    Severity.Success);
                await LoadStatusAsync();   // the row hides itself once the untagged counts hit 0
            }
            else
            {
                Snackbar.Add($"World assignment failed: HTTP {(int)response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Cookbook world assignment failed");
            Snackbar.Add($"World assignment failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isAssigning = false;
        }
    }

    private async Task HandleImportResponseAsync(HttpResponseMessage response)
    {
        CookbookImportResultDto? result = null;
        try
        {
            result = await response.Content.ReadFromJsonAsync<CookbookImportResultDto>();
        }
        catch (Exception)
        {
            // Non-result error payload (e.g. { error: ... }); fall through to status-code handling.
        }

        _lastResult = result;

        if (response.IsSuccessStatusCode && result != null)
        {
            Snackbar.Add(
                $"Imported {result.Imported} foods with {result.Variants} recipe variations ({result.WikiMatched} wiki-matched)",
                Severity.Success);
            await LoadStatusAsync();
        }
        else
        {
            var firstError = result?.Errors.FirstOrDefault() ?? $"HTTP {(int)response.StatusCode}";
            Snackbar.Add($"Import failed: {firstError}", Severity.Error);
        }
    }
}
