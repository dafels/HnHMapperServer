@page "/register"
@rendermode InteractiveServer
@using HnHMapperServer.Core.DTOs
@using HnHMapperServer.Web.Services
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject HnHMapperServer.Services.Interfaces.IAuthSettingsStore AuthSettings
@inject ISnackbar Snackbar
@inject IInvitationService InvitationService
@inject IJSRuntime JSRuntime
@inject ILogger<Register> Logger

<PageTitle>Create an account - HnH Mapper</PageTitle>

<div class="auth-page">
<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="0" Class="pa-8">
        @if (_loading)
        {
            <div class="d-flex justify-center align-center" style="min-height: 300px;">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" />
            </div>
        }
        else if (!_canRegister)
        {
            <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4" Color="Color.Error">
                <MudIcon Icon="@Icons.Material.Filled.Error" Class="me-2" />
                @(_inviteBlocked ? "Invalid invitation" : "Registration is closed")
            </MudText>

            <MudAlert Severity="Severity.Error" Class="mb-4">
                @_errorMessage
            </MudAlert>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       FullWidth="true"
                       Href="/login">
                Go to login
            </MudButton>
        }
        else
        {
            <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="me-2" />
                Create an account
            </MudText>

            @if (_invitation != null)
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4" Icon="@Icons.Material.Filled.Map">
                    You'll join <strong>@_invitation.TenantName</strong> right after creating your account.
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                    After creating your account you can start a new map or join one with an invite link.
                </MudAlert>
            }

            <MudForm @ref="_form" @bind-IsValid="@_isFormValid">
                <MudStack Spacing="4">
                    <MudTextField @bind-Value="_username"
                                  Label="Username"
                                  Required="true"
                                  RequiredError="Username is required"
                                  Validation="@(new Func<string, string?>(ValidateUsername))"
                                  Variant="Variant.Outlined"
                                  HelperText="3-20 letters, numbers or underscores"
                                  Immediate="true"
                                  OnKeyDown="@HandleKeyPress" />

                    <MudTextField @bind-Value="_discordName"
                                  Label="Discord name"
                                  Required="true"
                                  RequiredError="Discord name is required"
                                  Validation="@(new Func<string, string?>(ValidateDiscordName))"
                                  Variant="Variant.Outlined"
                                  HelperText="So your village knows who you are"
                                  Immediate="true"
                                  OnKeyDown="@HandleKeyPress" />

                    <MudTextField @bind-Value="_password"
                                  Label="Password"
                                  InputType="InputType.Password"
                                  Required="true"
                                  Validation="@(new Func<string, string?>(ValidatePassword))"
                                  Variant="Variant.Outlined"
                                  HelperText="Minimum 6 characters"
                                  Immediate="true"
                                  OnKeyDown="@HandleKeyPress" />

                    <MudTextField @bind-Value="_confirmPassword"
                                  Label="Confirm password"
                                  InputType="InputType.Password"
                                  Required="true"
                                  Validation="@(new Func<string, string?>(ValidateConfirmPassword))"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  OnKeyDown="@HandleKeyPress" />

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
                    }

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               OnClick="HandleRegister"
                               Disabled="@(!_isFormValid || _isRegistering)"
                               Size="Size.Large">
                        @if (_isRegistering)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                            <span>Creating account...</span>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="me-2" />
                            <span>@(_invitation != null ? $"Create account and join {_invitation.TenantName}" : "Create account")</span>
                        }
                    </MudButton>

                    <MudDivider />

                    <MudText Align="Align.Center">
                        Already have an account?
                        <MudLink Href="@LoginHref" Color="Color.Primary">Log in</MudLink>
                        @if (_invitation != null)
                        {
                            <span> — you'll still join automatically.</span>
                        }
                    </MudText>
                </MudStack>
            </MudForm>
        }
    </MudPaper>
</MudContainer>
</div>

@code {
    [SupplyParameterFromQuery(Name = "invite")]
    public string? InviteCode { get; set; }

    private MudForm? _form;
    private bool _isFormValid;
    private bool _isRegistering;
    private bool _loading = true;
    private bool _canRegister;
    private bool _inviteBlocked;

    private string _username = string.Empty;
    private string _discordName = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string _errorMessage = string.Empty;

    private ValidateInvitationDto? _invitation;

    private string LoginHref => string.IsNullOrWhiteSpace(InviteCode)
        ? "/login"
        : $"/login?invite={Uri.EscapeDataString(InviteCode.Trim())}";

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(InviteCode))
        {
            // Open registration is a superadmin decision (Sign-in & onboarding); a valid invite link always works regardless.
            _canRegister = (await AuthSettings.GetPolicyAsync()).SelfRegistrationEnabled;
            if (!_canRegister)
                _errorMessage = "New accounts need an invitation link from a map admin. Ask your village for one.";
            _loading = false;
            return;
        }

        try
        {
            var validation = await InvitationService.ValidateInvitationAsync(InviteCode.Trim());
            if (validation.IsValid)
            {
                _invitation = validation;
                _canRegister = true;
            }
            else
            {
                _inviteBlocked = true;
                _errorMessage = validation.ErrorMessage ?? "Invitation is invalid or expired.";
            }
        }
        catch (Exception ex)
        {
            _inviteBlocked = true;
            _errorMessage = $"Error validating invitation: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private string? ValidateUsername(string username)
    {
        if (string.IsNullOrWhiteSpace(username))
            return "Username is required";

        if (username.Length < 3 || username.Length > 20)
            return "Username must be 3-20 characters";

        if (!System.Text.RegularExpressions.Regex.IsMatch(username, @"^[a-zA-Z0-9_]+$"))
            return "Username can only contain letters, numbers, and underscores";

        return null;
    }

    private string? ValidateDiscordName(string discordName)
    {
        if (string.IsNullOrWhiteSpace(discordName))
            return "Discord name is required";

        var trimmed = discordName.Trim();
        if (trimmed.Length < 2 || trimmed.Length > 32)
            return "Discord name must be 2-32 characters";

        return null;
    }

    private string? ValidatePassword(string pwd)
    {
        if (string.IsNullOrWhiteSpace(pwd))
            return "Password is required";

        if (pwd.Length < 6)
            return "Password must be at least 6 characters";

        return null;
    }

    private string? ValidateConfirmPassword(string confirmPwd)
    {
        if (string.IsNullOrWhiteSpace(confirmPwd))
            return "Please confirm your password";

        if (confirmPwd != _password)
            return "Passwords do not match";

        return null;
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _isFormValid && !_isRegistering)
        {
            await HandleRegister();
        }
    }

    private async Task HandleRegister()
    {
        if (_form != null)
        {
            await _form.ValidateAsync();
            if (!_isFormValid)
                return;
        }

        _errorMessage = string.Empty;
        _isRegistering = true;

        try
        {
            var httpClient = HttpClientFactory.CreateClient("API");
            var registerData = new
            {
                Username = _username,
                Password = _password,
                InviteCode = InviteCode?.Trim(),
                DiscordName = _discordName
            };

            var response = await httpClient.PostAsJsonAsync("/api/auth/register", registerData);

            if (response.IsSuccessStatusCode)
            {
                var responseObj = await response.Content.ReadFromJsonAsync<RegisterResponse>(
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (responseObj?.Joined == true)
                {
                    Snackbar.Add($"Welcome to {responseObj.TenantName}!", Severity.Success);
                }
                else if (!string.IsNullOrEmpty(responseObj?.InviteError))
                {
                    Snackbar.Add($"Account created, but the invitation could not be used: {responseObj.InviteError}", Severity.Warning);
                }

                // Sign the new account in right away (same cookie form post the login page uses); the server
                // lands them inside their new map, or on the create-or-join screen when there is none.
                await SubmitLoginFormAsync(responseObj?.Joined == true ? "/" : "/tenant/select");
                return;
            }

            var errorContent = await response.Content.ReadAsStringAsync();
            try
            {
                var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                _errorMessage = errorObj?.Error ?? "Registration failed";
            }
            catch
            {
                _errorMessage = response.StatusCode switch
                {
                    System.Net.HttpStatusCode.Conflict => "Username already exists",
                    System.Net.HttpStatusCode.BadRequest => "Invalid invitation code or registration data",
                    System.Net.HttpStatusCode.Forbidden => "Registration requires an invitation link",
                    System.Net.HttpStatusCode.TooManyRequests => "Too many attempts. Please wait a moment and try again.",
                    _ => "Registration failed. Please try again."
                };
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Registration failed");
            _errorMessage = $"Error: {ex.Message}";
            StateHasChanged();
        }
        finally
        {
            _isRegistering = false;
        }
    }

    /// <summary>
    /// Posts the just-entered credentials to the Web cookie endpoint. If anything goes wrong the user simply
    /// lands on the login page with an "account created" note - never stuck.
    /// </summary>
    private async Task SubmitLoginFormAsync(string returnUrl)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", $@"
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/api/login';

                const userInput = document.createElement('input');
                userInput.type = 'hidden';
                userInput.name = 'user';
                userInput.value = {System.Text.Json.JsonSerializer.Serialize(_username)};
                form.appendChild(userInput);

                const passInput = document.createElement('input');
                passInput.type = 'hidden';
                passInput.name = 'pass';
                passInput.value = {System.Text.Json.JsonSerializer.Serialize(_password)};
                form.appendChild(passInput);

                const returnInput = document.createElement('input');
                returnInput.type = 'hidden';
                returnInput.name = 'returnUrl';
                returnInput.value = {System.Text.Json.JsonSerializer.Serialize(returnUrl)};
                form.appendChild(returnInput);

                document.body.appendChild(form);
                form.submit();
            ");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Auto sign-in after registration failed; sending user to login");
            NavigationManager.NavigateTo("/login?registered=1", forceLoad: true);
        }
    }

    private class ErrorResponse
    {
        public string Error { get; set; } = string.Empty;
    }

    private class RegisterResponse
    {
        public string UserId { get; set; } = string.Empty;
        public string Username { get; set; } = string.Empty;
        public string? TenantId { get; set; }
        public string? TenantName { get; set; }
        public bool Joined { get; set; }
        public bool AwaitingAssignment { get; set; }
        public string? InviteError { get; set; }
        public string Message { get; set; } = string.Empty;
    }
}
