@page "/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode InteractiveServer
@using HnHMapperServer.Web.Models
@using HnHMapperServer.Web.Security
@using HnHMapperServer.Web.Services
@inject NavigationManager NavigationManager
@inject ExternalAuthProviders ExternalProviders
@inject HnHMapperServer.Services.Interfaces.IAuthSettingsStore AuthSettings
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject ILogger<Login> Logger
@inject IJSRuntime JSRuntime

<PageTitle>Login - HnH Mapper</PageTitle>

<div class="auth-page">
<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudCard Class="pa-6 glass-morphism">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Class="me-2" />
            HnH Mapper Login
        </MudText>

        @if (_registered)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-3 glass-morphism" Dense="true">
                Account created. Log in to continue.
            </MudAlert>
        }

        @if (!string.IsNullOrEmpty(Invite))
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3 glass-morphism" Dense="true">
                Log in and you'll be taken back to your invite to join the map automatically.
            </MudAlert>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3 glass-morphism">
                @_errorMessage
            </MudAlert>
        }

        @if (!_showPasswordForm)
        {
            @* ---- Choice of sign-in methods: one button each, nothing else ---- *@
            <MudStack Spacing="2">
                @foreach (var provider in ExternalProviders.Enabled)
                {
                    <MudButton Variant="Variant.Filled" FullWidth="true" Size="Size.Large"
                               Class="@ProviderButtonClass(provider)"
                               StartIcon="@ProviderIcon(provider)"
                               Href="@provider.ChallengeUrl(invite: Invite, returnUrl: EffectiveReturnUrl)">
                        @(provider.Scheme == ExternalAuthProviders.SteamScheme ? "Sign in through Steam" : $"Continue with {provider.DisplayName}")
                    </MudButton>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Key"
                           OnClick="@(() => _showPasswordForm = true)">
                    Username and password
                </MudButton>
            </MudStack>
        }
        else
        {
            @* ---- Username / password form (also the home of "create an account") ---- *@
            <MudForm @ref="_form">
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_username"
                                  Label="Username"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  AutoFocus="true"
                                  Disabled="@_isLoggingIn"
                                  OnKeyPress="@HandleKeyPress" />

                    <MudTextField @bind-Value="_password"
                                  Label="Password"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  Required="true"
                                  Disabled="@_isLoggingIn"
                                  OnKeyPress="@HandleKeyPress" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               OnClick="HandleLogin"
                               Disabled="@_isLoggingIn"
                               Size="Size.Large">
                        @if (_isLoggingIn)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                            <span>Logging in...</span>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Login" Class="me-2" />
                            <span>Log in</span>
                        }
                    </MudButton>
                </MudStack>
            </MudForm>

            @if (_selfRegistrationEnabled || !string.IsNullOrEmpty(Invite))
            {
                <MudText Align="Align.Center" Class="mt-4">
                    @(string.IsNullOrEmpty(Invite) ? "New here?" : "No account yet?")
                    <MudLink Href="@RegisterHref" Color="Color.Primary">Create an account</MudLink>
                </MudText>
            }

            @if (ExternalProviders.Any)
            {
                <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Class="mt-2"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => _showPasswordForm = false)">
                    Other sign-in options
                </MudButton>
            }
        }

        <MudText Align="Align.Center" Class="mt-3">
            Join our Discord server
        </MudText>
        <MudText Align="Align.Center" Class="mt-1">
            <a href="https://discord.gg/PTdMrVeq3q" target="_blank">
                <img src="https://dcbadge.limes.pink/api/server/PTdMrVeq3q?style=flat&theme=discord"
                     alt="Join our Discord server"
                     style="vertical-align: middle;" />
            </a>
        </MudText>
    </MudCard>
</MudContainer>
</div>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "registered")]
    public string? Registered { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    /// <summary>Invite code carried from an invite landing page; after login the user is sent back there to redeem it.</summary>
    [SupplyParameterFromQuery(Name = "invite")]
    public string? Invite { get; set; }

    /// <summary>Local path to land on after login (validated server-side; non-local values are ignored).</summary>
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private MudForm? _form;
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _isLoggingIn;
    private bool _registered;
    private bool _selfRegistrationEnabled = true;
    private bool _alreadyAuthenticated;
    private bool _showPasswordForm;

    private string RegisterHref => string.IsNullOrEmpty(Invite)
        ? "/register"
        : $"/register?invite={Uri.EscapeDataString(Invite)}";

    /// <summary>Where the cookie endpoint should send the user after a successful login.</summary>
    private string? EffectiveReturnUrl
    {
        get
        {
            if (!string.IsNullOrEmpty(Invite))
                return $"/invite/{Uri.EscapeDataString(Invite)}";
            return IsLocalPath(ReturnUrl) ? ReturnUrl : null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _alreadyAuthenticated = HttpContext?.User?.Identity?.IsAuthenticated == true;

        // Superadmin-managed (SuperAdmin → Sign-in & onboarding)
        _selfRegistrationEnabled = (await AuthSettings.GetPolicyAsync()).SelfRegistrationEnabled;

        // Three buttons by default (Steam / Discord / username+password). The password form opens directly when
        // it is the only option, after a failed password login, or right after creating a password account.
        _showPasswordForm = !ExternalProviders.Any || Registered == "1" || Error == "1";

        // Check for query parameters
        _registered = Registered == "1";
        _errorMessage = Error switch
        {
            "1" => "Invalid username or password",
            "steam" => "Steam sign-in failed. Try again or log in with your password.",
            "discord" => "Discord sign-in failed. Try again or log in with your password.",
            "external" => "Sign-in with that provider failed. Try again or log in with your password.",
            _ => string.Empty
        };
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || !_alreadyAuthenticated)
            return;

        // Already signed in (e.g. bounced here by a stale circuit): go where the user was heading.
        NavigationManager.NavigateTo(EffectiveReturnUrl ?? "/", forceLoad: true);
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))
        {
            _errorMessage = "Please enter username and password";
            return;
        }

        _errorMessage = string.Empty;
        _isLoggingIn = true;

        try
        {
            // Pre-flight against the API so we can show a friendly error without a full page round-trip.
            // The actual browser session is created by the Web /api/login form post below, which also decides
            // where the user lands (their map, the invite they came from, or the create-or-join screen).
            var apiClient = HttpClientFactory.CreateClient("API");
            var loginData = new { Username = _username, Password = _password };
            var apiResponse = await apiClient.PostAsJsonAsync("/api/auth/login", loginData);

            if (!apiResponse.IsSuccessStatusCode)
            {
                Logger.LogWarning("API login pre-flight failed: Status={Status}", apiResponse.StatusCode);

                _errorMessage = apiResponse.StatusCode switch
                {
                    System.Net.HttpStatusCode.Unauthorized => "Invalid username or password",
                    System.Net.HttpStatusCode.Forbidden => "Your account has been disabled",
                    System.Net.HttpStatusCode.TooManyRequests => "Too many login attempts. Please wait a moment and try again.",
                    _ => $"Login failed: {apiResponse.StatusCode}"
                };
                return;
            }

            // Submit a form to /api/login using JavaScript to establish the authentication cookie
            var returnUrlJs = System.Text.Json.JsonSerializer.Serialize(EffectiveReturnUrl ?? string.Empty);
            await JSRuntime.InvokeVoidAsync("eval", $@"
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/api/login';

                const userInput = document.createElement('input');
                userInput.type = 'hidden';
                userInput.name = 'user';
                userInput.value = {System.Text.Json.JsonSerializer.Serialize(_username)};
                form.appendChild(userInput);

                const passInput = document.createElement('input');
                passInput.type = 'hidden';
                passInput.name = 'pass';
                passInput.value = {System.Text.Json.JsonSerializer.Serialize(_password)};
                form.appendChild(passInput);

                const returnInput = document.createElement('input');
                returnInput.type = 'hidden';
                returnInput.name = 'returnUrl';
                returnInput.value = {returnUrlJs};
                form.appendChild(returnInput);

                document.body.appendChild(form);
                form.submit();
            ");
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "HTTP request exception during login");
            _errorMessage = $"Connection error: {ex.Message}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected exception during login");
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isLoggingIn = false;
        }
    }

    private static string ProviderButtonClass(ExternalAuthProvider provider) => provider.Scheme switch
    {
        ExternalAuthProviders.SteamScheme => "invite-landing-provider invite-landing-steam",
        ExternalAuthProviders.DiscordScheme => "invite-landing-provider invite-landing-discord",
        _ => "invite-landing-provider"
    };

    private static string ProviderIcon(ExternalAuthProvider provider) => provider.Scheme switch
    {
        ExternalAuthProviders.SteamScheme => Icons.Custom.Brands.Steam,
        ExternalAuthProviders.DiscordScheme => Icons.Custom.Brands.Discord,
        _ => Icons.Material.Filled.Login
    };

    private static bool IsLocalPath(string? url) =>
        !string.IsNullOrWhiteSpace(url)
        && url.StartsWith('/')
        && !url.StartsWith("//", StringComparison.Ordinal)
        && !url.StartsWith("/\\", StringComparison.Ordinal);
}
