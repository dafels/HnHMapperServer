                                    </div>
                                </td>
                            </MudTr>
                        }
                    </ChildRowContent>
                    <NoRecordsContent>
                        <div class="no-results">
                            <MudText Typo="Typo.body1">No foods match your search.</MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearFilters">Clear filters</MudButton>
                        </div>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
                    </PagerContent>
                </MudTable>
            }
        </MudPaper>

    </MudContainer>
</div>

@code {
    // FEP palette lives in Core (FepPalette) so the notification bell's stat
    // preview shares it; this alias keeps the page's many call sites unchanged.
    private static readonly IReadOnlyDictionary<string, string> StatFullNames = FepPalette.StatFullNames;

    /// <summary>
    /// One master-table row. The Effective* fields (and every derived number: totals,
    /// per-hunger, stat maps) hold the values for the currently selected world — the
    /// per-world snapshot when one exists, the canonical food values otherwise. Rows
    /// are rebuilt by <see cref="RebuildRows"/> whenever the world selection changes.
    /// </summary>
    private sealed record FoodRow(
        FoodDto Food,
        string SearchBlob,
        decimal TotalFep,
        decimal FepPerHunger,
        Dictionary<string, decimal> StatTotals,
        Dictionary<string, decimal> StatTierTotals,
        string? Prep,
        string BaseName,
        List<FoodFepDto> EffectiveFeps,
        decimal EffectiveHunger,
        int EffectiveEnergy);

    /// <summary>Preparation-type name prefixes ("Smoked Beef" → prep Smoked, base Beef).</summary>
    private static readonly string[] PrepPrefixes =
    {
        "Sizzling", "Smoked", "Spitroast", "Roast", "Dried", "Boiled",
        "Pickled", "Baked", "Fried", "Grilled", "Raw", "Yesteryear's"
    };

    private const string PlainPrepKey = "Plain";

    /// <summary>World-chip key for foods with no world tags (label-as-key, like PlainPrepKey).</summary>
    private const string UntaggedWorldKey = "Untagged";

    // The variations-table row type is the shared CookbookVariantRow (aliased to
    // VariantRow at the top of the file) so the flat "All recipes" view can share
    // prebuilt rows across circuits via CookbookFlatCache.

    /// <summary>One flat-view row: a recipe variation paired with its owning food's row.</summary>
    private sealed record FlatRow(FoodRow Food, VariantRow V);

    private enum CookbookView { Foods, Recipes }

    /// <summary>One entry of a wiki canonical recipe: "Edible Mushroom x2" → ("Edible Mushroom", "x2").</summary>
    private sealed record RecipePart(string Name, string? Qty, bool Optional);

    /// <summary>Splits a trailing quantity ("x2", "(0.5 kg)", "0.1 L") off a recipe entry.</summary>
    private static readonly Regex RecipeQtyRegex = new(
        @"^(?<name>.+?)(?:\s*(?<qty>x\s?\d+|\([^)]*\)|\d+(?:[.,]\d+)?\s*(?:l|ml|kg|g)\.?))?$",
        RegexOptions.IgnoreCase);

    private sealed record InheritedRecipe(string BaseName, string Recipe, string? Station);

    /// <summary>
    /// For prep-variants without their own wiki page ("Sizzling Roast Beef"), the recipe
    /// to inherit: the base food's ("Roast Beef"), or — when the base is not an eaten
    /// food ("Roast Beef Bollock" → "Beef Bollock") — the wiki recipe index entry.
    /// </summary>
    private InheritedRecipe? BaseRecipeSource(FoodRow row)
    {
        if (row.Prep == null || !string.IsNullOrEmpty(row.Food.RecipeText))
        {
            return null;
        }

        if (_rowsByName.TryGetValue(row.BaseName, out var baseRow)
            && !string.IsNullOrEmpty(baseRow.Food.RecipeText))
        {
            return new InheritedRecipe(baseRow.Food.Name, baseRow.Food.RecipeText!, baseRow.Food.CookingStation);
        }

        if (_recipeIndex.TryGetValue(row.BaseName, out var entry))
        {
            return new InheritedRecipe(row.BaseName, entry.Recipe, entry.Station);
        }

        return null;
    }

    /// <summary>
    /// One resolved recipe entry: the part itself, the inline chain of single-ingredient
    /// intermediates behind it ("Raw Badger ← Badger"), and — when the chain ends in a
    /// multi-ingredient intermediate ("Unbaked Meatpie") — that recipe's own entries nested.
    /// </summary>
    private sealed record RecipeNode(RecipePart Part, List<RecipePart> Chain, List<RecipeNode>? Sub);

    private const int MaxRecipeNesting = 3;
    private const int MaxRecipeChainLinks = 8;

    /// <summary>Wiki recipe line per craftable (incl. non-food intermediates); empty until loaded.</summary>
    private Dictionary<string, RecipeIndexEntryDto> _recipeIndex = new(StringComparer.OrdinalIgnoreCase);

    private List<RecipeNode> BuildRecipeNodes(string recipeText, int depth, HashSet<string> path)
    {
        var nodes = new List<RecipeNode>();
        foreach (var part in RecipeParts(recipeText))
        {
            var visited = new HashSet<string>(path, StringComparer.OrdinalIgnoreCase);
            var chain = new List<RecipePart>();
            List<RecipeNode>? sub = null;
            var current = part.Name;

            while (chain.Count < MaxRecipeChainLinks
                   && visited.Add(current)
                   && _recipeIndex.TryGetValue(current, out var entry))
            {
                var subParts = RecipeParts(entry.Recipe);
                if (subParts.Count == 1)
                {
                    chain.Add(subParts[0]);
                    current = subParts[0].Name;
                    continue;
                }

                if (depth < MaxRecipeNesting)
                {
                    sub = BuildRecipeNodes(entry.Recipe, depth + 1, visited);
                }

                break;
            }

            nodes.Add(new RecipeNode(part, chain, sub));
        }

        return nodes;
    }

    private RenderFragment RecipeList(List<RecipeNode> nodes, bool nested) =>
        @<ul class="ingredient-list @(nested ? "recipe-sub" : null)">
            @foreach (var node in nodes)
            {
                <li>
                    @node.Part.Name
                    @if (node.Part.Qty != null)
                    {
                        <span class="ingredient-pct">@node.Part.Qty</span>
                    }
                    @if (node.Part.Optional)
                    {
                        <span class="recipe-optional">optional</span>
                    }
                    @foreach (var link in node.Chain)
                    {
                        <span class="recipe-chain" title="made from">←</span>
                        @link.Name
                        @if (link.Qty != null)
                        {
                            <span class="ingredient-pct">@link.Qty</span>
                        }
                    }
                    @if (node.Sub != null)
                    {
                        @RecipeList(node.Sub, true)
                    }
                </li>
            }
        </ul>;

    private static List<RecipePart> RecipeParts(string recipeText)
    {
        var parts = new List<RecipePart>();
        foreach (var rawPart in recipeText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var text = rawPart;
            var optional = text.StartsWith("optional:", StringComparison.OrdinalIgnoreCase);
            if (optional)
            {
                text = text["optional:".Length..].Trim();
            }

            if (text.Length == 0)
            {
                continue;
            }

            var match = RecipeQtyRegex.Match(text);
            parts.Add(match.Success && match.Groups["qty"].Success
                ? new RecipePart(match.Groups["name"].Value.Trim(), match.Groups["qty"].Value, optional)
                : new RecipePart(text, null, optional));
        }

        return parts;
    }

    private const int VariantsPerPage = 25;

    private static readonly string[] StatOrderList = { "STR", "AGI", "INT", "CON", "PER", "CHA", "DEX", "WILL", "PSY" };

    private List<FoodRow> _rows = new();
    private List<FoodDto> _foods = new();
    private List<string> _allSatiations = new();
    private List<string> _allPreps = new();
    private List<string> _allWorlds = new();
    private Dictionary<string, List<FoodRow>> _prepSiblings = new(StringComparer.Ordinal);
    private Dictionary<int, FoodRow> _rowsById = new();

    // ----- Flat "All recipes" view (every recorded variation as its own row) -----

    private CookbookView _view = CookbookView.Foods;
    private string? _tenantId;                              // TenantId claim — key of the shared flat-row cache
    private IReadOnlyList<CookbookFlatEntry>? _flatEntries; // shared per-(tenant, world) row list from CookbookFlatCache
    private string _flatWorldKey = string.Empty;            // world the entries were built for
    private int _flatGen;                                   // bumped when entries or FoodRows change (memo buster)
    private bool _flatLoading;
    private bool _flatLoadFailed;
    private MudTable<FlatRow>? _flatTable;
    private int _panelFilterVersion;                        // bumped when the active panel's name set changes

    // ----- Ingredient facet (flat view only): data-derived larder filter -----
    // Selection semantics live in Core (IngredientFilter). Sets use OrdinalIgnoreCase
    // per the kernel's contract. _ingredientFilterVersion is the FlatStateKey input —
    // bump it in EVERY mutation path (the _panelFilterVersion discipline).

    private readonly HashSet<string> _selectedIngredients = new(StringComparer.OrdinalIgnoreCase);
    private bool _ingredientsOnlyMode;
    private int _ingredientFilterVersion;
    private List<KeyValuePair<string, int>> _ingredientVocab = new();
    private Dictionary<string, int> _ingredientGlobalCounts = new(StringComparer.OrdinalIgnoreCase);
    private int _ingredientVocabTotal;
    private int _ingredientVocabGen = -1;                   // _flatGen the vocabulary was built for
    private bool _ingredientWallOpen;
    private string _ingredientWallFilter = string.Empty;
    private List<(string Letter, List<(string Name, bool IsComponent)> Entries)> _ingredientWallGroups = new();
    private int _ingredientWallGen = -1;                    // vocabulary gen the groups were built for

    // Second ingredient source: recipe COMPONENTS from the canonical (wiki) recipe trees.
    // The game records only the variable, quality-carrying SOURCE ingredients and flattens
    // intermediates (butter → the milk it was churned from; fixed parts like leeks or trout
    // are not recorded at all), so names like "Butter" exist only here. Component picks
    // filter at FOOD level (the recipe calls for it) and AND with recorded picks.
    private readonly HashSet<string> _selectedComponents = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<int, HashSet<string>> _componentsByFoodId = new();
    private Dictionary<string, int> _componentGlobalCounts = new(StringComparer.OrdinalIgnoreCase); // component-only names → recipe rows of foods calling for it
    private int _componentsGen = -1;
    private Dictionary<int, int> _ingredientFoodMatches = new();
    private string? _ingredientFoodMatchesKey;
    private readonly HashSet<int> _expanded = new();
    private readonly Dictionary<int, List<VariantRow>> _variations = new();
    private readonly Dictionary<int, string> _variantFilters = new();
    private string? _selectedStat;
    private string? _selectedSatiation;
    private string? _selectedPrep;
    private string? _selectedWorld;

    // Panels & favorites
    private List<FoodPanelDto> _panels = new();
    private HashSet<string> _favoriteKeys = new(StringComparer.Ordinal);
    private Dictionary<string, FoodRow> _rowsByName = new(StringComparer.Ordinal);
    private bool _panelsExpanded = true;
    private int? _activePanelId;
    private HashSet<string>? _activePanelNames;
    private string? _draggingFood;
    private string _draggingSignature = string.Empty;
    private (int PanelId, int ItemId)? _draggingChip;
    private int? _dragOverPanelId;
    private bool _dragActive;
    private string? _focusVariantKey;
    private string? _focusFoodName;
    private MudTable<FoodRow>? _masterTable;

    /// <summary>Composite key for favorite lookups: food name + variant signature ("" = whole food).</summary>
    private static string FavKey(string foodName, string signature) => foodName + "" + signature;

    private bool IsFavorite(string foodName, string signature) => _favoriteKeys.Contains(FavKey(foodName, signature));

    private bool _loading = true;
    private bool _loadFailed;
    private string _search = string.Empty;
    private int _quality = 10;

    private int Quality
    {
        get => _quality;
        set
        {
            _quality = value;
            // Absolute thresholds compare quality-scaled values, so the variant-aware
            // match set has to be recomputed for the new multiplier.
            QueueServerMatchRefresh();
        }
    }

    // FEP threshold filters (str>50%, int2>15, hunger<2 ...) live as text in two inputs:
    // the search box (mixed with free text, kept for muscle memory) and the dedicated filter
    // box. Each is parsed once per change here — BaseFiltered is re-enumerated many times per
    // render — and _allConditions is the union every consumer reads.
    private IReadOnlyList<FepFilterCondition> _conditions = Array.Empty<FepFilterCondition>();
    private string _residualSearch = string.Empty;
    private IReadOnlyList<FepFilterCondition> _filterConditions = Array.Empty<FepFilterCondition>();
    private string _filterResidual = string.Empty;
    private string _filterText = string.Empty;
    private List<FepFilterCondition> _allConditions = new();

    private string Search
    {
        get => _search;
        set
        {
            _search = value ?? string.Empty;
            (_conditions, _residualSearch) = FepFilterParser.Parse(_search);
            RebuildAllConditions();
        }
    }

    private string FilterText
    {
        get => _filterText;
        set
        {
            _filterText = value ?? string.Empty;
            (_filterConditions, _filterResidual) = FepFilterParser.Parse(_filterText);
            RebuildAllConditions();
        }
    }

    private void RebuildAllConditions()
    {
        _allConditions = _conditions.Concat(_filterConditions).ToList();
        QueueServerMatchRefresh();
    }

    // Variant-aware matching: the server evaluates the conditions against every food's base
    // values AND all of its recipe variations (data the client never loads in full), so a food
    // like Nut Jerky shows up for str>50% when one of its variations passes even though the
    // base does not. Until a result lands (or on error), base-only evaluation is the fallback.
    private Dictionary<int, FoodConditionMatchDto>? _serverMatches;
    private CancellationTokenSource? _matchCts;

    private void QueueServerMatchRefresh()
    {
        _matchCts?.Cancel();
        _serverMatches = null;

        if (_allConditions.Count == 0)
        {
            return;
        }

        var expr = string.Join(" ", _allConditions.Select(c => c.RawText));
        // The server mirrors the world facet: world-effective values, bucket-scoped variant counts.
        var world = _selectedWorld == null ? null
            : _selectedWorld == UntaggedWorldKey ? GameWorlds.UntaggedSentinel
            : _selectedWorld;
        var cts = new CancellationTokenSource();
        _matchCts = cts;
        _ = RefreshServerMatchesAsync(expr, _quality, world, cts.Token);
    }

    private async Task RefreshServerMatchesAsync(string expr, int quality, string? world, CancellationToken ct)
    {
        try
        {
            var client = HttpClientFactory.CreateClient("API");
            var url = $"/api/v1/cookbook/filter-matches?expression={Uri.EscapeDataString(expr)}&quality={quality}";
            if (world != null)
            {
                url += $"&world={Uri.EscapeDataString(world)}";
            }
            var matches = await client.GetFromJsonAsync<List<FoodConditionMatchDto>>(url, ct);
            if (!ct.IsCancellationRequested)
            {
                _serverMatches = matches?.ToDictionary(m => m.FoodId);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
            // Base-only filtering remains the graceful fallback.
        }
    }

    // Cediner-style filtering: per-stat columns toggle (display/sort only), chip sorting
    private bool _showStatColumns;
    private string? _conditionSortKey;      // SortKeyOf() of the chip driving the sort, null = off
    private bool _conditionSortDesc = true;
    private MudTextField<string>? _filterFieldRef;

    /// <summary>Cell count of the master table — the detail row's colspan must match it.</summary>
    private int VisibleColumnCount => _showStatColumns ? 18 : (_selectedStat != null ? 11 : 10);

    private double QualityMultiplier => Math.Sqrt(Math.Max(1, _quality) / 10.0);

    // ----- Notification deep link (?highlight=ids&hlworld=genus) -----

    [SupplyParameterFromQuery(Name = "highlight")]
    public string? HighlightCsv { get; set; }

    [SupplyParameterFromQuery(Name = "hlworld")]
    public string? HighlightWorld { get; set; }

    private readonly HashSet<int> _highlightIds = new();
    private string? _appliedHighlightCsv;
    private bool _revealQueued;

    // ----- "New" recency (badge + Added facet chip) -----

    /// <summary>Frozen per catalog load so rows don't age out mid-session render by render.</summary>
    private DateTime _newCutoffUtc = DateTime.UtcNow.AddDays(-7);
    private bool _showNewOnly;

    /// <summary>
    /// Player-discovered within the last 7 days. ContributedByName != null excludes
    /// admin bulk imports, which reset ImportedAt for the whole catalog.
    /// </summary>
    private bool IsNewFood(FoodRow r) =>
        r.Food.ContributedByName != null && r.Food.ImportedAt >= _newCutoffUtc;

    private int NewChipCount => FlatActive
        ? FlatCounts.NewCount
        : CountBase(includeSatiation: true, includePrep: true, includeStat: true).Count(IsNewFood);

    /// <summary>Non-null only during the static prerender pass.</summary>
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // TenantId claim = key of the cross-circuit flat-row cache. Same claim the API
        // resolves the tenant from, so cached data can never cross tenants.
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _tenantId = authState.User.FindFirst("TenantId")?.Value;
        if (string.IsNullOrEmpty(_tenantId))
        {
            // No active tenant: nothing to show until the user creates or joins a map. Navigate only in the
            // interactive pass - during prerendering (HttpContext != null) NavigateTo throws NavigationException.
            if (HttpContext == null)
                Navigation.NavigateTo("/tenant/select");
            return;
        }

        await Task.WhenAll(LoadCatalogAsync(), LoadPanelsAsync());
    }

    /// <summary>
    /// Applies the ?highlight= deep link. Lives in OnAfterRenderAsync (not OnParametersSet)
    /// because the page prerenders: stripping the query there would erase it before the
    /// interactive circuit sees it, and JS interop is illegal during prerender. Fires for
    /// both entry paths — fresh load with the param, and an in-circuit NavigateTo from the
    /// notification bell while already on /cookbook.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (string.IsNullOrEmpty(HighlightCsv))
        {
            // Param gone (stripped or never set): allow the same digest to re-apply later.
            _appliedHighlightCsv = null;
        }
        else if (HighlightCsv != _appliedHighlightCsv && !_loading && !_loadFailed)
        {
            _appliedHighlightCsv = HighlightCsv;
            await ApplyHighlightAsync(HighlightCsv, HighlightWorld);
            return; // reveal on the NEXT render, once the highlighted rows exist in the DOM
        }

        if (_revealQueued)
        {
            _revealQueued = false;
            try
            {
                await JS.InvokeVoidAsync("cookbookHighlight.reveal");
            }
            catch (Exception)
            {
                // Scrolling is progressive enhancement.
            }

            // One-shot: strip the query so F5 doesn't re-pulse. The chip keeps the filter.
            Navigation.NavigateTo("/cookbook", replace: true);
        }

        // Shared recipe-row (re)load funnel: covers every path that outdates the entries —
        // a world change while they are in use, the initial toggle racing a slow catalog
        // load — for the flat view AND for the ingredient facet in the Foods view (open
        // wall or active selection). Failed loads stop the loop until Retry resets.
        var rowsNeeded = _view == CookbookView.Recipes || _ingredientWallOpen || AnyIngredientPicks;
        if (rowsNeeded && !FlatRowsCurrent && !_flatLoading && !_flatLoadFailed)
        {
            await EnsureFlatRowsAsync();
            StateHasChanged();
        }
    }

    private async Task ApplyHighlightAsync(string csv, string? world)
    {
        var ids = new HashSet<int>();
        foreach (var part in csv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (int.TryParse(part, out var id))
            {
                ids.Add(id);
            }
        }

        // The catalog in _rows is as old as this page instance — when the click happens
        // while already on /cookbook, the just-discovered foods aren't in it yet.
        // Refetch whenever any requested id is unknown, so the deep link always lands
        // on the current catalog (also picks up new variant counts and New badges).
        if (ids.Count > 0 && ids.Any(id => !_rows.Any(r => r.Food.Id == id)))
        {
            await LoadCatalogAsync();
        }

        var matched = _rows.Where(r => ids.Contains(r.Food.Id)).ToList();
        if (matched.Count == 0)
        {
            // Re-import may have replaced the ids since the notification was created.
            Snackbar.Add("Those foods are not in the catalog right now", Severity.Info);
            _highlightIds.Clear();
            _revealQueued = true; // still strips the query; reveal no-ops without a match
            StateHasChanged();
            return;
        }

        // A highlighted food must never be invisible: back to the grouped view (the
        // digest targets foods), clear every facet that could hide it, then keep/pick
        // a world bucket all the matches actually live in.
        _view = CookbookView.Foods;
        Search = string.Empty;
        FilterText = string.Empty;
        _selectedStat = null;
        _selectedSatiation = null;
        _selectedPrep = null;
        _conditionSortKey = null;
        _showNewOnly = false;
        ClearIngredients();
        ClearFocus();
        ClearPanelFilter();

        if (_selectedWorld != null && !matched.All(r => WorldMatches(r.Food.Worlds, _selectedWorld)))
        {
            if (!string.IsNullOrEmpty(world) && matched.All(r => r.Food.Worlds.Contains(world)))
            {
                SetWorld(world);
            }
            else
            {
                SetWorld(null);
            }
        }

        _highlightIds.Clear();
        _highlightIds.UnionWith(matched.Select(r => r.Food.Id));

        _masterTable?.NavigateTo(0);
        _revealQueued = true;
        StateHasChanged();
    }

    private void ClearHighlight() => _highlightIds.Clear();

    private string MasterRowClass(FoodRow row, int _) =>
        _highlightIds.Contains(row.Food.Id) ? "ck-new-flash" : string.Empty;

    private async Task LoadCatalogAsync()
    {
        _loading = true;
        _loadFailed = false;
        _newCutoffUtc = DateTime.UtcNow.AddDays(-7);

        try
        {
            var client = HttpClientFactory.CreateClient("API");
            var recipeIndexTask = LoadRecipeIndexAsync(client);
            var foods = await client.GetFromJsonAsync<List<FoodDto>>("/api/v1/cookbook/foods") ?? new List<FoodDto>();
            await recipeIndexTask;

            _foods = foods;

            // Known worlds always render (newest first, 0-count chips disabled);
            // unknown genus hashes present in the data follow, shown shortened.
            _allWorlds = GameWorlds.Known
                .OrderByDescending(w => w.Order)
                .Select(w => w.Genus)
                .Concat(_foods
                    .SelectMany(f => f.Worlds)
                    .Where(g => GameWorlds.OrderOf(g) < 0)
                    .Distinct(StringComparer.Ordinal)
                    .OrderBy(g => g, StringComparer.Ordinal))
                .ToList();

            // Default to the newest known world that actually has data; null (no world
            // filter) otherwise, so the page isn't empty before tagged uploads exist.
            // ??= keeps a user's selection across the Retry path.
            _selectedWorld ??= GameWorlds.Known
                .OrderByDescending(w => w.Order)
                .Select(w => w.Genus)
                .FirstOrDefault(g => _foods.Any(f => f.Worlds.Contains(g)));

            _variations.Clear();
            RebuildRows();

            _allPreps = _rows
                .Where(r => r.Prep != null)
                .GroupBy(r => r.Prep!)
                .OrderByDescending(g => g.Count())
                .Select(g => g.Key)
                .ToList();

            _allSatiations = _rows
                .SelectMany(r => r.Food.SatiationGroups)
                .Distinct(StringComparer.Ordinal)
                .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (Exception)
        {
            _loadFailed = true;
            Snackbar.Add("Failed to load the cookbook", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadRecipeIndexAsync(HttpClient client)
    {
        try
        {
            var entries = await client.GetFromJsonAsync<List<RecipeIndexEntryDto>>("/api/v1/cookbook/recipe-index")
                          ?? new List<RecipeIndexEntryDto>();
            var index = new Dictionary<string, RecipeIndexEntryDto>(StringComparer.OrdinalIgnoreCase);
            foreach (var entry in entries)
            {
                index.TryAdd(entry.Name, entry);
            }

            _recipeIndex = index;
        }
        catch (Exception)
        {
            // Recursive recipe expansion is progressive enhancement — the page works without it.
        }
    }

    /// <summary>
    /// (Re)derives every row from the raw DTOs using world-effective values — called on load
    /// and whenever the selected world changes, because the per-world snapshots swap the
    /// displayed numbers (and everything derived from them: totals, per-hunger, stat maps).
    /// </summary>
    private void RebuildRows()
    {
        _rows = _foods.Select(BuildRow).ToList();
        _rowsByName = _rows.ToDictionary(r => r.Food.Name, StringComparer.Ordinal);
        _rowsById = _rows.ToDictionary(r => r.Food.Id);
        _flatGen++; // flat rows pair with FoodRows — force the memoized flat view to rebuild

        _prepSiblings = _rows
            .GroupBy(r => r.BaseName, StringComparer.Ordinal)
            .Where(g => g.Count() > 1)
            .ToDictionary(
                g => g.Key,
                g => g.OrderByDescending(r => r.TotalFep).ToList(),
                StringComparer.Ordinal);

        foreach (var foodId in _variations.Keys.ToList())
        {
            _variations[foodId] = _variations[foodId].Select(r => BuildVariantRow(r.Variant)).ToList();
        }
    }

    private FoodRow BuildRow(FoodDto food)
    {
        var worldValue = _selectedWorld != null && _selectedWorld != UntaggedWorldKey
            ? food.WorldValues.FirstOrDefault(w => w.Genus == _selectedWorld)
            : null;
        var feps = worldValue?.Feps ?? food.Feps;
        var hunger = worldValue?.Hunger ?? food.Hunger;
        var energy = worldValue?.Energy ?? food.Energy;

        var blob = (food.Name + "\n"
                    + string.Join("\n", food.Ingredients.Select(i => i.Name)) + "\n"
                    + food.RecipeText)
            .ToLowerInvariant();
        var total = feps.Sum(f => f.Value);
        var perHunger = hunger > 0 ? total / hunger : 0m;
        var statTotals = feps
            .GroupBy(f => f.Attribute, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.Sum(f => f.Value), StringComparer.OrdinalIgnoreCase);
        var statTierTotals = feps
            .GroupBy(f => f.Attribute.ToUpperInvariant() + f.Tier)
            .ToDictionary(g => g.Key, g => g.Sum(f => f.Value), StringComparer.OrdinalIgnoreCase);
        var prep = PrepPrefixes.FirstOrDefault(p =>
            food.Name.StartsWith(p + " ", StringComparison.Ordinal));
        var baseName = prep != null ? food.Name[(prep.Length + 1)..] : food.Name;
        return new FoodRow(food, blob, total, perHunger, statTotals, statTierTotals, prep, baseName,
            feps, hunger, energy);
    }

    /// <summary>Selected world as a genus hash for value lookups (null = no world / Untagged).</summary>
    private string? EffectiveWorldGenus =>
        _selectedWorld != null && _selectedWorld != UntaggedWorldKey ? _selectedWorld : null;

    private VariantRow BuildVariantRow(FoodVariantDto variant) =>
        CookbookRows.Build(variant, EffectiveWorldGenus);

    /// <summary>
    /// Splits a search text into AND-ed terms on commas ("pork, mushroom" = rows matching
    /// both) — the "what's in my larder" filter. Comma-free text stays one phrase, so
    /// multi-word searches like "fairy mushroom" keep their exact-substring behavior.
    /// </summary>
    private static List<string> SearchTerms(string text) =>
        string.IsNullOrWhiteSpace(text)
            ? new List<string>()
            : text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(t => t.ToLowerInvariant())
                .ToList();

    /// <summary>Text search + FEP threshold conditions — the common base for Filtered and CountBase.</summary>
    private IEnumerable<FoodRow> BaseFiltered
    {
        get
        {
            // A notification deep link filters to exactly the new foods (activation
            // cleared conflicting facets, so these rows are guaranteed visible).
            if (_highlightIds.Count > 0)
            {
                return _rows.Where(r => _highlightIds.Contains(r.Food.Id));
            }

            // A focused panel chip overrides everything: show exactly that food
            // (the free-text search also matches ingredients, which would bury it).
            if (_focusFoodName != null)
            {
                return _rows.Where(r => r.Food.Name == _focusFoodName);
            }

            IEnumerable<FoodRow> rows = _rows;

            var terms = SearchTerms(_residualSearch);
            if (terms.Count > 0)
            {
                rows = rows.Where(r => terms.All(t => r.SearchBlob.Contains(t, StringComparison.Ordinal)));
            }

            if (_allConditions.Count > 0)
            {
                // Server match set = base OR any recipe variation passes; base-only fallback
                // while the async result is pending or unavailable.
                var serverMatches = _serverMatches;
                rows = serverMatches != null
                    ? rows.Where(r => serverMatches.ContainsKey(r.Food.Id))
                    : rows.Where(r => MatchesConditions(TargetOf(r)));
            }

            // Ingredient facet at food level: any recipe of the food passes the selection.
            // Needs the shared recipe rows; until they arrive (OnAfterRenderAsync loads
            // them whenever a selection exists) the facet is simply not applied yet.
            if (_selectedIngredients.Count > 0 && FlatRowsCurrent)
            {
                var ingredientMatches = IngredientFoodMatches;
                rows = rows.Where(r => ingredientMatches.ContainsKey(r.Food.Id));
            }

            // Recipe components are food-level by nature (catalog + recipe index, no rows needed).
            if (_selectedComponents.Count > 0)
            {
                rows = rows.Where(r => FoodHasComponents(r.Food.Id));
            }

            return rows;
        }
    }

    private IEnumerable<FoodRow> Filtered
    {
        get
        {
            var rows = BaseFiltered;

            if (_selectedSatiation != null)
            {
                rows = rows.Where(r => r.Food.SatiationGroups.Contains(_selectedSatiation));
            }

            if (_selectedPrep != null)
            {
                rows = _selectedPrep == PlainPrepKey
                    ? rows.Where(r => r.Prep == null)
                    : rows.Where(r => r.Prep == _selectedPrep);
            }

            if (_selectedWorld != null)
            {
                rows = rows.Where(MatchesWorld);
            }

            if (_activePanelNames != null)
            {
                rows = rows.Where(r => _activePanelNames.Contains(r.Food.Name));
            }

            if (_showNewOnly)
            {
                // Facet chip that filters AND orders, like the selected-stat chip below.
                rows = rows.Where(IsNewFood).OrderByDescending(r => r.Food.ImportedAt);
            }

            if (_selectedStat != null)
            {
                rows = rows
                    .Where(r => r.StatTotals.ContainsKey(_selectedStat))
                    .OrderByDescending(r => r.StatTotals[_selectedStat]);
            }

            // Chip-click sort: keyed by SortKeyOf so it clears itself when the chip is removed.
            if (_conditionSortKey != null)
            {
                var sortCondition = _allConditions.FirstOrDefault(c => SortKeyOf(c) == _conditionSortKey);
                if (sortCondition != null)
                {
                    rows = _conditionSortDesc
                        ? rows.OrderByDescending(r => ConditionValue(TargetOf(r), sortCondition))
                        : rows.OrderBy(r => ConditionValue(TargetOf(r), sortCondition));
                }
            }

            return rows;
        }
    }

    private int FilteredCount => Filtered.Count();

    // ----- Flat "All recipes" view: data plumbing + memoized pipeline -----
    // ~50k rows make the grouped view's recompute-every-render LINQ style too expensive,
    // so the filtered list and all chip counts are memoized per filter-state key and only
    // rebuilt when an input actually changes. Row lists are shared across circuits via
    // CookbookFlatCache; this page keeps references only.

    private bool FlatActive => _view == CookbookView.Recipes && FlatRowsCurrent;

    /// <summary>What the chip counts count in the active view (tooltips).</summary>
    private string CountNoun => FlatActive ? "recipes" : "foods";

    /// <summary>Entries exist and were built for the currently selected world.</summary>
    private bool FlatRowsCurrent =>
        _flatEntries != null && _flatWorldKey == (EffectiveWorldGenus ?? string.Empty);

    /// <summary>Recipe-row universe (foods without recorded variations count as one row).</summary>
    private int TotalRecipeCount => _rows.Sum(r => Math.Max(1, r.Food.VariantCount));

    private async Task SetViewAsync(CookbookView view)
    {
        if (_view == view)
        {
            return;
        }

        _view = view;
        if (view == CookbookView.Recipes && !FlatRowsCurrent)
        {
            await EnsureFlatRowsAsync();
        }
    }

    private async Task EnsureFlatRowsAsync()
    {
        if (_flatLoading)
        {
            return;
        }

        _flatLoading = true;
        _flatLoadFailed = false;
        var world = EffectiveWorldGenus;
        try
        {
            var rows = await FlatCache.GetRowsAsync(_tenantId ?? string.Empty, world, FetchAllVariationsAsync);
            _flatEntries = rows;
            _flatWorldKey = world ?? string.Empty;
            _flatGen++;
        }
        catch (Exception)
        {
            _flatLoadFailed = true;
            Snackbar.Add("Failed to load the recipe list", Severity.Error);
        }
        finally
        {
            _flatLoading = false;
        }
    }

    private async Task RetryFlatAsync()
    {
        FlatCache.Invalidate(_tenantId ?? string.Empty);
        await EnsureFlatRowsAsync();
    }

    private async Task<List<FoodVariantDto>> FetchAllVariationsAsync()
    {
        // APIUpload client: the response is tens of MB — the default API client's 10s
        // resilience timeout would cancel (and retry!) the transfer.
        var client = HttpClientFactory.CreateClient("APIUpload");
        return await client.GetFromJsonAsync<List<FoodVariantDto>>("/api/v1/cookbook/variations")
               ?? new List<FoodVariantDto>();
    }

    private string FlatRowClass(FlatRow row, int _) =>
        _focusVariantKey != null && _focusVariantKey == FavKey(row.Food.Food.Name, row.V.Variant.IngredientSignature)
            ? "variant-focused"
            : string.Empty;

    /// <summary>The flat row's escape hatch to full food details: grouped view, focused.</summary>
    private async Task ShowFoodDetailsAsync(FlatRow row)
    {
        _view = CookbookView.Foods;
        await FocusFoodAsync(row.Food.Food.Name, row.V.Variant.IngredientSignature);
    }

    private List<FlatRow>? _flatViewCache;
    private string? _flatViewKey;
    private FlatChipCounts? _flatCountsCache;
    private string? _flatCountsKey;

    /// <summary>Every input the flat pipeline reads — cache invalidation by comparison.</summary>
    private string FlatStateKey() => string.Join("",
        _flatGen, _search, _filterText, _quality,
        _selectedStat, _selectedSatiation, _selectedPrep, _selectedWorld,
        _activePanelId, _panelFilterVersion, _ingredientFilterVersion,
        _showNewOnly ? "1" : "0",
        _focusFoodName, _focusVariantKey,
        _highlightIds.Count,
        _conditionSortKey, _conditionSortDesc ? "1" : "0");

    private List<FlatRow> FlatFiltered
    {
        get
        {
            var key = FlatStateKey();
            if (_flatViewCache == null || _flatViewKey != key)
            {
                _flatViewCache = ComputeFlatFiltered();
                _flatViewKey = key;
            }

            return _flatViewCache;
        }
    }

    /// <summary>
    /// The full flat universe: one row per recorded variation, paired with its FoodRow.
    /// Foods missing from the (possibly slightly older) bulk list get a synthetic row
    /// from their canonical values, so nothing the grouped view shows can vanish here.
    /// </summary>
    private IEnumerable<FlatRow> AllFlatRows()
    {
        if (_flatEntries == null)
        {
            yield break;
        }

        var seenFoods = new HashSet<int>();
        foreach (var entry in _flatEntries)
        {
            if (_rowsById.TryGetValue(entry.FoodId, out var food))
            {
                seenFoods.Add(entry.FoodId);
                yield return new FlatRow(food, entry.Row);
            }
        }

        foreach (var row in _rows)
        {
            if (!seenFoods.Contains(row.Food.Id))
            {
                yield return new FlatRow(row, CookbookRows.BuildFromFood(row.Food, EffectiveWorldGenus));
            }
        }
    }

    /// <summary>
    /// Base + panel filter — shared by the view pipeline and the chip counts (which then
    /// apply every facet except their own row, mirroring the grouped CountBase semantics).
    /// A focused food skips search/conditions like the grouped BaseFiltered does.
    /// </summary>
    private IEnumerable<FlatRow> FlatCountCore()
    {
        IEnumerable<FlatRow> rows = AllFlatRows();

        if (_highlightIds.Count > 0)
        {
            rows = rows.Where(r => _highlightIds.Contains(r.Food.Food.Id));
        }
        else if (_focusFoodName != null)
        {
            rows = rows.Where(r => r.Food.Food.Name == _focusFoodName);
        }
        else
        {
            var terms = SearchTerms(_residualSearch);
            if (terms.Count > 0)
            {
                // Every term must match somewhere on the row — the food's name/recipe
                // blob or this recipe's own ingredient list ("pork, mushroom" = both).
                rows = rows.Where(r => terms.All(t =>
                    r.Food.SearchBlob.Contains(t, StringComparison.Ordinal)
                    || r.V.SearchBlob.Contains(t, StringComparison.Ordinal)));
            }

            if (_allConditions.Count > 0)
            {
                // Exact per-recipe evaluation — no server round trip needed: unlike the
                // grouped view, every variation is local here.
                rows = rows.Where(r => MatchesConditions(TargetOf(r.V)));
            }
        }

        if (_activePanelNames != null)
        {
            rows = rows.Where(r => _activePanelNames.Contains(r.Food.Food.Name));
        }

        return rows;
    }

    private List<FlatRow> ComputeFlatFiltered()
    {
        var rows = FlatCountCore();

        if (_selectedSatiation != null)
        {
            rows = rows.Where(r => r.Food.Food.SatiationGroups.Contains(_selectedSatiation));
        }

        if (_selectedPrep != null)
        {
            rows = _selectedPrep == PlainPrepKey
                ? rows.Where(r => r.Food.Prep == null)
                : rows.Where(r => r.Food.Prep == _selectedPrep);
        }

        if (_selectedWorld != null)
        {
            rows = rows.Where(r => WorldMatches(r.V.Variant.Worlds, _selectedWorld));
        }

        if (_selectedIngredients.Count > 0)
        {
            rows = rows.Where(r =>
                IngredientFilter.Matches(r.V.Variant.Ingredients, _selectedIngredients, _ingredientsOnlyMode));
        }

        if (_selectedComponents.Count > 0)
        {
            rows = rows.Where(r => FoodHasComponents(r.Food.Food.Id));
        }

        var ordered = false;
        if (_showNewOnly)
        {
            rows = rows.Where(r => IsNewFood(r.Food)).OrderByDescending(r => r.Food.Food.ImportedAt);
            ordered = true;
        }

        if (_selectedStat != null)
        {
            rows = rows
                .Where(r => r.V.StatTotals.ContainsKey(_selectedStat))
                .OrderByDescending(r => r.V.StatTotals[_selectedStat]);
            ordered = true;
        }

        if (_conditionSortKey != null)
        {
            var sortCondition = _allConditions.FirstOrDefault(c => SortKeyOf(c) == _conditionSortKey);
            if (sortCondition != null)
            {
                rows = _conditionSortDesc
                    ? rows.OrderByDescending(r => ConditionValue(TargetOf(r.V), sortCondition))
                    : rows.OrderBy(r => ConditionValue(TargetOf(r.V), sortCondition));
                ordered = true;
            }
        }

        if (!ordered)
        {
            // Default order: best recipe first — the reason to open this view.
            rows = rows.OrderByDescending(r => r.V.Total);
        }

        // A focused variant pins to the front; the stable sort keeps the rest ordered.
        if (_focusFoodName != null && _focusVariantKey != null)
        {
            rows = rows.OrderByDescending(r =>
                FavKey(r.Food.Food.Name, r.V.Variant.IngredientSignature) == _focusVariantKey);
        }

        return rows.ToList();
    }

    private sealed record FlatChipCounts(
        Dictionary<string, int> Stats,
        Dictionary<string, int> Satiations,
        Dictionary<string, int> Preps,
        int PlainPrep,
        Dictionary<string, int> Worlds,
        int Untagged,
        int NewCount,
        Dictionary<string, int> Ingredients,
        int IngredientFullMatch,
        Dictionary<string, int> Components);

    private FlatChipCounts FlatCounts
    {
        get
        {
            var key = FlatStateKey();
            if (_flatCountsCache == null || _flatCountsKey != key)
            {
                _flatCountsCache = ComputeFlatCounts();
                _flatCountsKey = key;
            }

            return _flatCountsCache;
        }
    }

    /// <summary>
    /// All chip counts in one pass. Each family sees every filter except its own row
    /// (grouped CountBase semantics), so sibling chips show what selecting them yields.
    /// </summary>
    private FlatChipCounts ComputeFlatCounts()
    {
        var stats = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        var satiations = new Dictionary<string, int>(StringComparer.Ordinal);
        var preps = new Dictionary<string, int>(StringComparer.Ordinal);
        var worlds = new Dictionary<string, int>(StringComparer.Ordinal);
        var ingredients = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        var componentCounts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        var plainPrep = 0;
        var untagged = 0;
        var newCount = 0;
        var ingredientFullMatch = 0;
        var ingredientsActive = _selectedIngredients.Count > 0;
        var componentsActive = _selectedComponents.Count > 0;
        var componentOnly = _componentGlobalCounts; // built with the vocabulary
        _ = IngredientVocabulary;
        var componentsByFood = ComponentsByFoodId;

        foreach (var r in FlatCountCore())
        {
            var satOk = _selectedSatiation == null || r.Food.Food.SatiationGroups.Contains(_selectedSatiation);
            var prepOk = _selectedPrep == null
                         || (_selectedPrep == PlainPrepKey ? r.Food.Prep == null : r.Food.Prep == _selectedPrep);
            var statOk = _selectedStat == null || r.V.StatTotals.ContainsKey(_selectedStat);
            var worldOk = _selectedWorld == null || WorldMatches(r.V.Variant.Worlds, _selectedWorld);
            var ingScan = ingredientsActive
                ? IngredientFilter.Scan(r.V.Variant.Ingredients, _selectedIngredients)
                : default;
            var ingOk = !ingredientsActive
                        || (_ingredientsOnlyMode
                            ? r.V.Variant.Ingredients.Count > 0 && ingScan.Missing == 0
                            : ingScan.Hits == _selectedIngredients.Count);
            componentsByFood.TryGetValue(r.Food.Food.Id, out var foodComponents);
            var compOk = !componentsActive || (foodComponents != null && foodComponents.IsSupersetOf(_selectedComponents));
            // Every other family sees both halves of the ingredient facet.
            ingOk = ingOk && compOk;

            if (satOk && prepOk && worldOk && ingOk)
            {
                foreach (var stat in r.V.StatTotals.Keys)
                {
                    stats[stat] = stats.GetValueOrDefault(stat) + 1;
                }
            }

            if (prepOk && statOk && worldOk && ingOk)
            {
                foreach (var satiation in r.Food.Food.SatiationGroups)
                {
                    satiations[satiation] = satiations.GetValueOrDefault(satiation) + 1;
                }
            }

            if (satOk && statOk && worldOk && ingOk)
            {
                if (r.Food.Prep == null)
                {
                    plainPrep++;
                }
                else
                {
                    preps[r.Food.Prep] = preps.GetValueOrDefault(r.Food.Prep) + 1;
                }
            }

            if (satOk && prepOk && statOk && ingOk)
            {
                if (r.V.Variant.Worlds.Count == 0)
                {
                    untagged++;
                }
                else
                {
                    foreach (var world in r.V.Variant.Worlds)
                    {
                        worlds[world] = worlds.GetValueOrDefault(world) + 1;
                    }
                }
            }

            if (satOk && prepOk && statOk && worldOk && ingOk && IsNewFood(r.Food))
            {
                newCount++;
            }

            // Ingredient family: all OTHER families applied, its own selection handled
            // per mode with "add-one" semantics — a name's count is what the result
            // becomes if you pick it next. "Contains all" (AND): count names of recipes
            // already passing the selection, i.e. co-occurrence with the picks (a picked
            // name therefore shows the current result count). "Only these": near-miss
            // counting — a fully-covered recipe keeps matching whatever gets added
            // (shared IngredientFullMatch); a recipe missing exactly ONE name is
            // unlocked by adding that name (its per-name count).
            // Component family (add-one, food level): rows passing everything — including the
            // current component picks — counted under each component their food calls for.
            if (satOk && prepOk && statOk && worldOk && ingOk && foodComponents != null)
            {
                foreach (var component in foodComponents)
                {
                    if (componentOnly.ContainsKey(component))
                    {
                        componentCounts[component] = componentCounts.GetValueOrDefault(component) + 1;
                    }
                }
            }

            // Recorded-ingredient family: respects the component picks (compOk), excludes
            // its own selection per mode.
            if (satOk && prepOk && statOk && worldOk && compOk)
            {
                if (!_ingredientsOnlyMode || !ingredientsActive)
                {
                    if (ingOk)
                    {
                        IngredientFilter.CountDistinctNames(r.V.Variant.Ingredients, ingredients);
                    }
                }
                else if (r.V.Variant.Ingredients.Count > 0)
                {
                    if (ingScan.Missing == 0)
                    {
                        ingredientFullMatch++;
                    }
                    else if (ingScan.SoleMissing != null)
                    {
                        ingredients[ingScan.SoleMissing] = ingredients.GetValueOrDefault(ingScan.SoleMissing) + 1;
                    }
                }
            }
        }

        return new FlatChipCounts(stats, satiations, preps, plainPrep, worlds, untagged, newCount,
            ingredients, ingredientFullMatch, componentCounts);
    }

    // ----- Ingredient facet: vocabulary, mutations, picker handlers -----

    /// <summary>
    /// Frequency-ranked ingredient vocabulary of the current flat universe (the data
    /// analysis the picker presents), rebuilt when the flat rows change. Derived from
    /// AllFlatRows() so synthetic rows are included — same universe the filter sees.
    /// </summary>
    private List<KeyValuePair<string, int>> IngredientVocabulary
    {
        get
        {
            if (_ingredientVocabGen != _flatGen)
            {
                var components = ComponentsByFoodId;
                var recipeLists = new List<List<FoodIngredientDto>>();
                var componentCounts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
                foreach (var r in AllFlatRows())
                {
                    recipeLists.Add(r.V.Variant.Ingredients);
                    if (components.TryGetValue(r.Food.Food.Id, out var foodComponents))
                    {
                        foreach (var component in foodComponents)
                        {
                            componentCounts[component] = componentCounts.GetValueOrDefault(component) + 1;
                        }
                    }
                }

                _ingredientVocab = IngredientFilter.BuildVocabulary(recipeLists);
                _ingredientGlobalCounts = _ingredientVocab
                    .ToDictionary(kv => kv.Key, kv => kv.Value, StringComparer.OrdinalIgnoreCase);
                // A name the game DOES record is a normal ingredient chip; components only
                // cover what the recorded data can never show.
                foreach (var recorded in _ingredientGlobalCounts.Keys)
                {
                    componentCounts.Remove(recorded);
                }

                _componentGlobalCounts = componentCounts;
                _ingredientVocabTotal = recipeLists.Count;
                _ingredientVocabGen = _flatGen;
            }

            return _ingredientVocab;
        }
    }

    private void ToggleIngredient(string name)
    {
        if (!_selectedIngredients.Remove(name))
        {
            _selectedIngredients.Add(name);
        }

        if (_selectedIngredients.Count == 0)
        {
            _ingredientsOnlyMode = false; // strict mode over nothing is meaningless
        }

        _ingredientFilterVersion++;
    }

    private void ToggleComponent(string name)
    {
        if (!_selectedComponents.Remove(name))
        {
            _selectedComponents.Add(name);
        }

        _ingredientFilterVersion++;
    }

    private void ToggleWallEntry(string name, bool isComponent)
    {
        if (isComponent)
        {
            ToggleComponent(name);
        }
        else
        {
            ToggleIngredient(name);
        }
    }

    private void ClearIngredients()
    {
        if (_selectedIngredients.Count == 0 && _selectedComponents.Count == 0 && !_ingredientsOnlyMode)
        {
            return;
        }

        _selectedIngredients.Clear();
        _selectedComponents.Clear();
        _ingredientsOnlyMode = false;
        _ingredientFilterVersion++;
    }

    /// <summary>
    /// Recipe components per food: every name in the food's canonical recipe tree —
    /// direct parts, "made from" chain links and nested intermediates (the expansion
    /// the detail panel shows), prep-variants inheriting their base recipe. Depends on
    /// the catalog + recipe index only; keyed to the rows generation for simplicity.
    /// </summary>
    private Dictionary<int, HashSet<string>> ComponentsByFoodId
    {
        get
        {
            if (_componentsGen != _flatGen)
            {
                var map = new Dictionary<int, HashSet<string>>();
                foreach (var row in _rows)
                {
                    var recipeText = !string.IsNullOrEmpty(row.Food.RecipeText)
                        ? row.Food.RecipeText
                        : BaseRecipeSource(row)?.Recipe;
                    var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                    if (!string.IsNullOrEmpty(recipeText))
                    {
                        var seed = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { row.Food.Name };
                        CollectComponentNames(BuildRecipeNodes(recipeText, 0, seed), set);
                    }

                    map[row.Food.Id] = set;
                }

                _componentsByFoodId = map;
                _componentsGen = _flatGen;
            }

            return _componentsByFoodId;
        }
    }

    private static void CollectComponentNames(List<RecipeNode> nodes, HashSet<string> into)
    {
        foreach (var node in nodes)
        {
            AddComponentName(node.Part.Name, into);
            foreach (var link in node.Chain)
            {
                AddComponentName(link.Name, into);
            }

            if (node.Sub != null)
            {
                CollectComponentNames(node.Sub, into);
            }
        }
    }

    /// <summary>Wiki quantity leftovers the part parser doesn't catch ("Any Flour {0.1 kg)", "Salt x").</summary>
    private static readonly Regex ComponentJunkRegex = new(@"(\s*[\{\(][^\)\}]*[\)\}]?|\s+x)\s*$", RegexOptions.Compiled);

    /// <summary>
    /// Wiki "requires" entries that are not ingredients: cooking vessels/tools/stations,
    /// crafting materials pulled in by deeper expansion, locations, quest items, a stray
    /// category word, and water (every kitchen has it; it only adds noise). Tool
    /// alternatives ("X or Y") and dungeon locations are caught by pattern.
    /// </summary>
    private static readonly HashSet<string> ComponentDenylist = new(StringComparer.OrdinalIgnoreCase)
    {
        "Any Container", "Sharp Tool", "Nugget of Any Metal", "Candle", "String", "Board", "Bucket",
        "Log", "Block of Wood", "Creatures", "A Beautiful Dream!", "Water", "Boiling Water"
    };

    private static void AddComponentName(string raw, HashSet<string> into)
    {
        var name = ComponentJunkRegex.Replace(raw, string.Empty).Trim();
        if (name.Length == 0
            || ComponentDenylist.Contains(name)
            || name.Contains(" or ", StringComparison.OrdinalIgnoreCase)
            || name.EndsWith("Dungeon", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        into.Add(name);
    }

    private bool FoodHasComponents(int foodId) =>
        _selectedComponents.Count == 0
        || (ComponentsByFoodId.TryGetValue(foodId, out var set) && set.IsSupersetOf(_selectedComponents));

    private void ToggleIngredientsOnlyMode()
    {
        _ingredientsOnlyMode = !_ingredientsOnlyMode;
        _ingredientFilterVersion++;
    }

    // ----- A–Z ingredient wall -----

    /// <summary>
    /// The wall's alphabetical letter groups: recorded ingredients plus component-only
    /// names (flagged), merged so "Butter" sits under B next to everything else.
    /// Memoized with the vocabulary.
    /// </summary>
    private List<(string Letter, List<(string Name, bool IsComponent)> Entries)> IngredientWallGroups
    {
        get
        {
            var vocab = IngredientVocabulary; // also refreshes _ingredientVocabGen + component counts
            if (_ingredientWallGen != _ingredientVocabGen)
            {
                var entries = new List<(string Name, bool IsComponent)>();
                entries.AddRange(vocab.Select(kv => (kv.Key, false)));
                entries.AddRange(_componentGlobalCounts.Keys.Select(n => (n, true)));
                _ingredientWallGroups = entries
                    .OrderBy(e => e.Name, StringComparer.OrdinalIgnoreCase)
                    .GroupBy(e => char.IsLetter(e.Name[0]) ? char.ToUpperInvariant(e.Name[0]).ToString() : "#")
                    .Select(g => (g.Key, g.ToList()))
                    .ToList();
                _ingredientWallGen = _ingredientVocabGen;
            }

            return _ingredientWallGroups;
        }
    }

    private async Task ToggleIngredientWallAsync()
    {
        _ingredientWallOpen = !_ingredientWallOpen;
        if (_ingredientWallOpen && !FlatRowsCurrent)
        {
            await EnsureFlatRowsAsync();
        }
    }

    /// <summary>
    /// Foods view: food id → number of its recorded recipes (within the selected world
    /// bucket, like WorldVariantCount) passing the ingredient selection — same kernel
    /// and modes as the Ungrouped view. Membership = "at least one recipe fits"; the
    /// count feeds the "N of M recipes" hint. Computed over the shared recipe rows,
    /// memoized per (rows generation, selection); the world is folded into the rows
    /// generation (RebuildRows bumps it).
    /// </summary>
    private Dictionary<int, int> IngredientFoodMatches
    {
        get
        {
            var key = _flatGen + ":" + _ingredientFilterVersion;
            if (_ingredientFoodMatchesKey != key)
            {
                var counts = new Dictionary<int, int>();
                if (_selectedIngredients.Count > 0)
                {
                    foreach (var r in AllFlatRows())
                    {
                        if ((_selectedWorld == null || WorldMatches(r.V.Variant.Worlds, _selectedWorld))
                            && IngredientFilter.Matches(r.V.Variant.Ingredients, _selectedIngredients, _ingredientsOnlyMode))
                        {
                            counts[r.Food.Food.Id] = counts.GetValueOrDefault(r.Food.Food.Id) + 1;
                        }
                    }
                }

                _ingredientFoodMatches = counts;
                _ingredientFoodMatchesKey = key;
            }

            return _ingredientFoodMatches;
        }
    }

    private bool WallNameVisible(string name) =>
        string.IsNullOrWhiteSpace(_ingredientWallFilter)
        || name.Contains(_ingredientWallFilter.Trim(), StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// "Contains all" with picks active: a name that combines with nothing would empty
    /// the result, so its chip is rendered dead. Strict mode never disables — a
    /// zero-unlock name can still enable combinations once more is picked.
    /// </summary>
    private bool AnyIngredientPicks => _selectedIngredients.Count > 0 || _selectedComponents.Count > 0;

    private int ComponentChipCount(string name) => FlatCounts.Components.GetValueOrDefault(name);

    private bool IsDeadPick(string name, bool isComponent)
    {
        if (!AnyIngredientPicks)
        {
            return false;
        }

        if (isComponent)
        {
            return !_selectedComponents.Contains(name) && ComponentChipCount(name) == 0;
        }

        return !_ingredientsOnlyMode
               && !_selectedIngredients.Contains(name)
               && IngredientChipCount(name) == 0;
    }

    /// <summary>Wall chip pill: overall count with no picks; live add-one count with picks ("+N unlock" in strict mode).</summary>
    private string WallChipCountText(string name, bool isComponent)
    {
        if (isComponent)
        {
            return (AnyIngredientPicks ? ComponentChipCount(name) : _componentGlobalCounts.GetValueOrDefault(name)).ToString("N0");
        }

        if (!AnyIngredientPicks)
        {
            return _ingredientGlobalCounts.GetValueOrDefault(name).ToString("N0");
        }

        var live = IngredientChipCount(name);
        return _ingredientsOnlyMode && !_selectedIngredients.Contains(name)
            ? "+" + (live - FlatCounts.IngredientFullMatch).ToString("N0")
            : live.ToString("N0");
    }

    private string WallChipTitle(string name, bool isComponent)
    {
        if (isComponent)
        {
            var globalRows = _componentGlobalCounts.GetValueOrDefault(name);
            var what = $"{name} — recipe component: the wiki recipe calls for it (the game records source ingredients instead, e.g. milk for butter) · {globalRows:N0} recipes overall";
            if (_selectedComponents.Contains(name))
            {
                return $"{what}. Click to remove.";
            }

            return AnyIngredientPicks
                ? $"{what} · {ComponentChipCount(name):N0} with your picks. Click to add."
                : $"{what}. Click to add.";
        }

        var global = _ingredientGlobalCounts.GetValueOrDefault(name);
        var overall = $"in {global:N0} of {_ingredientVocabTotal:N0} recipes overall ({IngredientShareText(global)})";
        if (_selectedIngredients.Contains(name))
        {
            return $"{name} — picked · {overall}. Click to remove.";
        }

        if (!AnyIngredientPicks)
        {
            return $"{name} — {overall}. Click to add.";
        }

        var live = IngredientChipCount(name);
        return _ingredientsOnlyMode
            ? $"{name} — unlocks {live - FlatCounts.IngredientFullMatch:N0} more recipes · {overall}. Click to add."
            : $"{name} — {live:N0} recipes contain all your picks plus this · {overall}. Click to add.";
    }

    private string ComponentTagTitle(string name) =>
        $"Recipe component: {name} — foods whose recipe calls for it · {ComponentChipCount(name):N0} matching recipes. Click to remove.";

    /// <summary>
    /// Live add-one count for a name. "Contains all": recipes passing the current
    /// selection that also contain it (a picked name = the current result count).
    /// "Only these": near-miss semantics — a picked name's own per-name count is
    /// provably 0 (it can't be missing), so it shows IngredientFullMatch = the current
    /// result count; an unpicked name shows the recipes unlocked by adding it.
    /// </summary>
    private int IngredientChipCount(string name) =>
        FlatCounts.Ingredients.GetValueOrDefault(name)
        + (_ingredientsOnlyMode && _selectedIngredients.Count > 0 ? FlatCounts.IngredientFullMatch : 0);

    private string IngredientChipTitle(string name)
    {
        var count = _ingredientGlobalCounts.GetValueOrDefault(name);
        var live = IngredientChipCount(name);
        var liveText = _ingredientsOnlyMode
            ? $"{live:N0} recipes craftable from your picks"
            : $"{live:N0} recipes contain all your picks";
        return $"Ingredient: {name} — {liveText} · in {count:N0} of {_ingredientVocabTotal:N0} recipes overall ({IngredientShareText(count)}). Click to remove.";
    }

    private string IngredientShareText(int count) =>
        _ingredientVocabTotal > 0
            ? (100.0 * count / _ingredientVocabTotal).ToString("0.#") + "%"
            : "0%";

    /// <summary>
    /// The set a chip row's counts are computed over: everything active (search, conditions,
    /// panel, other facet rows) EXCEPT the chip's own row — so sibling chips show what selecting
    /// them would yield instead of zeroing out under their row's current selection.
    /// </summary>
    private IEnumerable<FoodRow> CountBase(bool includeSatiation, bool includePrep, bool includeStat, bool includeWorld = true)
    {
        var rows = BaseFiltered;

        if (_activePanelNames != null)
        {
            rows = rows.Where(r => _activePanelNames.Contains(r.Food.Name));
        }

        if (includeSatiation && _selectedSatiation != null)
        {
            rows = rows.Where(r => r.Food.SatiationGroups.Contains(_selectedSatiation));
        }

        if (includePrep && _selectedPrep != null)
        {
            rows = _selectedPrep == PlainPrepKey
                ? rows.Where(r => r.Prep == null)
                : rows.Where(r => r.Prep == _selectedPrep);
        }

        if (includeStat && _selectedStat != null)
        {
            rows = rows.Where(r => r.StatTotals.ContainsKey(_selectedStat));
        }

        if (includeWorld && _selectedWorld != null)
        {
            rows = rows.Where(MatchesWorld);
        }

        return rows;
    }

    private int StatCount(string stat) => FlatActive
        ? FlatCounts.Stats.GetValueOrDefault(stat)
        : CountBase(includeSatiation: true, includePrep: true, includeStat: false)
            .Count(r => r.StatTotals.ContainsKey(stat));

    private int SatiationCount(string satiation) => FlatActive
        ? FlatCounts.Satiations.GetValueOrDefault(satiation)
        : CountBase(includeSatiation: false, includePrep: true, includeStat: true)
            .Count(r => r.Food.SatiationGroups.Contains(satiation));

    private void ToggleStat(string stat)
    {
        _selectedStat = _selectedStat == stat ? null : stat;
    }

    private void ToggleSatiation(string satiation)
    {
        _selectedSatiation = _selectedSatiation == satiation ? null : satiation;
    }

    private int PrepCount(string prep) => FlatActive
        ? (prep == PlainPrepKey ? FlatCounts.PlainPrep : FlatCounts.Preps.GetValueOrDefault(prep))
        : prep == PlainPrepKey
            ? CountBase(includeSatiation: true, includePrep: false, includeStat: true).Count(r => r.Prep == null)
            : CountBase(includeSatiation: true, includePrep: false, includeStat: true).Count(r => r.Prep == prep);

    private void TogglePrep(string prep)
    {
        _selectedPrep = _selectedPrep == prep ? null : prep;
    }

    private int WorldCount(string world) => FlatActive
        ? (world == UntaggedWorldKey ? FlatCounts.Untagged : FlatCounts.Worlds.GetValueOrDefault(world))
        : CountBase(includeSatiation: true, includePrep: true, includeStat: true, includeWorld: false)
            .Count(r => WorldMatches(r, world));

    private void ToggleWorld(string world) => SetWorld(_selectedWorld == world ? null : world);

    /// <summary>
    /// The one place the world selection changes: rows must be rebuilt (world-effective
    /// values) and the variant-aware server match set recomputed for the new world.
    /// </summary>
    private void SetWorld(string? world)
    {
        if (_selectedWorld == world)
        {
            return;
        }

        _selectedWorld = world;
        RebuildRows();
        QueueServerMatchRefresh();
    }

    /// <summary>Recorded-variation count of a food within the selected world bucket.</summary>
    private int WorldVariantCount(FoodRow r) =>
        _selectedWorld == null ? r.Food.VariantCount
        : _selectedWorld == UntaggedWorldKey ? r.Food.UntaggedVariantCount
        : r.Food.WorldVariantCounts.GetValueOrDefault(_selectedWorld);

    /// <summary>Chip text: known-world name, shortened hash for unknown worlds, or the Untagged label.</summary>
    private static string WorldLabel(string key) =>
        key == UntaggedWorldKey ? key : GameWorlds.DisplayName(key);

    private bool MatchesWorld(FoodRow r) => WorldMatches(r.Food.Worlds, _selectedWorld!);

    private static bool WorldMatches(FoodRow r, string world) => WorldMatches(r.Food.Worlds, world);

    private static bool WorldMatches(List<string> worlds, string world) =>
        world == UntaggedWorldKey ? worlds.Count == 0 : worlds.Contains(world);

    private decimal ScaledFep(decimal baseValue) => baseValue * (decimal)QualityMultiplier;

    private static string StatColor(string attribute, int tier = 1) =>
        FepPalette.Color(attribute, tier);

    private string FepTitle(FoodFepDto fep)
    {
        var name = StatFullNames.TryGetValue(fep.Attribute, out var full) ? full : fep.Attribute;
        return $"{name} +{fep.Tier}: {ScaledFep(fep.Value):0.##}";
    }

    /// <summary>Data attributes consumed by js/fep-tooltip.js (styled hover card).</summary>
    private Dictionary<string, object> FtAttrs(FoodFepDto fep, decimal total, bool clickable = false)
    {
        var attrs = new Dictionary<string, object>
        {
            ["data-ft-stat"] = StatFullNames.GetValueOrDefault(fep.Attribute, fep.Attribute),
            ["data-ft-tier"] = fep.Tier,
            ["data-ft-value"] = ScaledFep(fep.Value).ToString("0.##"),
            ["data-ft-share"] = total > 0 ? (fep.Value / total).ToString("0%") : "—",
            ["data-ft-color"] = StatColor(fep.Attribute, fep.Tier)
        };
        if (clickable)
        {
            attrs["data-ft-hint"] = "Click: filter ≥ this value";
        }
        return attrs;
    }

    private static string LocalIconSrc(FoodDto food) => FoodIcons.LocalSrc(food.ResourceName);

    private static string RemoteIconFallback(FoodDto food) => FoodIcons.RemoteFallback(food.ResourceName);

    private async Task RowClicked(TableRowClickEventArgs<FoodRow> args)
    {
        if (args.Item == null)
        {
            return;
        }

        var id = args.Item.Food.Id;
        if (!_expanded.Add(id))
        {
            _expanded.Remove(id);
            if (_focusFoodName == args.Item.Food.Name)
            {
                ClearFocus();
            }

            return;
        }

        if (args.Item.Food.VariantCount > 1 && !_variations.ContainsKey(id))
        {
            await LoadVariationsAsync(id);
        }
    }

    private async Task LoadVariationsAsync(int foodId)
    {
        List<FoodVariantDto> variants;
        try
        {
            var client = HttpClientFactory.CreateClient("API");
            variants = await client.GetFromJsonAsync<List<FoodVariantDto>>(
                $"/api/v1/cookbook/foods/{foodId}/variations") ?? new List<FoodVariantDto>();
        }
        catch (Exception)
        {
            variants = new List<FoodVariantDto>();
            Snackbar.Add("Failed to load recipe variations", Severity.Error);
        }

        _variations[foodId] = variants.Select(BuildVariantRow).ToList();
    }

    private IEnumerable<VariantRow> FilteredVariants(int foodId, string foodName)
    {
        if (!_variations.TryGetValue(foodId, out var rows))
        {
            return Enumerable.Empty<VariantRow>();
        }

        // When a panel chip focused a variant of this food, the target must be visible:
        // skip the ingredient filter and pin the focused variant to the front (page 1).
        var focusedHere = _focusVariantKey != null
            && rows.Any(r => FavKey(foodName, r.Variant.IngredientSignature) == _focusVariantKey);

        IEnumerable<VariantRow> result = rows;

        var filterTerms = SearchTerms(GetVariantFilter(foodId));
        if (!focusedHere && filterTerms.Count > 0)
        {
            result = result.Where(r => filterTerms.All(t => r.SearchBlob.Contains(t, StringComparison.Ordinal)));
        }

        // Threshold conditions apply per variation too (skipped while a focused
        // panel chip pins a specific variant — the target must stay visible).
        if (!focusedHere && _allConditions.Count > 0)
        {
            result = result.Where(r => MatchesConditions(TargetOf(r)));
        }

        // So does the ingredient selection — the expanded table shows the recipes that fit.
        if (!focusedHere && _selectedIngredients.Count > 0)
        {
            result = result.Where(r =>
                IngredientFilter.Matches(r.Variant.Ingredients, _selectedIngredients, _ingredientsOnlyMode));
        }

        // The world facet applies per variation with the same bucket semantics
        // as the master table (untagged variants show under Untagged / no selection).
        if (!focusedHere && _selectedWorld != null)
        {
            result = result.Where(r => WorldMatches(r.Variant.Worlds, _selectedWorld));
        }

        if (focusedHere)
        {
            result = result.OrderByDescending(r =>
                FavKey(foodName, r.Variant.IngredientSignature) == _focusVariantKey);
        }

        return result;
    }

