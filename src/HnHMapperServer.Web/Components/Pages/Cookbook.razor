@page "/cookbook"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Text.RegularExpressions
@using HnHMapperServer.Core.Cookbook
@using HnHMapperServer.Core.DTOs
@using HnHMapperServer.Web.Components.Shared
@using HnHMapperServer.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using VariantRow = HnHMapperServer.Web.Services.CookbookVariantRow
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject CookbookFlatCache FlatCache
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Cookbook - HnH Mapper</PageTitle>

<div class="admin-panel cookbook-page">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4 page-title">
            <MudIcon Icon="@Icons.Material.Filled.Restaurant" Size="Size.Large" Style="color: #2c3e50;" />
            <MudText Typo="Typo.h4" Style="color: #2c3e50;">Cookbook</MudText>
            <MudSpacer />
            @if (_rows.Count > 0)
            {
                <MudText Typo="Typo.body2" Style="color: #2c3e50;">
                    @if (FlatActive)
                    {
                        @($"{FlatFiltered.Count:N0} of {TotalRecipeCount:N0} recipes")
                    }
                    else
                    {
                        @($"{FilteredCount} of {_rows.Count} foods")
                    }
                </MudText>
            }
        </MudStack>

        <div class="cookbook-toolbar glass-morphism">
            <MudGrid Spacing="2" Class="align-center">
                <MudItem xs="12" md="8">
                    <MudTextField T="string"
                                  @bind-Value="Search"
                                  Immediate="true"
                                  DebounceInterval="200"
                                  Clearable="true"
                                  Placeholder="Search by food or ingredient — pork, mushroom finds rows with both..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField T="int"
                                     @bind-Value="Quality"
                                     Immediate="true"
                                     Min="1" Max="999"
                                     Label="Quality"
                                     HelperText="@($"FEP ×{QualityMultiplier:0.00}")"
                                     Adornment="Adornment.Start"
                                     AdornmentText="Q"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
            <div class="stat-chips">
                <span class="chips-label">View</span>
                <button type="button"
                        class="stat-chip view @(_view == CookbookView.Foods ? "selected" : "")"
                        title="One row per food — recipe variations grouped inside each food"
                        @onclick="() => SetViewAsync(CookbookView.Foods)">
                    Foods<span class="stat-chip-count">@_rows.Count</span>
                </button>
                <button type="button"
                        class="stat-chip view @(_view == CookbookView.Recipes ? "selected" : "")"
                        title="Ungrouped: every recorded recipe as its own row — search, filters and sorting apply per recipe"
                        @onclick="() => SetViewAsync(CookbookView.Recipes)">
                    Ungrouped<span class="stat-chip-count">@TotalRecipeCount.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span>
                </button>
            </div>
            <div class="stat-chips">
                <span class="chips-label">FEP</span>
                @foreach (var stat in StatOrderList)
                {
                    var count = StatCount(stat);
                    <button type="button"
                            class="stat-chip @(_selectedStat == stat ? "selected" : "") @(count == 0 ? "empty" : "")"
                            style="--chip-color: @StatColor(stat);"
                            title="@(StatFullNames[stat]): @count @CountNoun"
                            @onclick="() => ToggleStat(stat)">
                        @stat<span class="stat-chip-count">@count</span>
                    </button>
                }
                <button type="button"
                        class="stat-chip columns-toggle @(_showStatColumns ? "selected" : "")"
                        style="--chip-color: #dfe3e6;"
                        title="Show one sortable, filterable column per stat"
                        @onclick="() => _showStatColumns = !_showStatColumns">
                    ⊞ Columns
                </button>
            </div>
            @if (_allSatiations.Count > 0)
            {
                <div class="stat-chips">
                    <span class="chips-label">Satiation</span>
                    @foreach (var satiation in _allSatiations)
                    {
                        var count = SatiationCount(satiation);
                        <button type="button"
                                class="stat-chip satiation @(_selectedSatiation == satiation ? "selected" : "") @(count == 0 ? "empty" : "")"
                                title="@satiation satiation: @count @CountNoun"
                                @onclick="() => ToggleSatiation(satiation)">
                            @satiation<span class="stat-chip-count">@count</span>
                        </button>
                    }
                </div>
            }
            @if (_allPreps.Count > 0)
            {
                <div class="stat-chips">
                    <span class="chips-label">Prep</span>
                    @foreach (var prep in _allPreps)
                    {
                        var count = PrepCount(prep);
                        <button type="button"
                                class="stat-chip prep @(_selectedPrep == prep ? "selected" : "") @(count == 0 ? "empty" : "")"
                                title="@prep @CountNoun: @count"
                                @onclick="() => TogglePrep(prep)">
                            @prep<span class="stat-chip-count">@count</span>
                        </button>
                    }
                    @{ var plainCount = PrepCount(PlainPrepKey); }
                    <button type="button"
                            class="stat-chip prep plain @(_selectedPrep == PlainPrepKey ? "selected" : "") @(plainCount == 0 ? "empty" : "")"
                            title="@(FlatActive ? "Recipes of foods" : "Foods") without a preparation prefix: @plainCount"
                            @onclick="() => TogglePrep(PlainPrepKey)">
                        @PlainPrepKey<span class="stat-chip-count">@plainCount</span>
                    </button>
                </div>
            }
            @if (_allWorlds.Count > 0)
            {
                <div class="stat-chips">
                    <span class="chips-label">World</span>
                    @foreach (var world in _allWorlds)
                    {
                        var count = WorldCount(world);
                        <button type="button"
                                class="stat-chip world @(_selectedWorld == world ? "selected" : "") @(count == 0 ? "empty" : "")"
                                disabled="@(count == 0 && _selectedWorld != world)"
                                title="@($"{WorldLabel(world)} ({world}): {count} {CountNoun}")"
                                @onclick="() => ToggleWorld(world)">
                            @WorldLabel(world)<span class="stat-chip-count">@count</span>
                        </button>
                    }
                    @{ var untaggedCount = WorldCount(UntaggedWorldKey); }
                    <button type="button"
                            class="stat-chip world untagged @(_selectedWorld == UntaggedWorldKey ? "selected" : "") @(untaggedCount == 0 ? "empty" : "")"
                            disabled="@(untaggedCount == 0 && _selectedWorld != UntaggedWorldKey)"
                            title="@(FlatActive ? "Recipes" : "Foods") without world data (imports and pre-tagging uploads): @untaggedCount"
                            @onclick="() => ToggleWorld(UntaggedWorldKey)">
                        @UntaggedWorldKey<span class="stat-chip-count">@untaggedCount</span>
                    </button>
                </div>
            }
            @if (_rows.Count > 0)
            {
                @* Larder facet (both views). The A–Z wall is the analysis made browsable: every
                   recorded ingredient with its live count; picking one adds a removable tag to
                   the Filters row, like every other facet. In the Foods view a food passes when
                   ANY of its recipes does. The wall is built from the shared recipe rows —
                   opening it loads them on demand. *@
                <div class="stat-chips ingredient-row">
                    <span class="chips-label">Ingredients</span>
                    <button type="button"
                            class="stat-chip wall-toggle @(_ingredientWallOpen ? "selected" : "")"
                            title="Browse every recorded ingredient A–Z and click to pick — recipes must contain every pick"
                            @onclick="ToggleIngredientWallAsync">
                        @(_ingredientWallOpen ? "Hide ingredients" : "Browse ingredients")<span class="stat-chip-count">@(FlatRowsCurrent ? IngredientVocabulary.Count.ToString() : "…")</span>
                    </button>
                    @if (_selectedIngredients.Count > 0)
                    {
                        <button type="button"
                                class="stat-chip only-toggle @(_ingredientsOnlyMode ? "selected" : "")"
                                title="Larder mode: only recipes whose ENTIRE ingredient list is covered by your picks (recipes without recorded ingredients are hidden). Off: recipes must contain every pick, extras allowed."
                                @onclick="ToggleIngredientsOnlyMode">
                            Only these
                        </button>
                    }
                </div>
                @if (_ingredientWallOpen && !FlatRowsCurrent)
                {
                    <div class="ingredient-wall">
                        @if (_flatLoadFailed)
                        {
                            <MudAlert Severity="Severity.Error">
                                Failed to load the recipe data behind the ingredient list.
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="RetryFlatAsync">Retry</MudButton>
                            </MudAlert>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="detail-muted">Loading the recipe data behind the ingredient list&hellip;</MudText>
                        }
                    </div>
                }
                else if (_ingredientWallOpen)
                {
                    <div class="ingredient-wall">
                        <MudTextField T="string"
                                      @bind-Value="_ingredientWallFilter"
                                      Immediate="true"
                                      DebounceInterval="120"
                                      Clearable="true"
                                      Placeholder="Find ingredient..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="wall-filter" />
                        <div class="wall-legend">
                            Solid chips are ingredients players' clients recorded. Dashed chips are <strong>recipe
                            components</strong> the wiki recipe calls for that the game never records as ingredients —
                            it logs source ingredients instead (butter shows up as the milk it was churned from;
                            fixed parts like leeks or trout don't show at all).
                        </div>
                        <div class="wall-groups">
                            @foreach (var (letter, entries) in IngredientWallGroups)
                            {
                                var visible = entries.Where(e => WallNameVisible(e.Name)).ToList();
                                if (visible.Count == 0)
                                {
                                    continue;
                                }
                                <div class="wall-group">
                                    <span class="wall-letter">@letter</span>
                                    @foreach (var entry in visible)
                                    {
                                        var picked = entry.IsComponent
                                            ? _selectedComponents.Contains(entry.Name)
                                            : _selectedIngredients.Contains(entry.Name);
                                        var dead = IsDeadPick(entry.Name, entry.IsComponent);
                                        <button type="button"
                                                class="stat-chip wall-chip @(entry.IsComponent ? "component" : "") @(picked ? "selected" : "") @(dead ? "empty" : "")"
                                                disabled="@dead"
                                                title="@WallChipTitle(entry.Name, entry.IsComponent)"
                                                @onclick="() => ToggleWallEntry(entry.Name, entry.IsComponent)">
                                            @entry.Name<span class="stat-chip-count">@WallChipCountText(entry.Name, entry.IsComponent)</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            @if (_rows.Any(IsNewFood))
            {
                <div class="stat-chips">
                    <span class="chips-label">Added</span>
                    <button type="button"
                            class="stat-chip newfoods @(_showNewOnly ? "selected" : "")"
                            title="@(FlatActive ? "Recipes of foods" : "Foods") discovered by players in the last 7 days — click to filter, newest first"
                            @onclick="() => _showNewOnly = !_showNewOnly">
                        New (7d)<span class="stat-chip-count">@NewChipCount</span>
                    </button>
                </div>
            }
            <div class="stat-chips filter-input-row">
                <span class="chips-label">Filter</span>
                <MudTextField T="string"
                              @ref="_filterFieldRef"
                              @bind-Value="FilterText"
                              Immediate="true"
                              DebounceInterval="200"
                              Clearable="true"
                              Placeholder="str>50%, int2>15..."
                              HelperText="@(_filterResidual.Length > 0 ? $"Ignored: {_filterResidual}" : "e.g. str>50% · int2>15 · hunger<2 · eff>=3")"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.FilterAlt"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="filter-input" />
            </div>
            <div class="stat-chips">
                <span class="chips-label"></span>
                @foreach (var stat in StatOrderList)
                {
                    <button type="button"
                            class="stat-chip"
                            style="--chip-color: @StatColor(stat);"
                            title="@StatFullNames[stat] — adds @(stat.ToLowerInvariant())>= to the filter"
                            @onclick="() => AppendKeyToFilterAsync(stat.ToLowerInvariant())">
                        @stat
                    </button>
                }
                <span class="helper-gap"></span>
                @foreach (var (key, label, tooltip) in FilterKeyHelpers)
                {
                    <button type="button"
                            class="stat-chip"
                            style="--chip-color: #dfe3e6;"
                            title="@tooltip — adds @(key)>= to the filter"
                            @onclick="() => AppendKeyToFilterAsync(key)">
                        @label
                    </button>
                }
                <span class="helper-gap"></span>
                @foreach (var pct in QuarterPresets)
                {
                    <button type="button"
                            class="stat-chip @(QuarterUsable ? "" : "empty")"
                            style="--chip-color: #dfe3e6;"
                            title="@QuarterTitle(pct)"
                            @onclick="() => ApplyQuarterAsync(pct)">
                        ≥@(pct)%
                    </button>
                }
            </div>
            @if (ActiveFilterChipCount > 0)
            {
                <div class="active-filters">
                    <span class="chips-label">Filters</span>
                    @if (_selectedStat != null)
                    {
                        <span class="stat-chip filter-chip"
                              style="--chip-color: @StatColor(_selectedStat);"
                              title="Selected FEP: @StatFullNames[_selectedStat] — click to clear"
                              @onclick="() => _selectedStat = null">
                            @_selectedStat<span class="stat-chip-count">&times;</span>
                        </span>
                    }
                    @if (_selectedSatiation != null)
                    {
                        <span class="stat-chip filter-chip"
                              style="--chip-color: #bfe3c0;"
                              title="Selected satiation: @_selectedSatiation — click to clear"
                              @onclick="() => _selectedSatiation = null">
                            @_selectedSatiation<span class="stat-chip-count">&times;</span>
                        </span>
                    }
                    @if (_selectedPrep != null)
                    {
                        <span class="stat-chip filter-chip"
                              style="--chip-color: @(_selectedPrep == PlainPrepKey ? "#dfe3e6" : "#ecc9a3");"
                              title="Selected preparation: @_selectedPrep — click to clear"
                              @onclick="() => _selectedPrep = null">
                            @_selectedPrep<span class="stat-chip-count">&times;</span>
                        </span>
                    }
                    @if (_selectedWorld != null)
                    {
                        <span class="stat-chip filter-chip"
                              style="--chip-color: @(_selectedWorld == UntaggedWorldKey ? "#dfe3e6" : "#cfd9ec");"
                              title="Selected world: @WorldLabel(_selectedWorld) — click to clear"
                              @onclick="() => SetWorld(null)">
                            @WorldLabel(_selectedWorld)<span class="stat-chip-count">&times;</span>
                        </span>
                    }
                    @if (_showNewOnly)
                    {
                        <span class="stat-chip filter-chip"
                              style="--chip-color: #cde9cf;"
                              title="Recently discovered foods (last 7 days) — click to clear"
                              @onclick="() => _showNewOnly = false">
                            New (7d)<span class="stat-chip-count">&times;</span>
                        </span>
                    }
                    @foreach (var selectedIngredient in _selectedIngredients.OrderBy(n => n, StringComparer.OrdinalIgnoreCase))
                    {
                        <span class="stat-chip filter-chip"
                              style="--chip-color: #e8ddc9;"
                              title="@IngredientChipTitle(selectedIngredient)"
                              @onclick="() => ToggleIngredient(selectedIngredient)">
                            @selectedIngredient<span class="stat-chip-count">&times;</span>
                        </span>
                    }
                    @foreach (var selectedComponent in _selectedComponents.OrderBy(n => n, StringComparer.OrdinalIgnoreCase))
                    {
                        <span class="stat-chip filter-chip component"
                              style="--chip-color: #f1e9da;"
                              title="@ComponentTagTitle(selectedComponent)"
                              @onclick="() => ToggleComponent(selectedComponent)">
                            @selectedComponent<span class="stat-chip-count">&times;</span>
                        </span>
                    }
                    @foreach (var condition in _allConditions)
                    {
                        var isSorted = _conditionSortKey == SortKeyOf(condition);
                        <span class="stat-chip filter-chip @(isSorted ? "selected" : "")"
                              style="--chip-color: @(condition.Attribute is string attr ? StatColor(attr, condition.Tier ?? 1) : "#dfe3e6");"
                              title="Sort by this filter — ✕ removes it"
                              @onclick="() => ToggleConditionSort(condition)">
                            @ConditionLabel(condition)@(isSorted ? (_conditionSortDesc ? " ▼" : " ▲") : "")
                            <button type="button" class="stat-chip-count chip-x"
                                    title="Remove @condition.RawText"
                                    @onclick="() => RemoveCondition(condition)"
                                    @onclick:stopPropagation="true">&times;</button>
                        </span>
                    }
                    @if (ActiveFilterChipCount > 1)
                    {
                        <button type="button"
                                class="stat-chip filter-chip clear-conditions"
                                style="--chip-color: #dfe3e6;"
                                title="Clear all active filters (keeps the text search)"
                                @onclick="ClearActiveFilters">
                            Clear<span class="stat-chip-count">&times;</span>
                        </button>
                    }
                </div>
            }
        </div>

        <div class="panels-bar glass-morphism">
            <button type="button" class="panels-toggle" @onclick="() => _panelsExpanded = !_panelsExpanded">
                <MudIcon Icon="@(_panelsExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                <span>Panels (@_panels.Count)</span>
            </button>
            @if (_activePanelId != null)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                         OnClose="ClearPanelFilter">@(_panels.FirstOrDefault(p => p.Id == _activePanelId)?.Name)</MudChip>
            }
            @if (_focusFoodName != null)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined"
                         Icon="@Icons.Material.Filled.CenterFocusStrong"
                         OnClose="ClearFocus">@_focusFoodName</MudChip>
            }
            @if (_highlightIds.Count > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                         Icon="@Icons.Material.Filled.Restaurant"
                         OnClose="ClearHighlight">New foods (@_highlightIds.Count)</MudChip>
            }
            <div class="panels-bar-spacer"></div>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Text"
                       OnClick="@(() => OpenCreatePanelDialogAsync(null, string.Empty))">New panel</MudButton>
        </div>
        @if (_panelsExpanded)
        {
            <div class="panels-strip">
                @{ var firstSharedIndex = _panels.FindIndex(p => !p.IsOwn); }
                @foreach (var (panel, panelIndex) in _panels.Select((p, i) => (p, i)))
                {
                    @if (panelIndex == firstSharedIndex && firstSharedIndex > 0)
                    {
                        <div class="panels-divider"><span>Shared with you</span></div>
                    }
                    <div @key="panel.Id"
                         class="panel-card @(panel.IsOwn ? "own" : "shared-other") @(panel.IsShared ? "is-shared" : "") @(_dragActive && panel.IsOwn ? "droppable" : "") @(_dragOverPanelId == panel.Id ? "drag-over" : "") @(_activePanelId == panel.Id ? "active" : "")"
                         style="--panel-accent: hsl(@PanelHueAt(panelIndex), 62%, 55%);"
                         @ondragover:preventDefault
                         @ondragenter="() => OnPanelDragEnter(panel)"
                         @ondrop="() => HandleDropOnPanelAsync(panel)">
                        <div class="panel-card-header">
                            @if (panel.IsFavorites)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Style="color: var(--ck-gold-icon);" />
                            }
                            <button type="button" class="panel-name-btn"
                                    title="Show only this panel's foods in the table"
                                    @onclick="() => TogglePanelFilter(panel)">@PanelTitle(panel)</button>
                            <span class="panel-count">@panel.Items.Count</span>
                            @if (panel.IsShared && panel.IsOwn)
                            {
                                <span class="panel-badge">Shared</span>
                            }
                            @if (panel.IsOwn)
                            {
                                <span title="@(panel.IsShared ? "Shared with your tenant — click to make private" : "Share this panel with your tenant")">
                                    <MudIconButton Icon="@(panel.IsShared ? Icons.Material.Filled.Public : Icons.Material.Filled.PublicOff)"
                                                   Size="Size.Small"
                                                   Class="@(panel.IsShared ? "share-btn shared" : "share-btn")"
                                                   OnClick="() => ToggleShareAsync(panel)" />
                                </span>
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="() => OpenRenameDialogAsync(panel)">Rename</MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="() => DeletePanelAsync(panel)">Delete</MudMenuItem>
                                </MudMenu>
                            }
                        </div>
                        <div class="panel-items">
                            @foreach (var item in panel.Items)
                            {
                                var known = _rowsByName.TryGetValue(item.FoodName, out var itemRow);
                                var isVariant = item.IngredientSignature.Length > 0;
                                <div @key="item.ItemId"
                                     class="panel-item @(item.Resolved ? "" : "unknown")"
                                     draggable="@(panel.IsOwn ? "true" : "false")"
                                     title="@ChipTooltip(item, known)"
                                     @onclick="() => FocusItemAsync(item)"
                                     @ondragstart="() => StartChipDrag(panel, item)"
                                     @ondragend="ClearDrag"
                                     @ondragover:preventDefault
                                     @ondrop="() => HandleDropOnChipAsync(panel, item)"
                                     @ondrop:stopPropagation="true">
                                    <div class="item-line1">
                                        @if (known)
                                        {
                                            <img class="chip-icon" src="@LocalIconSrc(itemRow!.Food)" onerror="@RemoteIconFallback(itemRow!.Food)" alt="" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Class="item-missing-icon" />
                                        }
                                        <span class="item-name">@item.FoodName</span>
                                        <span class="item-right">
                                            @if (item.Resolved && ItemTotal(item) > 0)
                                            {
                                                <span class="item-total" title="Total FEP">@ScaledFep(ItemTotal(item)).ToString("0.#")</span>
                                            }
                                            @if (panel.IsOwn)
                                            {
                                                <button type="button" class="chip-x" title="Remove"
                                                        @onclick="() => RemoveItemAsync(panel, item)"
                                                        @onclick:stopPropagation="true">×</button>
                                            }
                                        </span>
                                    </div>
                                    <div class="item-line2">
                                        @if (item.Resolved)
                                        {
                                            @if (ItemTotal(item) > 0)
                                            {
                                                <div class="item-bar">
                                                    @foreach (var fep in item.Feps)
                                                    {
                                                        <div class="item-bar-seg"
                                                             style="width: @RatioWidth(fep.Value, ItemTotal(item)); background: @StatColor(fep.Attribute, fep.Tier);"
                                                             @attributes="FtAttrs(fep, ItemTotal(item))"></div>
                                                    }
                                                </div>
                                                <span class="item-eff" title="FEP per hunger">
                                                    @(item.Hunger > 0 ? ScaledFep(ItemTotal(item) / item.Hunger).ToString("0.0#") + "/h" : "—")
                                                </span>
                                            }
                                            @if (isVariant)
                                            {
                                                <span class="item-sub">@ShortVariantLabel(item)</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="item-sub">not in the catalog right now</span>
                                        }
                                    </div>
                                </div>
                            }
                            @if (panel.Items.Count == 0)
                            {
                                <span class="detail-muted">@(panel.IsOwn ? "Empty — drag foods here" : "Empty")</span>
                            }
                        </div>
                    </div>
                }
                @if (_panels.Count == 0)
                {
                    <div class="panel-card ghost">
                        <MudIcon Icon="@Icons.Material.Filled.StarBorder" Size="Size.Small" />
                        <span>Star a food or create a panel — fill it with <MudIcon Icon="@Icons.Material.Filled.PlaylistAdd" Size="Size.Small" Style="vertical-align: text-bottom;" /> or by dragging, then share it with your tenant.</span>
                    </div>
                }
            </div>
        }

        <MudPaper Class="glass-morphism pa-2" Elevation="0">
            @if (_loading)
            {
                <div class="pa-4">
                    @for (var i = 0; i < 8; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="42px" Class="mb-2" />
                    }
                </div>
            }
            else if (_loadFailed)
            {
                <MudAlert Severity="Severity.Error" Class="ma-2">
                    Failed to load the cookbook.
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="LoadCatalogAsync">Retry</MudButton>
                </MudAlert>
            }
            else if (_rows.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Class="ma-2">
                    The cookbook is empty. A superadmin needs to import food data
                    (Admin Panel &rarr; Cookbook).
                </MudAlert>
            }
            else if (_view == CookbookView.Recipes)
            {
                if (!FlatRowsCurrent)
                {
                    if (_flatLoadFailed)
                    {
                        <MudAlert Severity="Severity.Error" Class="ma-2">
                            Failed to load the recipe list.
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="RetryFlatAsync">Retry</MudButton>
                        </MudAlert>
                    }
                    else
                    {
                        <div class="pa-4">
                            <MudText Typo="Typo.body2" Class="mb-2 detail-muted">
                                Loading all @TotalRecipeCount.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) recipes&hellip;
                            </MudText>
                            @for (var i = 0; i < 8; i++)
                            {
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="42px" Class="mb-2" />
                            }
                        </div>
                    }
                }
                else
                {
                    <MudTable T="FlatRow"
                              @ref="_flatTable"
                              Items="@FlatFiltered"
                              Dense="true"
                              Hover="true"
                              Elevation="0"
                              RowsPerPage="50"
                              RowClassFunc="@FlatRowClass"
                              Breakpoint="Breakpoint.Sm"
                              Class="flat-table">
                        <HeaderContent>
                            <MudTh Style="width: 110px;"></MudTh>
                            <MudTh Style="width: 44px;"></MudTh>
                            <MudTh>
                                <MudTableSortLabel T="FlatRow" SortBy="@(r => r.Food.BaseName + " " + (r.Food.Prep ?? " "))">Food</MudTableSortLabel>
                            </MudTh>
                            <MudTh>
                                <MudTableSortLabel T="FlatRow" SortBy="@(r => r.V.RecipeText)">Recipe</MudTableSortLabel>
                            </MudTh>
                            <MudTh Style="text-align: right;">
                                <MudTableSortLabel T="FlatRow" SortBy="@(r => (double)r.V.EffectiveEnergy)">Energy</MudTableSortLabel>
                            </MudTh>
                            <MudTh Style="text-align: right;">
                                <MudTableSortLabel T="FlatRow" SortBy="@(r => (double)r.V.EffectiveHunger)">Hunger</MudTableSortLabel>
                            </MudTh>
                            @if (_showStatColumns)
                            {
                                foreach (var stat in StatOrderList)
                                {
                                    <MudTh Style="text-align: right;">
                                        <MudTableSortLabel T="FlatRow" SortBy="@(r => (double)r.V.StatTotals.GetValueOrDefault(stat))">@stat</MudTableSortLabel>
                                    </MudTh>
                                }
                            }
                            else
                            {
                                <MudTh>FEPs</MudTh>
                                if (_selectedStat != null)
                                {
                                    <MudTh Style="text-align: right;">
                                        <MudTableSortLabel T="FlatRow" SortBy="@(r => (double)r.V.StatTotals.GetValueOrDefault(_selectedStat!))">@_selectedStat FEP</MudTableSortLabel>
                                    </MudTh>
                                }
                            }
                            <MudTh Style="text-align: right;">
                                <MudTableSortLabel T="FlatRow" SortBy="@(r => (double)r.V.Total)">Total</MudTableSortLabel>
                            </MudTh>
                            <MudTh Style="text-align: right;">
                                <MudTableSortLabel T="FlatRow" SortBy="@(r => (double)r.V.PerHunger)">FEP/Hunger</MudTableSortLabel>
                            </MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd Class="py-0 variant-actions">
                                <MudIconButton Icon="@(IsFavorite(context.Food.Food.Name, context.V.Variant.IngredientSignature) ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)"
                                               Size="Size.Small"
                                               Class="@(IsFavorite(context.Food.Food.Name, context.V.Variant.IngredientSignature) ? "star-on" : "star-off")"
                                               OnClick="() => ToggleFavoriteAsync(context.Food.Food.Name, context.V.Variant.IngredientSignature)" />
                                <span class="drag-grip" draggable="true"
                                      title="Drag this recipe onto a panel"
                                      @ondragstart="() => StartVariantDrag(context.Food.Food.Name, context.V.Variant.IngredientSignature)"
                                      @ondragend="ClearDrag">
                                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                                </span>
                                @AddToPanelMenu((context.Food.Food.Name, context.V.Variant.IngredientSignature))
                                <MudIconButton Icon="@Icons.Material.Filled.ReadMore"
                                               Size="Size.Small"
                                               title="Food details (recipe, preparations, all variations)"
                                               OnClick="() => ShowFoodDetailsAsync(context)" />
                            </MudTd>
                            <MudTd Class="py-1">
                                <img class="food-icon"
                                     src="@LocalIconSrc(context.Food.Food)"
                                     onerror="@RemoteIconFallback(context.Food.Food)"
                                     loading="lazy" alt="" />
                            </MudTd>
                            <MudTd>
                                <span class="food-name">@context.Food.BaseName</span>
                                @if (context.Food.Prep != null)
                                {
                                    <span class="prep-badge">@context.Food.Prep</span>
                                }
                                @if (IsNewFood(context.Food))
                                {
                                    <span class="new-badge"
                                          title="Discovered by @context.Food.Food.ContributedByName on @context.Food.Food.ImportedAt.ToString("yyyy-MM-dd")">New</span>
                                }
                            </MudTd>
                            <MudTd>
                                @if (context.V.RecipeText.Length > 0)
                                {
                                    @context.V.RecipeText
                                }
                                else
                                {
                                    <span class="detail-muted" title="No recorded ingredient combination — headline values">—</span>
                                }
                                @if (context.V.Variant.TimesSeen > 1)
                                {
                                    <span class="variant-seen">&times;@context.V.Variant.TimesSeen</span>
                                }
                                @if (context.V.Variant.ContributorNames.Count > 0)
                                {
                                    <span class="contrib-name"
                                          title="Uploaded by @string.Join(", ", context.V.Variant.ContributorNames)">
                                        <MudIcon Icon="@Icons.Material.Filled.PersonAddAlt1" Size="Size.Small" />@context.V.Variant.ContributorNames[0]@(context.V.Variant.ContributorNames.Count > 1 ? $" +{context.V.Variant.ContributorNames.Count - 1}" : "")
                                    </span>
                                }
                                @if (context.V.Variant.Worlds.Count > 0)
                                {
                                    <span class="world-tag"
                                          title="Seen in: @string.Join(", ", context.V.Variant.Worlds.Select(w => $"{WorldLabel(w)} ({w})"))">
                                        <MudIcon Icon="@Icons.Material.Filled.Public" Size="Size.Small" />@WorldLabel(context.V.Variant.Worlds[0])@(context.V.Variant.Worlds.Count > 1 ? $" +{context.V.Variant.Worlds.Count - 1}" : "")
                                    </span>
                                }
                            </MudTd>
                            <MudTd Style="text-align: right;">@context.V.EffectiveEnergy</MudTd>
                            <MudTd Style="text-align: right;">@context.V.EffectiveHunger.ToString("0.##")</MudTd>
                            @if (_showStatColumns)
                            {
                                foreach (var stat in StatOrderList)
                                {
                                    var statTotal = context.V.StatTotals.GetValueOrDefault(stat);
                                    <MudTd Style="text-align: right;">
                                        @if (statTotal > 0)
                                        {
                                            <span class="stat-value" style="--chip-color: @StatColor(stat);">
                                                @ScaledFep(statTotal).ToString("0.##")
                                            </span>
                                        }
                                    </MudTd>
                                }
                            }
                            else
                            {
                                <MudTd>
                                    <div class="fep-pills">
                                        @foreach (var fep in context.V.EffectiveFeps)
                                        {
                                            <span class="fep-pill clickable"
                                                  style="background: @StatColor(fep.Attribute, fep.Tier);"
                                                  @attributes="FtAttrs(fep, context.V.Total, clickable: true)"
                                                  @onclick="() => FilterByPill(fep)"
                                                  @onclick:stopPropagation="true">
                                                @fep.Attribute@(fep.Tier == 2 ? "+2" : "") @ScaledFep(fep.Value).ToString("0.##")
                                            </span>
                                        }
                                    </div>
                                </MudTd>
                                if (_selectedStat != null)
                                {
                                    <MudTd Style="text-align: right;">
                                        <span class="stat-value" style="--chip-color: @StatColor(_selectedStat!);">
                                            @ScaledFep(context.V.StatTotals.GetValueOrDefault(_selectedStat!)).ToString("0.##")
                                        </span>
                                    </MudTd>
                                }
                            }
                            <MudTd Style="text-align: right;">
                                <button type="button" class="cell-filter-btn" title="Filter: total ≥ this"
                                        @onclick="() => FilterByTotalValue(context.V.Total)"
                                        @onclick:stopPropagation="true">
                                    <strong>@ScaledFep(context.V.Total).ToString("0.#")</strong>
                                </button>
                            </MudTd>
                            <MudTd Style="text-align: right;">
                                @if (context.V.EffectiveHunger > 0)
                                {
                                    <button type="button" class="cell-filter-btn" title="Filter: FEP/hunger ≥ this"
                                            @onclick="() => FilterByEffValue(context.V.PerHunger)"
                                            @onclick:stopPropagation="true">
                                        @ScaledFep(context.V.PerHunger).ToString("0.0#")
                                    </button>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="no-results">
                                <MudText Typo="Typo.body1">No recipes match your search.</MudText>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearFilters">Clear filters</MudButton>
                            </div>
                        </NoRecordsContent>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
                        </PagerContent>
                    </MudTable>
                }
            }
            else
            {
                <MudTable T="FoodRow"
                          @ref="_masterTable"
                          Items="@Filtered"
                          Dense="true"
                          Hover="true"
                          Elevation="0"
                          RowsPerPage="50"
                          OnRowClick="RowClicked"
                          RowClassFunc="@MasterRowClass"
                          Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh Style="width: 36px;"></MudTh>
                        <MudTh Style="width: 62px;"></MudTh>
                        <MudTh Style="width: 44px;"></MudTh>
                        <MudTh>
                            <MudTableSortLabel T="FoodRow" SortBy="@(r => r.BaseName + " " + (r.Prep ?? " "))">Food</MudTableSortLabel>
                        </MudTh>
                        <MudTh>Satiations</MudTh>
                        <MudTh Style="text-align: right;">
                            <MudTableSortLabel T="FoodRow" SortBy="@(r => (double)r.EffectiveEnergy)">Energy</MudTableSortLabel>
                        </MudTh>
                        <MudTh Style="text-align: right;">
                            <MudTableSortLabel T="FoodRow" SortBy="@(r => (double)r.EffectiveHunger)">Hunger</MudTableSortLabel>
                        </MudTh>
                        @if (_showStatColumns)
                        {
                            foreach (var stat in StatOrderList)
                            {
                                <MudTh Style="text-align: right;">
                                    <MudTableSortLabel T="FoodRow" SortBy="@(r => (double)r.StatTotals.GetValueOrDefault(stat))">@stat</MudTableSortLabel>
                                </MudTh>
                            }
                        }
                        else
                        {
                            <MudTh>FEPs</MudTh>
                            if (_selectedStat != null)
                            {
                                <MudTh Style="text-align: right;">
                                    <MudTableSortLabel T="FoodRow" SortBy="@(r => (double)r.StatTotals.GetValueOrDefault(_selectedStat!))">@_selectedStat FEP</MudTableSortLabel>
                                </MudTh>
                            }
                        }
                        <MudTh Style="text-align: right;">
                            <MudTableSortLabel T="FoodRow" SortBy="@(r => (double)r.TotalFep)">Total</MudTableSortLabel>
                        </MudTh>
                        <MudTh Style="text-align: right;">
                            <MudTableSortLabel T="FoodRow" SortBy="@(r => (double)r.FepPerHunger)">FEP/Hunger</MudTableSortLabel>
                        </MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Class="py-1 star-cell">
                            <span @onclick:stopPropagation="true">
                                <MudIconButton Icon="@(IsFavorite(context.Food.Name, "") ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)"
                                               Size="Size.Small"
                                               Class="@(IsFavorite(context.Food.Name, "") ? "star-on" : "star-off")"
                                               OnClick="@(() => ToggleFavoriteAsync(context.Food.Name, ""))" />
                            </span>
                        </MudTd>
                        <MudTd Class="py-1 drag-cell">
                            <span class="drag-grip" draggable="true"
                                  title="Drag onto a panel"
                                  @ondragstart="() => StartFoodDrag(context.Food.Name)"
                                  @ondragend="ClearDrag"
                                  @onclick:stopPropagation="true">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                            </span>
                            @AddToPanelMenu((context.Food.Name, ""))
                        </MudTd>
                        <MudTd Class="py-1">
                            <img class="food-icon"
                                 src="@LocalIconSrc(context.Food)"
                                 onerror="@RemoteIconFallback(context.Food)"
                                 loading="lazy" alt="" />
                        </MudTd>
                        <MudTd>
                            <div class="drag-handle" draggable="true"
                                 @ondragstart="() => StartFoodDrag(context.Food.Name)"
                                 @ondragend="ClearDrag">
                                <span class="food-name">@context.BaseName</span>
                                @if (context.Prep != null)
                                {
                                    <span class="prep-badge">@context.Prep</span>
                                }
                                @if (IsNewFood(context))
                                {
                                    <span class="new-badge"
                                          title="Discovered by @context.Food.ContributedByName on @context.Food.ImportedAt.ToString("yyyy-MM-dd")">New</span>
                                }
                                @{ var shownVariantCount = WorldVariantCount(context); }
                                @if (shownVariantCount > 1)
                                {
                                    var conditionMatch = _allConditions.Count > 0 && _serverMatches != null
                                        ? _serverMatches.GetValueOrDefault(context.Food.Id)
                                        : null;
                                    if (conditionMatch != null)
                                    {
                                        <span class="variant-hint"
                                              title="Recipe variations matching the active filters">
                                            @conditionMatch.MatchingVariants of @shownVariantCount recipes
                                        </span>
                                    }
                                    else if (_selectedIngredients.Count > 0 && FlatRowsCurrent)
                                    {
                                        <span class="variant-hint"
                                              title="Recipe variations fitting the picked ingredients">
                                            @IngredientFoodMatches.GetValueOrDefault(context.Food.Id) of @shownVariantCount recipes
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="variant-hint">@shownVariantCount recipes</span>
                                    }
                                }
                                @if (context.Food.ContributedByName != null)
                                {
                                    <span class="contrib-name" title="Discovered by @context.Food.ContributedByName on @context.Food.ImportedAt.ToString("yyyy-MM-dd")">
                                        <MudIcon Icon="@Icons.Material.Filled.PersonAddAlt1" Size="Size.Small" />@context.Food.ContributedByName
                                    </span>
                                }
                            </div>
                        </MudTd>
                        <MudTd>
                            @if (context.Food.SatiationGroups.Count > 0)
                            {
                                <div class="category-chips">
                                    @foreach (var satiation in context.Food.SatiationGroups)
                                    {
                                        <span class="category-chip satiation-chip">@satiation</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="detail-muted">—</span>
                            }
                        </MudTd>
                        <MudTd Style="text-align: right;">@context.EffectiveEnergy</MudTd>
                        <MudTd Style="text-align: right;">@context.EffectiveHunger.ToString("0.##")</MudTd>
                        @if (_showStatColumns)
                        {
                            foreach (var stat in StatOrderList)
                            {
                                var statTotal = context.StatTotals.GetValueOrDefault(stat);
                                <MudTd Style="text-align: right;">
                                    @if (statTotal > 0)
                                    {
                                        <span class="stat-value" style="--chip-color: @StatColor(stat);">
                                            @ScaledFep(statTotal).ToString("0.##")
                                        </span>
                                    }
                                </MudTd>
                            }
                        }
                        else
                        {
                            <MudTd>
                                <div class="fep-pills">
                                    @foreach (var fep in context.EffectiveFeps)
                                    {
                                        <span class="fep-pill clickable"
                                              style="background: @StatColor(fep.Attribute, fep.Tier);"
                                              @attributes="FtAttrs(fep, context.TotalFep, clickable: true)"
                                              @onclick="() => FilterByPill(fep)"
                                              @onclick:stopPropagation="true">
                                            @fep.Attribute@(fep.Tier == 2 ? "+2" : "") @ScaledFep(fep.Value).ToString("0.##")
                                        </span>
                                    }
                                </div>
                            </MudTd>
                            if (_selectedStat != null)
                            {
                                <MudTd Style="text-align: right;">
                                    <span class="stat-value" style="--chip-color: @StatColor(_selectedStat!);">
                                        @ScaledFep(context.StatTotals.GetValueOrDefault(_selectedStat!)).ToString("0.##")
                                    </span>
                                </MudTd>
                            }
                        }
                        <MudTd Style="text-align: right;">
                            <button type="button" class="cell-filter-btn" title="Filter: total ≥ this"
                                    @onclick="() => FilterByTotal(context)"
                                    @onclick:stopPropagation="true">
                                <strong>@ScaledFep(context.TotalFep).ToString("0.##")</strong>
                            </button>
                        </MudTd>
                        <MudTd Style="text-align: right;">
                            @if (context.EffectiveHunger > 0)
                            {
                                <button type="button" class="cell-filter-btn" title="Filter: FEP/hunger ≥ this"
                                        @onclick="() => FilterByEff(context)"
                                        @onclick:stopPropagation="true">
                                    @ScaledFep(context.FepPerHunger).ToString("0.0#")
                                </button>
                            }
                            else
                            {
                                <text>—</text>
                            }
                        </MudTd>
                    </RowTemplate>
                    <ChildRowContent>
                        @if (_expanded.Contains(context.Food.Id))
                        {
                            <MudTr>
                                <td colspan="@VisibleColumnCount" class="food-detail">
                                    <div class="food-detail-inner">
                                        <div class="detail-block">
                                            @{
                                                var recipeBase = BaseRecipeSource(context);
                                                var recipeText = !string.IsNullOrEmpty(context.Food.RecipeText)
                                                    ? context.Food.RecipeText
                                                    : recipeBase?.Recipe;
                                                var stationText = !string.IsNullOrEmpty(context.Food.CookingStation)
                                                    ? context.Food.CookingStation
                                                    : recipeBase?.Station;
                                            }
                                            @if (!string.IsNullOrEmpty(recipeText))
                                            {
                                                var recipeSeed = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { context.Food.Name };
                                                if (recipeBase != null)
                                                {
                                                    recipeSeed.Add(recipeBase.BaseName);
                                                }
                                                <div class="detail-title">
                                                    Recipe
                                                    @if (string.IsNullOrEmpty(context.Food.RecipeText) && recipeBase != null)
                                                    {
                                                        <span class="recipe-inherit"
                                                              title="@context.Food.Name is a preparation of @recipeBase.BaseName — same recipe.">
                                                            of @recipeBase.BaseName
                                                        </span>
                                                    }
                                                </div>
                                                @RecipeList(BuildRecipeNodes(recipeText, 0, recipeSeed), false)
                                            }
                                            else if (context.Food.Ingredients.Count > 0)
                                            {
                                                <div class="detail-title"
                                                     title="The wiki has no fixed recipe for this food — this is one combination players actually made it with. See Variations for all recorded ones.">
                                                    Recorded combination
                                                </div>
                                                <ul class="ingredient-list">
                                                    @foreach (var ingredient in context.Food.Ingredients)
                                                    {
                                                        <li>
                                                            @ingredient.Name
                                                            @if (ingredient.Percentage != 100)
                                                            {
                                                                <span class="ingredient-pct">@ingredient.Percentage.ToString("0.#")%</span>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <div class="detail-title">Recipe</div>
                                                <span class="detail-muted">No recipe data</span>
                                            }
                                            @if (!string.IsNullOrEmpty(stationText))
                                            {
                                                <div class="recipe-station" title="Cooked with">
                                                    <MudIcon Icon="@Icons.Material.Filled.OutdoorGrill" />
                                                    <span>@stationText</span>
                                                </div>
                                            }
                                        </div>
                                        <div class="detail-block">
                                            <div class="detail-title">FEP breakdown @(_quality != 10 ? $"(at Q{_quality})" : "(base Q10)")</div>
                                            @if (context.TotalFep > 0)
                                            {
                                                <div class="fep-bar">
                                                    @foreach (var fep in context.EffectiveFeps)
                                                    {
                                                        <div class="fep-bar-segment"
                                                             style="width: @RatioWidth(fep.Value, context.TotalFep); background: @StatColor(fep.Attribute, fep.Tier);"
                                                             @attributes="FtAttrs(fep, context.TotalFep)"></div>
                                                    }
                                                </div>
                                                <table class="fep-detail-table">
                                                    @foreach (var fep in context.EffectiveFeps)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <span class="fep-pill"
                                                                      style="background: @StatColor(fep.Attribute, fep.Tier);"
                                                                      @attributes="FtAttrs(fep, context.TotalFep)">
                                                                    @fep.Attribute@(fep.Tier == 2 ? "+2" : "")
                                                                </span>
                                                            </td>
                                                            <td class="fep-full-name">
                                                                @(StatFullNames.GetValueOrDefault(fep.Attribute, fep.Attribute))@(fep.Tier == 2 ? " +2" : "")
                                                            </td>
                                                            <td class="fep-detail-value">@ScaledFep(fep.Value).ToString("0.##")</td>
                                                            <td class="detail-muted">@((fep.Value / context.TotalFep).ToString("0%"))</td>
                                                        </tr>
                                                    }
                                                </table>
                                            }
                                            else
                                            {
                                                <span class="detail-muted">No FEPs</span>
                                            }
                                        </div>
                                        <div class="detail-block">
                                            <div class="detail-title">Details</div>
                                            @if (context.Food.Categories.Count > 0)
                                            {
                                                <div class="detail-row">
                                                    <span class="detail-label">Wiki tags</span>
                                                    <div class="category-chips">
                                                        @foreach (var category in context.Food.Categories)
                                                        {
                                                            <span class="category-chip">@category</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            <div class="detail-row">
                                                <span class="detail-label">Energy per hunger</span>
                                                <span>@(context.EffectiveHunger > 0 ? (context.EffectiveEnergy / context.EffectiveHunger).ToString("0.#") : "—")</span>
                                            </div>
                                            @if (context.Food.WikiUrl != null)
                                            {
                                                <div class="detail-row">
                                                    <MudLink Href="@context.Food.WikiUrl" Target="_blank" Typo="Typo.body2">
                                                        Open wiki page
                                                        <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Style="vertical-align: text-bottom;" />
                                                    </MudLink>
                                                </div>
                                            }
                                            @if (context.Food.ContributedByName != null)
                                            {
