    // ----- Filter-input helpers: key chips start an expression in the filter box -----

    private static readonly (string Key, string Label, string Tooltip)[] FilterKeyHelpers =
    {
        ("total", "Total", "Total FEP at the current quality"),
        ("hunger", "Hunger", "Hunger cost"),
        ("energy", "Energy", "Energy"),
        ("eff", "FEP/H", "FEP per hunger at the current quality")
    };

    /// <summary>Appends "key>=" to the filter input and focuses it — the user just types the number.</summary>
    private async Task AppendKeyToFilterAsync(string keyLower)
    {
        var f = _filterText.TrimEnd();
        FilterText = f.Length == 0 ? keyLower + ">=" : f + " " + keyLower + ">=";
        await FocusFilterEndAsync();
    }

    private async Task FocusFilterEndAsync()
    {
        if (_filterFieldRef != null)
        {
            // The pending render flushes at this first await, so focus lands on the updated text.
            await _filterFieldRef.FocusAsync();
            await _filterFieldRef.SelectRangeAsync(_filterText.Length, _filterText.Length);
        }
    }

    // FEP-share quarters: complete a started stat expression, or apply to the selected FEP chip.
    private static readonly int[] QuarterPresets = { 25, 50, 75, 100 };

    /// <summary>A stat key + operator with no value yet at the end of the filter text ("str>=", "int2>").</summary>
    private static readonly Regex TrailingStatOpRegex = new(
        @"(?:str|agi|int|con|per|cha|dex|will|psy)(?:[12])?\s*(?:>=|<=|==|=|>|<)\s*$",
        RegexOptions.IgnoreCase | RegexOptions.Compiled | RegexOptions.CultureInvariant);

    private bool QuarterUsable => _selectedStat != null || TrailingStatOpRegex.IsMatch(_filterText);

    private string QuarterTitle(int pct) =>
        TrailingStatOpRegex.IsMatch(_filterText)
            ? $"Complete the started expression with {pct}%"
            : _selectedStat != null
                ? $"{_selectedStat} at least {pct}% of the food's total FEP"
                : "Click a stat key above first, or select a FEP chip";

    private async Task ApplyQuarterAsync(int pct)
    {
        if (TrailingStatOpRegex.IsMatch(_filterText))
        {
            FilterText = _filterText.TrimEnd() + pct + "%";
            await FocusFilterEndAsync();
            return;
        }
        if (_selectedStat != null)
        {
            // Toggle semantics: same quarter again removes it, a different one replaces it.
            ApplyToolExpression(_selectedStat.ToLowerInvariant() + ">=" + pct + "%", toggle: true);
        }
    }

    // ----- One-click tools: pills and cells compose expressions into the filter input -----

    private void FilterByPill(FoodFepDto fep) =>
        ApplyToolExpression(fep.Attribute.ToLowerInvariant() + fep.Tier + ">="
            + Math.Round(ScaledFep(fep.Value), 2).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
            toggle: false);

    private void FilterByTotal(FoodRow r) => FilterByTotalValue(r.TotalFep);

    private void FilterByTotalValue(decimal total) =>
        ApplyToolExpression("total>="
            + Math.Round(ScaledFep(total), 2).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
            toggle: false);

    private void FilterByEff(FoodRow r) => FilterByEffValue(r.FepPerHunger);

    private void FilterByEffValue(decimal perHunger) =>
        ApplyToolExpression("eff>="
            + Math.Round(ScaledFep(perHunger), 2).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
            toggle: false);

    private static bool SameShape(FepFilterCondition a, FepFilterCondition b) =>
        a.Key == b.Key && a.Tier == b.Tier && a.IsPercent == b.IsPercent
        && string.Equals(a.Attribute, b.Attribute, StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Shared funnel for the one-click tools: replaces same-shaped conditions (same key, tier and
    /// %-ness) wherever they live and appends the new expression(s) to the filter input. With
    /// <paramref name="toggle"/>, an identical existing set is removed instead (preset chips).
    /// Multi-condition expressions ("eff>=5 total>=8") are applied as one unit.
    /// </summary>
    private void ApplyToolExpression(string expr, bool toggle)
    {
        var (parsed, _) = FepFilterParser.Parse(expr);
        if (parsed.Count == 0)
        {
            return;
        }

        var sameShape = _allConditions.Where(c => parsed.Any(p => SameShape(c, p))).ToList();
        var identicalExists = parsed.All(p =>
            _allConditions.Any(c => SameShape(c, p) && c.Op == p.Op && c.Value == p.Value));

        var s = _search;
        var f = _filterText;
        foreach (var c in sameShape.OrderByDescending(c => c.Start))
        {
            if (_filterConditions.Contains(c))
            {
                f = CutCondition(f, c);
            }
            else
            {
                s = CutCondition(s, c);
            }
        }
        s = TidySearchText(s);
        f = TidySearchText(f);
        if (!(toggle && identicalExists))
        {
            f = f.Length == 0 ? expr : f + " " + expr;
        }
        Search = s;
        FilterText = f;
    }

    // ----- Chip-click sorting: a chip sorts by exactly what it filters -----

    private static string SortKeyOf(FepFilterCondition c) => c.Key switch
    {
        FepFilterKey.Stat => c.Attribute + (c.Tier?.ToString() ?? string.Empty) + (c.IsPercent ? "%" : string.Empty),
        FepFilterKey.Total => "total",
        FepFilterKey.Hunger => "hunger",
        FepFilterKey.Energy => "energy",
        _ => "eff"
    };

    private void ToggleConditionSort(FepFilterCondition c)
    {
        var key = SortKeyOf(c);
        if (_conditionSortKey != key)
        {
            _conditionSortKey = key;
            _conditionSortDesc = true;
        }
        else if (_conditionSortDesc)
        {
            _conditionSortDesc = false;
        }
        else
        {
            _conditionSortKey = null;
        }
    }

