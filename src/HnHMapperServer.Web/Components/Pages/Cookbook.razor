    // ----- FEP threshold filters (search-box expressions like "str>50%", "int2>15") -----

    private static FepConditionTarget TargetOf(FoodRow r) =>
        new(r.TotalFep, r.FepPerHunger, r.EffectiveHunger, r.EffectiveEnergy, r.StatTotals, r.StatTierTotals);

    private static FepConditionTarget TargetOf(VariantRow v) =>
        new(v.Total, v.PerHunger, v.EffectiveHunger, v.EffectiveEnergy, v.StatTotals, v.StatTierTotals);

    /// <summary>AND-evaluates all active conditions against one row (shared Core semantics).</summary>
    private bool MatchesConditions(FepConditionTarget t) =>
        FepConditionEvaluator.Matches(t, _allConditions, QualityMultiplier);

    /// <summary>What one condition measures on a row — also the value chip-click sorting uses.</summary>
    private decimal ConditionValue(FepConditionTarget t, FepFilterCondition c) =>
        FepConditionEvaluator.Value(t, c, QualityMultiplier);

    private static string ConditionLabel(FepFilterCondition c)
    {
        var key = c.Key switch
        {
            FepFilterKey.Stat => c.Attribute + (c.Tier is int tier ? $"+{tier}" : string.Empty),
            FepFilterKey.Total => "Total",
            FepFilterKey.Hunger => "Hunger",
            FepFilterKey.Energy => "Energy",
            _ => "FEP/H"
        };
        var op = c.Op switch
        {
            FepFilterOp.Gt => ">",
            FepFilterOp.Ge => "≥",
            FepFilterOp.Lt => "<",
            FepFilterOp.Le => "≤",
            _ => "="
        };
        var value = c.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        return $"{key} {op} {value}{(c.IsPercent ? "%" : string.Empty)}";
    }

    private void RemoveCondition(FepFilterCondition c)
    {
        if (_filterConditions.Contains(c))
        {
            FilterText = TidySearchText(CutCondition(_filterText, c));
        }
        else
        {
            Search = TidySearchText(CutCondition(_search, c));
        }
    }

    /// <summary>
    /// Removes a condition's span from its source string. Spans come from the parse of the
    /// current text (the property setters keep them in sync); guard anyway in case a debounced
    /// edit raced the click, falling back to first-occurrence removal.
    /// </summary>
    private static string CutCondition(string text, FepFilterCondition c) =>
        c.Start + c.Length <= text.Length
        && string.CompareOrdinal(text, c.Start, c.RawText, 0, c.Length) == 0
            ? text.Remove(c.Start, c.Length)
            : text.Replace(c.RawText, string.Empty);

    /// <summary>Collapses the separators condition extraction leaves behind ("salami , x" → "salami, x").</summary>
    private static string TidySearchText(string text)
    {
        text = Regex.Replace(text, @"\s+,", ",");
        text = Regex.Replace(text, @",{2,}", ",");
        text = Regex.Replace(text, @"\s{2,}", " ");
        return text.Trim(' ', ',');
    }

    /// <summary>Drops every threshold condition but keeps the free-text part of the search.</summary>
    private void ClearConditions()
    {
        _conditionSortKey = null;
        Search = _residualSearch;
        FilterText = string.Empty;
    }

    /// <summary>Chips shown in the Filters row: facet selections, ingredient tags + threshold conditions.</summary>
    private int ActiveFilterChipCount =>
        _allConditions.Count
        + (_selectedStat != null ? 1 : 0)
        + (_selectedSatiation != null ? 1 : 0)
        + (_selectedPrep != null ? 1 : 0)
        + (_selectedWorld != null ? 1 : 0)
        + (_showNewOnly ? 1 : 0)
