                                                                    <div class="fep-dist">
                                                                        @foreach (var fep in variantRow.EffectiveFeps)
                                                                        {
                                                                            <span class="fep-dist-item" @attributes="FtAttrs(fep, variantRow.Total)">
                                                                                <span class="fep-dist-dot" style="background: @StatColor(fep.Attribute, fep.Tier);"></span>@fep.Attribute@(fep.Tier == 2 ? "+2" : "") @((fep.Value / variantRow.Total).ToString("0%"))
                                                                            </span>
                                                                        }
                                                                    </div>
                                                                }
                                                            </MudTd>
                                                            <MudTd Style="text-align: right;">
                                                                <strong>@ScaledFep(variantRow.Total).ToString("0.#")</strong>
