@using HnHMapperServer.Core.DTOs
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<GlobalMapsViewer> Logger

<MudPaper Class="pa-4">
    <MudStack Spacing="3">
        <div class="d-flex justify-space-between align-center">
            <MudText Typo="Typo.h5">
                <MudIcon Icon="@Icons.Material.Filled.Map" Class="me-2" />
                All Maps Across Tenants
            </MudText>
            <MudButton Variant="Variant.Filled"
                      Color="Color.Primary"
                      StartIcon="@Icons.Material.Filled.Refresh"
                      OnClick="Reload"
                      Disabled="@_isLoading">
                Refresh
            </MudButton>
        </div>

        <MudTable @ref="_table" T="GlobalMapDto" ServerData="LoadServerData" Hover="true" Dense="true"
                  RowsPerPage="25" Loading="@_isLoading" LoadingProgressColor="Color.Primary">
            <ToolBarContent>
                <MudTextField T="string" Value="_searchString" ValueChanged="OnSearchChanged"
                             Placeholder="Search by map name or tenant..."
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             IconSize="Size.Medium"
                             Class="mt-0"
                             Immediate="true"
                             DebounceInterval="300" />
                <MudSpacer />
                <MudText Typo="Typo.body2">@_totalCount maps</MudText>
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel T="GlobalMapDto" SortLabel="id">Map ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="GlobalMapDto" SortLabel="name">Map Name</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="GlobalMapDto" SortLabel="tenant">Tenant</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="GlobalMapDto" SortLabel="status">Status</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="GlobalMapDto" SortLabel="tiles">Tiles</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="GlobalMapDto" SortLabel="custom">Custom markers</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="GlobalMapDto" SortLabel="priority">Priority</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="GlobalMapDto" SortLabel="created" InitialDirection="SortDirection.Descending">Created</MudTableSortLabel></MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Map ID">
                    <code>@context.Id</code>
                </MudTd>
                <MudTd DataLabel="Map Name">
                    <MudText Typo="Typo.body2">@context.Name</MudText>
                </MudTd>
                <MudTd DataLabel="Tenant">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body2">@context.TenantName</MudText>
                        <code class="text-muted" style="font-size: 0.75rem;">@context.TenantId</code>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@(context.Hidden ? Color.Warning : Color.Success)">
                        @(context.Hidden ? "Hidden" : "Visible")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Tiles">
                    <MudText Typo="Typo.body2">@context.TileCount.ToString("N0")</MudText>
                </MudTd>
                <MudTd DataLabel="Custom markers">
                    <MudText Typo="Typo.body2">@context.CustomMarkerCount.ToString("N0")</MudText>
                </MudTd>
                <MudTd DataLabel="Priority">
                    <MudText Typo="Typo.body2">@context.Priority</MudText>
                </MudTd>
                <MudTd DataLabel="Created">
                    <MudText Typo="Typo.body2">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm")</MudText>
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudStack Row="true" Spacing="1">
                        <MudTooltip Text="View tenant maps">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                          Color="Color.Primary"
                                          Size="Size.Small"
                                          Href="@($"/superadmin/map/{context.TenantId}")" />
                        </MudTooltip>
                        <MudTooltip Text="Rebuild WebP tiles (repairs stale/ghost zoom imagery)">
                            <MudIconButton Icon="@Icons.Material.Filled.AutoFixHigh"
                                          Color="Color.Warning"
                                          Size="Size.Small"
                                          Disabled="@(_rebuildingMapId == context.Id)"
                                          OnClick="@(() => RebuildWebpTiles(context))" />
                        </MudTooltip>
                        <MudTooltip Text="Delete map">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                          Color="Color.Error"
                                          Size="Size.Small"
                                          OnClick="@(() => DeleteMap(context))" />
                        </MudTooltip>
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2">No maps found.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
            </PagerContent>
        </MudTable>
    </MudStack>
</MudPaper>

@code {
    private MudTable<GlobalMapDto>? _table;
    private bool _isLoading;
    private string _searchString = "";
    private int _totalCount;

    private Task Reload() => _table?.ReloadServerData() ?? Task.CompletedTask;

    private async Task OnSearchChanged(string value)
    {
        _searchString = value ?? "";
        await Reload();
    }

    private async Task<TableData<GlobalMapDto>> LoadServerData(TableState state, CancellationToken token)
    {
        _isLoading = true;
        try
        {
            var httpClient = HttpClientFactory.CreateClient("API");
            var url = $"/api/superadmin/maps?page={state.Page + 1}&pageSize={state.PageSize}";
            if (!string.IsNullOrWhiteSpace(_searchString))
                url += $"&search={Uri.EscapeDataString(_searchString)}";
            if (!string.IsNullOrEmpty(state.SortLabel) && state.SortDirection != SortDirection.None)
                url += $"&sortBy={state.SortLabel}&sortDesc={(state.SortDirection == SortDirection.Descending ? "true" : "false")}";

            var response = await httpClient.GetAsync(url, token);
            if (response.IsSuccessStatusCode)
            {
                var data = await response.Content.ReadFromJsonAsync<MapResponse>(token);
                _totalCount = data?.TotalCount ?? 0;
                return new TableData<GlobalMapDto> { Items = data?.Maps ?? new(), TotalItems = _totalCount };
            }

            var errorBody = await response.Content.ReadAsStringAsync(token);
            Logger.LogWarning("Failed to load maps: {StatusCode}, Body={Body}", response.StatusCode, errorBody);
            Snackbar.Add("Failed to load maps. Please try again.", Severity.Error);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer sort/page/search request
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading maps");
            Snackbar.Add("Failed to load maps. Please try again.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
        return new TableData<GlobalMapDto> { Items = Array.Empty<GlobalMapDto>(), TotalItems = _totalCount };
    }

    public class MapResponse
    {
        public int Page { get; set; }
        public int PageSize { get; set; }
        public int TotalCount { get; set; }
        public int TotalPages { get; set; }
        public List<GlobalMapDto> Maps { get; set; } = new();
    }

    private int? _rebuildingMapId;

    private async Task RebuildWebpTiles(GlobalMapDto map)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Rebuild WebP tiles",
            $"Rebuild the viewer tile pyramid of map '{map.Name}' (ID: {map.Id}, tenant '{map.TenantName}')? " +
            "All its WebP zoom tiles are deleted and regenerated from the current map data. " +
            "This repairs stale or ghost imagery; areas whose underlying data no longer exists will " +
            "show as unexplored at every zoom level until players re-map them. " +
            "The map stays viewable during the rebuild.",
            yesText: "Rebuild",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        _rebuildingMapId = map.Id;
        try
        {
            // APIUpload client: deleting + reseeding a big pyramid can exceed the default API
            // client's 10s resilience timeout, which would cancel and retry the operation.
            var httpClient = HttpClientFactory.CreateClient("APIUpload");
            var response = await httpClient.PostAsJsonAsync(
                $"/api/superadmin/tenants/{map.TenantId}/maps/{map.Id}/rebuild-webp-tiles",
                new { confirmMapId = map.Id });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<RebuildWebpTilesResultDto>();
                Snackbar.Add(
                    $"WebP rebuild started for '{map.Name}': {result?.FilesDeleted ?? 0} old tiles removed " +
                    $"({result?.MegabytesFreed ?? 0:F1} MB), {result?.CellsMarked ?? 0} cells queued for regeneration.",
                    Severity.Success);
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                Logger.LogWarning("Failed to rebuild WebP tiles for map {MapId}: {StatusCode}, Body={Body}",
                    map.Id, response.StatusCode, errorBody);
                Snackbar.Add("Failed to rebuild WebP tiles. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error rebuilding WebP tiles for map {MapId}", map.Id);
            Snackbar.Add("Failed to rebuild WebP tiles. Please try again.", Severity.Error);
        }
        finally
        {
            _rebuildingMapId = null;
        }
    }

    private async Task DeleteMap(GlobalMapDto map)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirm Deletion",
            $"Are you sure you want to delete map '{map.Name}' (ID: {map.Id}) from tenant '{map.TenantName}'? This will delete all tiles, markers, and custom markers associated with this map. This action cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        try
        {
            var httpClient = HttpClientFactory.CreateClient("API");
            var response = await httpClient.DeleteAsync($"/api/superadmin/tenants/{map.TenantId}/maps/{map.Id}");

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Map '{map.Name}' deleted successfully.", Severity.Success);
                await Reload();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                Logger.LogWarning("Failed to delete map {MapId}: {StatusCode}, Body={Body}", map.Id, response.StatusCode, errorBody);
                Snackbar.Add($"Failed to delete map. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting map {MapId}", map.Id);
            Snackbar.Add("Failed to delete map. Please try again.", Severity.Error);
        }
    }
}
