@using HnHMapperServer.Core.DTOs
@using HnHMapperServer.Web.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject ILogger<AccountsOverview> Logger

<MudPaper Class="pa-4">
<MudStack Spacing="3">
    <div>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.People" Class="me-2" />
            Accounts
        </MudText>
        <MudText Typo="Typo.body2" Class="ck-text-secondary">
            Every account on this server, how it was created, how it can sign in, and which maps it joined and how.
        </MudText>
    </div>

    @if (_summary != null)
    {
        <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
            <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">@_summary.Total accounts</MudChip>
            @foreach (var kv in _summary.BySignInMethod.OrderByDescending(k => k.Value))
            {
                <MudChip T="string" Variant="Variant.Outlined" Icon="@MethodIcon(kv.Key)" OnClick="@(() => ApplyQuickFilter(method: kv.Key))">
                    @kv.Key @kv.Value
                </MudChip>
            }
            @foreach (var kv in _summary.ByRegistrationSource.OrderByDescending(k => k.Value))
            {
                <MudChip T="string" Variant="Variant.Text" OnClick="@(() => ApplyQuickFilter(source: kv.Key))">
                    registered via @kv.Key: @kv.Value
                </MudChip>
            }
            <MudChip T="string" Color="@(_summary.WithoutTenant > 0 ? Color.Warning : Color.Default)" Variant="Variant.Outlined"
                     OnClick="@(() => ApplyQuickFilter(noTenant: true))">
                @_summary.WithoutTenant without a map
            </MudChip>
        </MudStack>
    }

    @* Modal="false": the select popovers are modal by default and would eat the first click on a neighbour *@
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Style="flex-wrap: wrap;">
        <MudTextField T="string" Value="@_search" ValueChanged="@OnSearchChanged" Label="Search username / Discord name"
                      Immediate="true" DebounceInterval="400" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="min-width: 260px;" />
        <MudSelect T="string" Value="@_method" ValueChanged="@OnMethodChanged" Label="Sign-in method" Dense="true"
                   Margin="Margin.Dense" Variant="Variant.Outlined" Modal="false" Clearable="true" Style="min-width: 170px;">
            <MudSelectItem T="string" Value="@("Password")">Password</MudSelectItem>
            <MudSelectItem T="string" Value="@("Steam")">Steam</MudSelectItem>
            <MudSelectItem T="string" Value="@("Discord")">Discord</MudSelectItem>
        </MudSelect>
        <MudSelect T="string" Value="@_source" ValueChanged="@OnSourceChanged" Label="Registered via" Dense="true"
                   Margin="Margin.Dense" Variant="Variant.Outlined" Modal="false" Clearable="true" Style="min-width: 170px;">
            <MudSelectItem T="string" Value="@("Password")">Password form</MudSelectItem>
            <MudSelectItem T="string" Value="@("Steam")">Steam</MudSelectItem>
            <MudSelectItem T="string" Value="@("Discord")">Discord</MudSelectItem>
        </MudSelect>
        <MudCheckBox T="bool" Value="@_noTenant" ValueChanged="@OnNoTenantChanged" Label="Without a map" Dense="true" />
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" OnClick="@(() => _table!.ReloadServerData())">Refresh</MudButton>
    </MudStack>

    <MudTable @ref="_table" T="AccountOverviewDto" ServerData="LoadServerData" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm"
              RowsPerPage="25">
        <HeaderContent>
            <MudTh>Username</MudTh>
            <MudTh>Sign-in</MudTh>
            <MudTh>Registered</MudTh>
            <MudTh>Last login</MudTh>
            <MudTh>Maps</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Username">
                <div class="d-flex align-center" style="gap: 6px; flex-wrap: wrap;">
                    <MudText Typo="Typo.body2"><strong>@context.Username</strong></MudText>
                    @if (context.IsSuperAdmin)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error">SuperAdmin</MudChip>
                    }
                </div>
                @if (!string.IsNullOrEmpty(context.DiscordName))
                {
                    <MudText Typo="Typo.caption" Class="ck-text-secondary">Discord: @context.DiscordName</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Sign-in">
                <SignInMethodIcons Methods="@context.SignInMethods" ExternalIds="@context.ExternalIds" />
            </MudTd>
            <MudTd DataLabel="Registered">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@MethodIcon(context.RegistrationSource)">@context.RegistrationSource</MudChip>
                <MudText Typo="Typo.caption" Class="ck-text-secondary d-block">@(context.CreatedAt?.ToString("yyyy-MM-dd") ?? "—")</MudText>
            </MudTd>
            <MudTd DataLabel="Last login">@(context.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</MudTd>
            <MudTd DataLabel="Maps">
                @if (context.Memberships.Count == 0)
                {
                    <MudText Typo="Typo.caption" Class="ck-text-secondary">none</MudText>
                }
                else
                {
                    <div class="d-flex" style="gap: 4px; flex-wrap: wrap;">
                        @foreach (var m in context.Memberships)
                        {
                            <MudTooltip Text="@MembershipTooltip(m)">
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(m.Pending ? Color.Warning : m.TenantActive ? (m.Role == "TenantAdmin" ? Color.Primary : Color.Default) : Color.Dark)"
                                         Variant="@(m.TenantActive ? Variant.Filled : Variant.Outlined)">
                                    @m.TenantName · @RoleLabel(m.Role)
                                </MudChip>
                            </MudTooltip>
                        }
                    </div>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4">No accounts match these filters.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
        </PagerContent>
    </MudTable>
</MudStack>
</MudPaper>

@code {
    private MudTable<AccountOverviewDto>? _table;
    private AccountOverviewSummaryDto? _summary;
    private string _search = string.Empty;
    private string? _method;
    private string? _source;
    private bool _noTenant;

    private async Task<TableData<AccountOverviewDto>> LoadServerData(TableState state, CancellationToken token)
    {
        try
        {
            var query = new List<string>
            {
                $"page={state.Page + 1}",
                $"pageSize={Math.Clamp(state.PageSize, 1, 100)}"
            };
            if (!string.IsNullOrWhiteSpace(_search)) query.Add($"search={Uri.EscapeDataString(_search.Trim())}");
            if (!string.IsNullOrWhiteSpace(_method)) query.Add($"method={Uri.EscapeDataString(_method)}");
            if (!string.IsNullOrWhiteSpace(_source)) query.Add($"source={Uri.EscapeDataString(_source)}");
            if (_noTenant) query.Add("noTenant=true");

            var client = HttpClientFactory.CreateClient("API");
            var page = await client.GetFromJsonAsync<AccountOverviewPageDto>($"/api/superadmin/accounts?{string.Join('&', query)}", token);
            if (page == null)
                return new TableData<AccountOverviewDto> { Items = Array.Empty<AccountOverviewDto>(), TotalItems = 0 };

            _summary = page.Summary;
            return new TableData<AccountOverviewDto> { Items = page.Items, TotalItems = page.Total };
        }
        catch (OperationCanceledException)
        {
            return new TableData<AccountOverviewDto> { Items = Array.Empty<AccountOverviewDto>(), TotalItems = 0 };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load accounts overview");
            Snackbar.Add("Failed to load accounts.", Severity.Error);
            return new TableData<AccountOverviewDto> { Items = Array.Empty<AccountOverviewDto>(), TotalItems = 0 };
        }
    }

    private Task OnSearchChanged(string value) { _search = value; return Reload(); }
    private Task OnMethodChanged(string? value) { _method = value; return Reload(); }
    private Task OnSourceChanged(string? value) { _source = value; return Reload(); }
    private Task OnNoTenantChanged(bool value) { _noTenant = value; return Reload(); }

    private Task ApplyQuickFilter(string? method = null, string? source = null, bool noTenant = false)
    {
        _method = method;
        _source = source;
        _noTenant = noTenant;
        return Reload();
    }

    private Task Reload() => _table?.ReloadServerData() ?? Task.CompletedTask;

    private static string MethodIcon(string method) => method switch
    {
        "Password" => Icons.Material.Filled.Key,
        "Steam" => Icons.Custom.Brands.Steam,
        "Discord" => Icons.Custom.Brands.Discord,
        _ => Icons.Material.Filled.Login
    };

    private static string RoleLabel(string role) => role switch
    {
        "TenantAdmin" => "admin",
        "TenantUser" => "member",
        _ => role
    };

    private static string MembershipTooltip(AccountMembershipDto m)
    {
        var via = m.JoinSource switch
        {
            "InviteLink" => m.InvitationId.HasValue ? $"joined via invite link #{m.InvitationId}" : "joined via invite link",
            "SelfCreated" => "created this map",
            "AdminAssigned" => "added by a superadmin",
            "Approved" => "approved by a map admin",
            "Bootstrap" => "bootstrap admin",
            _ => "joined before tracking"
        };
        var when = m.Pending ? "pending approval" : $"on {m.JoinedAt:yyyy-MM-dd}";
        var state = m.TenantActive ? string.Empty : " · map suspended";
        return $"{m.TenantName}: {via} {when}{state}";
    }
}
