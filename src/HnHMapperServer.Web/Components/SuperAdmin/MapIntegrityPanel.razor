@using HnHMapperServer.Core.DTOs
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<MapIntegrityPanel> Logger

<MudPaper Class="pa-4">
    <MudStack Spacing="3">
        <div class="d-flex justify-space-between align-center">
            <MudText Typo="Typo.h5">
                <MudIcon Icon="@Icons.Material.Filled.Rule" Class="me-2" />
                Map Integrity
            </MudText>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled"
                          Color="Color.Primary"
                          StartIcon="@Icons.Material.Filled.Search"
                          OnClick="RunScan"
                          Disabled="@_isScanning">
                    Rescan
                </MudButton>
            </MudStack>
        </div>

        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            The map repair console. Finds cells claimed by more than one grid id (the fingerprint of
            coordinate-frame corruption), plus orphaned storage left behind by merges and map
            deletions — dead tile rows, dead per-map tile directories, and pool PNGs nothing
            references. Repairs: wipe a contested region, rebuild a map's WebP tile pyramid
            (fixes stale/ghost zoom imagery), and purge a tenant's orphans. A background check
            reruns this scan daily and logs a warning when anything shows up.
        </MudText>

        @if (_isScanning)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_report == null)
        {
            <MudAlert Severity="Severity.Warning">
                Scan failed. Check the API logs and try again.
            </MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Scanned @_report.TenantsScanned tenants / @_report.TotalGrids.ToString("N0") grids
                at @_report.ScannedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC.
            </MudText>

            @if (_report.IsClean)
            {
                <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.CheckCircle">
                    No integrity issues found — no contested cells and no placeholder grid rows.
                </MudAlert>
            }

            @if (_report.ContestedMaps.Any())
            {
                <MudAlert Severity="Severity.Error">
                    @_report.ContestedMaps.Count map(s) have cells claimed by more than one grid id.
                    Players mapping these areas overwrite each other's tiles until the region is wiped.
                </MudAlert>

                <MudTable T="MapIntegrityIssueDto" Items="@_report.ContestedMaps" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Tenant</MudTh>
                        <MudTh>Map</MudTh>
                        <MudTh>Contested cells</MudTh>
                        <MudTh>Region</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Tenant">
                            <MudText Typo="Typo.body2">@context.TenantName</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.TenantId</MudText>
                        </MudTd>
                        <MudTd DataLabel="Map">
                            <MudText Typo="Typo.body2">@context.MapName</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">map @context.MapId</MudText>
                        </MudTd>
                        <MudTd DataLabel="Contested cells">
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">@context.ContestedCellCount</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Region">
                            <code>(@context.MinX,@context.MinY) … (@context.MaxX,@context.MaxY)</code>
                        </MudTd>
                        <MudTd DataLabel="Actions">
                            <MudStack Row="true" Spacing="1">
                                <MudTooltip Text="Show the contested cells and which grid ids fight over them">
                                    <MudIconButton Icon="@(_expandedIssue == context ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                  Size="Size.Small"
                                                  OnClick="@(() => ToggleDetails(context))" />
                                </MudTooltip>
                                <MudTooltip Text="Preview and wipe the contested region so it can be re-mapped cleanly">
                                    <MudIconButton Icon="@Icons.Material.Filled.Healing"
                                                  Color="Color.Error"
                                                  Size="Size.Small"
                                                  OnClick="@(() => OpenWipeDialog(context))" />
                                </MudTooltip>
                                <MudTooltip Text="Rebuild this map's WebP tile pyramid (repairs stale/ghost zoom imagery)">
                                    <MudIconButton Icon="@Icons.Material.Filled.AutoFixHigh"
                                                  Color="Color.Warning"
                                                  Size="Size.Small"
                                                  Disabled="@(_busyAction != null)"
                                                  OnClick="@(() => RebuildWebpTiles(context.TenantId, context.TenantName, context.MapId, context.MapName))" />
                                </MudTooltip>
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                    <ChildRowContent>
                        @if (_expandedIssue == context)
                        {
                            <MudTr>
                                <td colspan="5">
                                    <MudPaper Elevation="0" Class="pa-3 mud-background-gray">
                                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                                            Contested cells (showing @context.SampleCells.Count of @context.ContestedCellCount)
                                        </MudText>
                                        <MudSimpleTable Dense="true" Hover="false" Elevation="0" Style="background: transparent">
                                            <thead>
                                                <tr>
                                                    <th>Cell</th>
                                                    <th>Grid ids claiming it</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var cell in context.SampleCells)
                                                {
                                                    <tr>
                                                        <td><code>(@cell.X, @cell.Y)</code></td>
                                                        <td><code>@string.Join(", ", cell.GridIds)</code></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </MudSimpleTable>
                                    </MudPaper>
                                </td>
                            </MudTr>
                        }
                    </ChildRowContent>
                </MudTable>
            }

            @if (_report.OrphanStorage.Any())
            {
                <MudAlert Severity="Severity.Warning">
                    @_report.OrphanStorage.Count tenant(s) carry orphaned map storage — leftovers of
                    merges and map deletions. Invisible to viewers, but counted against the tenant's
                    storage quota. Purging deletes only provably-dead data.
                </MudAlert>

                <MudTable T="TenantOrphanStorageDto" Items="@_report.OrphanStorage" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Tenant</MudTh>
                        <MudTh>Dead maps</MudTh>
                        <MudTh>Orphaned rows</MudTh>
                        <MudTh>Dead directories</MudTh>
                        <MudTh>Unreferenced pool PNGs</MudTh>
                        <MudTh>Reclaimable</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Tenant">
                            <MudText Typo="Typo.body2">@context.TenantName</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.TenantId</MudText>
                        </MudTd>
                        <MudTd DataLabel="Dead maps">
                            <MudTooltip Text="@string.Join(", ", context.DeadMapIds)">
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">@context.DeadMapIds.Count</MudChip>
                            </MudTooltip>
                        </MudTd>
                        <MudTd DataLabel="Orphaned rows">@context.OrphanedTileRows.ToString("N0")</MudTd>
                        <MudTd DataLabel="Dead directories">
                            @context.DeadMapDirectories (@((context.DeadMapDirectoryBytes / 1024.0 / 1024.0).ToString("F1")) MB)
                        </MudTd>
                        <MudTd DataLabel="Unreferenced pool PNGs">
                            @context.UnreferencedGridFiles.ToString("N0") (@((context.UnreferencedGridFileBytes / 1024.0 / 1024.0).ToString("F1")) MB)
                        </MudTd>
                        <MudTd DataLabel="Reclaimable">
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">@context.ReclaimableMB MB</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Actions">
                            <MudTooltip Text="Delete this tenant's orphaned rows, dead directories and unreferenced pool PNGs">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep"
                                              Color="Color.Error"
                                              Size="Size.Small"
                                              Disabled="@(_busyAction != null)"
                                              OnClick="@(() => PurgeOrphans(context))" />
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }

            @if (_report.PlaceholderRows.Any())
            {
                <MudAlert Severity="Severity.Warning">
                    @_report.PlaceholderRows.Count legacy placeholder ("0") grid row(s) found. The
                    RemovePlaceholderGridRows migration deletes these at startup — seeing them here
                    means the API has not restarted on this database since the fix was deployed.
                </MudAlert>

                <MudTable T="PlaceholderGridRowDto" Items="@_report.PlaceholderRows" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Tenant</MudTh>
                        <MudTh>Map</MudTh>
                        <MudTh>Cell</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Tenant">@context.TenantName</MudTd>
                        <MudTd DataLabel="Map">map @context.MapId</MudTd>
                        <MudTd DataLabel="Cell"><code>(@context.X, @context.Y)</code></MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
    </MudStack>
</MudPaper>

@code {
    private MapIntegrityReportDto? _report;
    private bool _isScanning = true;
    private MapIntegrityIssueDto? _expandedIssue;

    protected override async Task OnInitializedAsync()
    {
        await RunScan();
    }

    private async Task RunScan()
    {
        _isScanning = true;
        _expandedIssue = null;
        try
        {
            var httpClient = HttpClientFactory.CreateClient("API");
            var response = await httpClient.GetAsync("/api/superadmin/integrity/scan");

            if (response.IsSuccessStatusCode)
            {
                _report = await response.Content.ReadFromJsonAsync<MapIntegrityReportDto>();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                Logger.LogWarning("Integrity scan failed: {StatusCode}, Body={Body}", response.StatusCode, errorBody);
                _report = null;
                Snackbar.Add("Integrity scan failed. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error running integrity scan");
            _report = null;
            Snackbar.Add("Integrity scan failed. Please try again.", Severity.Error);
        }
        finally
        {
            _isScanning = false;
        }
    }

    private string? _busyAction;

    private void ToggleDetails(MapIntegrityIssueDto issue)
    {
        _expandedIssue = _expandedIssue == issue ? null : issue;
    }

    private async Task RebuildWebpTiles(string tenantId, string tenantName, int mapId, string mapName)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Rebuild WebP tiles",
            $"Rebuild the viewer tile pyramid of map '{mapName}' (ID: {mapId}, tenant '{tenantName}')? " +
            "All its WebP zoom tiles are deleted and regenerated from the current map data. " +
            "This repairs stale or ghost imagery; areas whose underlying data no longer exists will " +
            "show as unexplored at every zoom level until players re-map them. " +
            "The map stays viewable during the rebuild.",
            yesText: "Rebuild",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        _busyAction = $"rebuild-{mapId}";
        try
        {
            // APIUpload client: deleting + reseeding a big pyramid can exceed the default API
            // client's 10s resilience timeout, which would cancel and retry the operation.
            var httpClient = HttpClientFactory.CreateClient("APIUpload");
            var response = await httpClient.PostAsJsonAsync(
                $"/api/superadmin/tenants/{tenantId}/maps/{mapId}/rebuild-webp-tiles",
                new { confirmMapId = mapId });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<RebuildWebpTilesResultDto>();
                Snackbar.Add(
                    $"WebP rebuild started for '{mapName}': {result?.FilesDeleted ?? 0} old tiles removed " +
                    $"({result?.MegabytesFreed ?? 0:F1} MB), {result?.CellsMarked ?? 0} cells queued for regeneration.",
                    Severity.Success);
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                Logger.LogWarning("Failed to rebuild WebP tiles for map {MapId}: {StatusCode}, Body={Body}",
                    mapId, response.StatusCode, errorBody);
                Snackbar.Add("Failed to rebuild WebP tiles. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error rebuilding WebP tiles for map {MapId}", mapId);
            Snackbar.Add("Failed to rebuild WebP tiles. Please try again.", Severity.Error);
        }
        finally
        {
            _busyAction = null;
        }
    }

    private async Task PurgeOrphans(TenantOrphanStorageDto orphans)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Purge orphaned storage",
            $"Delete orphaned map storage of tenant '{orphans.TenantName}'? This removes " +
            $"{orphans.OrphanedTileRows:N0} tile rows on {orphans.DeadMapIds.Count} dead map(s), " +
            $"{orphans.DeadMapDirectories} dead tile directories and " +
            $"{orphans.UnreferencedGridFiles:N0} unreferenced pool PNGs — about {orphans.ReclaimableMB} MB. " +
            "Only data no existing map, tile row or grid references is touched; live maps are unaffected.",
            yesText: "Purge",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        _busyAction = $"purge-{orphans.TenantId}";
        try
        {
            // APIUpload client: row deletion + directory sweeps can exceed the default 10s timeout.
            var httpClient = HttpClientFactory.CreateClient("APIUpload");
            var response = await httpClient.PostAsJsonAsync(
                $"/api/superadmin/integrity/tenants/{orphans.TenantId}/purge-orphans",
                new { confirmTenantId = orphans.TenantId });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<OrphanPurgeResultDto>();
                Snackbar.Add(
                    $"Purged orphans of '{orphans.TenantName}': {result?.TileRowsDeleted ?? 0:N0} rows, " +
                    $"{result?.DirectoriesDeleted ?? 0} directories, {result?.GridFilesDeleted ?? 0:N0} pool PNGs " +
                    $"({result?.MegabytesFreed ?? 0:F1} MB freed; storage now {result?.StorageAfterMB ?? 0:F1} MB).",
                    Severity.Success);
                foreach (var warning in (result?.Warnings ?? new List<string>()).Take(3))
                {
                    Snackbar.Add(warning, Severity.Warning);
                }
                await RunScan();
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                Logger.LogWarning("Failed to purge orphans for tenant {TenantId}: {StatusCode}, Body={Body}",
                    orphans.TenantId, response.StatusCode, errorBody);
                Snackbar.Add("Failed to purge orphaned storage. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error purging orphans for tenant {TenantId}", orphans.TenantId);
            Snackbar.Add("Failed to purge orphaned storage. Please try again.", Severity.Error);
        }
        finally
        {
            _busyAction = null;
        }
    }

    private async Task OpenWipeDialog(MapIntegrityIssueDto issue)
    {
        var parameters = new DialogParameters<WipeMapRegionDialog>
        {
            { x => x.Issue, issue }
        };

        var dialog = await DialogService.ShowAsync<WipeMapRegionDialog>(
            $"Wipe contested region on '{issue.MapName}' ({issue.TenantName})",
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseButton = true,
                BackdropClick = false
            });

        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            // The region is gone; rescan so the issue disappears from the list.
            await RunScan();
        }
    }
}
