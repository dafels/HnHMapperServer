@using Microsoft.JSInterop
@using HnHMapperServer.Web.Models
@using HnHMapperServer.Web.Services
@using HnHMapperServer.Services.Interfaces
@using HnHMapperServer.Core.DTOs
@using Microsoft.Extensions.Logging
@using System.Diagnostics
@inject IJSRuntime JS
@inject SafeJsInterop SafeJs
@inject ReconnectionState Connection
@inject ILogger<MapView> Logger
@inject IBuildInfoProvider BuildInfo
@implements IAsyncDisposable

<div @ref="mapElement" class="leaflet-map"></div>

@code {
    [Parameter] public MapState State { get; set; } = new();
    [Parameter] public EventCallback<(int x, int y, int z)> OnMapDragged { get; set; }
    [Parameter] public EventCallback<(int x, int y, int z)> OnMapZoomed { get; set; }
    [Parameter] public EventCallback<(int gridX, int gridY, int screenX, int screenY)> OnContextMenu { get; set; }
    [Parameter] public EventCallback<int> OnMarkerClicked { get; set; }
    [Parameter] public EventCallback<(int markerId, int screenX, int screenY)> OnMarkerContextMenu { get; set; }
    [Parameter] public EventCallback<(int customMarkerId, int screenX, int screenY)> OnCustomMarkerContextMenu { get; set; }
    [Parameter] public EventCallback<(int mapId, int coordX, int coordY, int x, int y, int screenX, int screenY)> OnMapRightClick { get; set; }
    [Parameter] public EventCallback<bool> OnMapInitialized { get; set; }
    [Parameter] public EventCallback<int> OnMapChanged { get; set; }
    [Parameter] public EventCallback<(int mapId, string coords)> OnRequestOverlays { get; set; }
    [Parameter] public EventCallback<(int mapId, List<RoadWaypointDto> waypoints)> OnRoadDrawingComplete { get; set; }
    [Parameter] public EventCallback<(int roadId, int screenX, int screenY)> OnRoadContextMenu { get; set; }

    private ElementReference mapElement;
    private IJSObjectReference? jsModule;
    private DotNetObjectReference<MapView>? dotnetRef;
    private bool initialized = false;
    private bool disposed = false;
    private int pendingMapId = 0; // map switch requested before Leaflet 'load' — applied in OnMapReady

    /// <summary>
    /// Version suffix for cache busting dynamic JS imports
    /// </summary>
    private string JsVersion => $"?v={BuildInfo.Get("web").Commit}";
    
    /// <summary>
    /// Public property to check if the map view has been initialized
    /// </summary>
    public bool IsInitialized => initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // InitializeMapAsync sends the initial changeMap itself, and later switches go through ChangeMapAsync /
        // OnMapReady's queued map - no second changeMap here (it was redundant, and unguarded).
        if (firstRender)
        {
            await InitializeMapAsync();
        }
    }

    /// <summary>
    /// One attempt. initializeMap creates Leaflet synchronously, so it answers in tens of milliseconds whether
    /// or not the tab is visible; anything else is classified below, and a real failure is reported to the
    /// parent through OnMapInitialized(false) so it can offer a reload. Never throws (OnAfterRenderAsync).
    /// </summary>
    private async Task InitializeMapAsync()
    {
        try
        {
            Logger.LogInformation("Starting map initialization...");

            jsModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", $"./js/leaflet-interop.js{JsVersion}");
            dotnetRef = DotNetObjectReference.Create(this);

            Logger.LogDebug("Calling initializeMap in JavaScript...");
            var started = Stopwatch.GetTimestamp();
            await jsModule.InvokeVoidAsync("initializeMap", mapElement, dotnetRef);
            var initializeMapMs = Stopwatch.GetElapsedTime(started).TotalMilliseconds;

            // DisposeAsync may have run while we awaited (SPA navigation away); it nulls jsModule.
            if (disposed)
            {
                Logger.LogDebug("Map initialization finished after the component was disposed");
                return;
            }

            // Set initial map ID if available (prevents requesting tiles for mapId 0)
            if (State.CurrentMapId > 0)
            {
                Logger.LogDebug("Setting initial map ID: {MapId}", State.CurrentMapId);
                await jsModule.InvokeVoidAsync("changeMap", State.CurrentMapId);
            }

            // 'initialized' is set by OnMapReady() when Leaflet's 'load' event fires
            Logger.LogInformation("Map initialization call completed (initializeMap took {InitializeMapMs:F0} ms), waiting for Leaflet 'load' event...",
                initializeMapMs);
        }
        catch (Exception ex) when (disposed || initialized || ex is JSDisconnectedException)
        {
            // Nothing to recover: the component is gone (DisposeAsync sets 'disposed' BEFORE disposing jsModule,
            // so an ObjectDisposedException lands here too - keep that order), the circuit is gone, or
            // OnMapReady already arrived and only the changeMap reply was lost (HandleMapInitialized re-sends it).
            Logger.LogDebug(ex, "Map initialization interrupted (disposed={Disposed}, ready={Ready})", disposed, initialized);
        }
        catch (TaskCanceledException ex)
        {
            // No answer within CircuitOptions.JSInteropDefaultCallTimeout. initializeMap/changeMap are synchronous
            // in JS, so the call or its reply was lost with a dropped connection (Blazor does not replay JS
            // interop after a reconnect).
            Logger.LogWarning(ex, "Browser did not answer map initialization within the JS interop timeout; map unusable until reload");
            await NotifyInitializationFailedAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Map initialization failed; map unusable until reload");
            await NotifyInitializationFailedAsync();
        }
    }

    private async Task NotifyInitializationFailedAsync()
    {
        if (!OnMapInitialized.HasDelegate) return;

        try
        {
            await OnMapInitialized.InvokeAsync(false);
        }
        catch (Exception ex)
        {
            // Called from OnAfterRenderAsync: an escaping exception would end the circuit
            Logger.LogWarning(ex, "OnMapInitialized(false) handler failed");
        }
    }

    public async Task ChangeMapAsync(int mapId)
    {
        State.CurrentMapId = mapId;

        if (!initialized || jsModule == null || disposed)
        {
            // Leaflet isn't ready yet — queue instead of silently dropping, so C# and JS
            // don't desync (C# thinking it switched while JS still shows the old map)
            pendingMapId = mapId;
            return;
        }

        pendingMapId = 0;
        await SafeJs.InvokeVoidSafeAsync(jsModule, "changeMap", mapId);
    }

    public async Task SetOverlayMapAsync(int? mapId, double offsetX = 0, double offsetY = 0)
    {
        if (!initialized || jsModule == null || disposed) return;

        State.OverlayMapId = mapId;
        State.OverlayOffsetX = offsetX;
        State.OverlayOffsetY = offsetY;
        await SafeJs.InvokeVoidSafeAsync(jsModule, "setOverlayMap", mapId, offsetX, offsetY);
    }

