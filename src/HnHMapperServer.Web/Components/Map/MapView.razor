    /// <summary>
    /// Idempotent (Map.DisposeAsync also calls it) and never throws: an exception escaping a component's
    /// DisposeAsync terminates the circuit.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        // Must stay first: InitializeMapAsync classifies a failure during disposal by this flag.
        disposed = true;

        var module = jsModule;
        jsModule = null;
        if (module != null)
        {
            if (Connection.IsConnected)
            {
                try
                {
                    await module.DisposeAsync();
                }
                catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or JSException)
                {
                    Logger.LogDebug("MapView disposal: module dispose skipped ({ExceptionType})", ex.GetType().Name);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "MapView disposal: module dispose failed");
                }
            }
            else
            {
                // During circuit teardown ReconnectionState flips before components are disposed; a JS call now
                // could only fail (JSDisconnectedException), so skip it.
                Logger.LogDebug("MapView disposal: circuit not connected, skipping JS teardown");
            }
        }

        dotnetRef?.Dispose();
        dotnetRef = null;
    }
