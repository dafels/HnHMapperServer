    [JSInvokable]
    public async Task OnMapReady()
    {
        // DisposeAsync keeps dotnetRef alive until its module-dispose round trip ends, so 'load' can still
        // arrive here. Do not start the parent's initialization sequence for a page that is going away.
        if (disposed)
        {
            Logger.LogDebug("Map ready event arrived after the component was disposed");
            return;
        }

        Logger.LogInformation("Map ready event received from JavaScript (Leaflet 'load' event fired)");
        initialized = true;

        // Apply a map switch that was requested before Leaflet finished loading
        if (pendingMapId > 0 && jsModule != null)
        {
            var toApply = pendingMapId;
            pendingMapId = 0;
            Logger.LogInformation("Applying queued map switch to {MapId}", toApply);
            await SafeJs.InvokeVoidSafeAsync(jsModule, "changeMap", toApply);
            if (disposed) return;
        }

        if (OnMapInitialized.HasDelegate)
        {
            await OnMapInitialized.InvokeAsync(true);
        }
    }

    [JSInvokable]
    public async Task JsOnMapChanged(int mapId)
    {
        Logger.LogInformation("Map changed event received from JavaScript for map {MapId}", mapId);

        if (OnMapChanged.HasDelegate)
