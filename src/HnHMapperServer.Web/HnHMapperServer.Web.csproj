<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Workstation GC. The Web SDK defaults ASP.NET Core apps to Server GC, which gives
      every core its own heap and only collects aggressively under pressure. This process
      is latency-bound (Blazor circuits), not throughput-bound, and shares a small VPS with
      the API container. Measured on the cookbook workload (login -> 931 foods -> 49k-row
      ungrouped view -> 3 facet filters), 2 CPUs:
          Server GC       467 MB working set / 358 MB private
          Workstation GC  390 MB working set / 266 MB private   (-26% private)
      Cost: the one-off 49k-row build goes 2.3s -> 2.9s; filter round-trips are unchanged.
      Note this also disables DATAS, which is Server-GC-only.
      The API keeps Server GC - it does parallel image work.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct pin: AspNet.Security.OpenId.Steam depends on AngleSharp >= 1.3.0,
         which carries CVE-2026-54570 (mXSS). 1.5.0+ is patched. -->
    <PackageReference Include="AngleSharp" Version="1.7.1" />
    <PackageReference Include="AspNet.Security.OAuth.Discord" Version="10.0.0" />
    <PackageReference Include="AspNet.Security.OpenId.Steam" Version="10.0.0" />
    <PackageReference Include="MudBlazor" Version="9.8.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HnHMapperServer.ServiceDefaults\HnHMapperServer.ServiceDefaults.csproj" />
    <ProjectReference Include="..\HnHMapperServer.Services\HnHMapperServer.Services.csproj" />
    <ProjectReference Include="..\HnHMapperServer.Infrastructure\HnHMapperServer.Infrastructure.csproj" />
    <ProjectReference Include="..\HnHMapperServer.Core\HnHMapperServer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="map\" />
  </ItemGroup>

</Project>
